---
import '../../public/css/v4.css';
import '../../public/css/agents.css';
import '../../public/css/technical-foundation.css';
import '../../public/css/technical-foundation-next.css';
import '../../public/css/marketing-shell.css';
import '../../public/css/monitoring.css';
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import DashboardExample from '../components/monitoring/DashboardExample.astro';
import 'boxicons/css/boxicons.min.css';
const sections = [
    {id:'audit-trail',view:'audit',label:'01 · Audit trail',first:'Every action',second:'leaves a trail.',
        copy:'Find the messages behind a reservation, a payment, or a change in your product. Inspect what was sent, when it happened, and the data it carried.',
        notes:[['Product language','Look for reservations and payments, not just technical log lines.'],['Original payloads','Inspect the information that passed through your product.'],['Search and filter','Narrow the history by message type, time, and relevant fields.']]},
    {id:'traces',view:'trace',label:'02 · Traces',first:'Follow the action.',second:'See what it set in motion.',
        copy:'A customer action can pass through several parts of your product. Follow its trace to see the messages, the work they triggered, and where time was spent.',
        notes:[['One request','Follow the work triggered by a customer action.'],['Across applications','See the handlers and messages involved in the flow.'],['Timing included','Distinguish processing time from time spent waiting.']]},
    {id:'issues',view:'issues',label:'03 · Issues',first:'Find the failure.',second:'Keep the context.',
        copy:'Repeated errors belong together. See which issues are occurring, how often they happen, and which application and version are affected. Open an occurrence to investigate further.',
        notes:[['Grouped occurrences','Recognize a recurring problem without reading every error separately.'],['Application and version','See where the issue is happening.'],['Track its status','Resolve or mute an issue from the same view.']]},
    {id:'logs',view:'logs',label:'04 · Application logs',first:'Every application.',second:'One place for logs.',
        copy:'Console logs from all your applications come together automatically. Search the output, select an application, or filter by severity. There is no separate logging service to configure.',
        notes:[['Collected automatically','Your applications write to the console. The output is already available in the dashboard.'],['Search them together','Look across applications from one place.'],['Focus when needed','Filter by application, log level, and time.']]},
    {id:'documents',view:'documents',label:'05 · Documents',first:'See the data',second:'behind the product.',
        copy:'Explore the documents your product stores and makes searchable. Find a reservation, inspect its fields, and see the information your application is working with.',
        notes:[['Browse collections','Find the product data you want to inspect.'],['Inspect the fields','Open a document to see its contents.'],['Search directly','Find relevant records without building a separate administration screen.']]},
    {id:'insights',view:'insights',label:'06 · Insights',first:'See where',second:'the work goes.',
        copy:'Explore how work is distributed across applications, consumers, and handlers. Compare activity and processing time, then focus on the parts reporting errors or falling behind.',
        notes:[['A connected overview','Move from an application to the work happening inside it.'],['Performance in context','Compare call counts, total time, average time, and the slowest calls.'],['Focus on problems','Bring errors and consumers that are disconnected or behind into view.']]},
] as const;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BrandHead title="See what happened. Understand why. — Fluxzero monitoring"
        description="Explore Fluxzero monitoring: audit trails, traces, issues, application logs, documents, and performance insights. Evidence for you and your agent, built into the cloud." />
</head>
<body class="v4-page agent4-page cloud-proof-page cloud-proof-next-page monitoring-page">
    <MarketingHeader active="how-it-works" />
    <main>
        <header class="cloud-proof-hero cloud-proof-next-hero monitoring-hero">
            <span class="monitoring-sun" aria-hidden="true"></span>
            <div class="v4-shell cloud-proof-shell">
                <p class="cloud-proof-hero__back"><a href="/how-it-works#layers-title" data-browser-back><i class="bx bx-left-arrow-alt" aria-hidden="true"></i> Back</a></p>
                <p class="cloud-proof-next__eyebrow">Monitoring</p>
                <h1>See what happened.<br /><span>Understand why.</span></h1>
                <p class="cloud-proof-hero__lead">Follow customer actions, inspect your product’s data, and find the cause of failures. The evidence is there for you and your agent to work with.</p>
            </div>
        </header>
        {sections.map(section => (
            <article class="cloud-proof-section cloud-proof-next-section monitoring-section" id={section.id} aria-labelledby={`${section.id}-title`}>
                <div class="v4-shell cloud-proof-shell">
                    <header class="cloud-proof-copy">
                        <p class="cloud-proof-next__number">{section.label}</p>
                        <h2 id={`${section.id}-title`}>{section.first}<br /><span>{section.second}</span></h2>
                        <p>{section.copy}</p>
                    </header>
                    <DashboardExample view={section.view} />
                    <dl class="monitoring-notes">
                        {section.notes.map(([title,copy]) => <div><dt>{title}</dt><dd>{copy}</dd></div>)}
                    </dl>
                </div>
            </article>
        ))}
        <section class="cloud-proof-section cloud-proof-next-section monitoring-agent" aria-labelledby="agent-evidence-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy">
                    <p class="cloud-proof-next__number">07 · Working with your agent</p>
                    <h2 id="agent-evidence-title">Give your agent<br /><span>the evidence.</span></h2>
                    <p>Give your agent the whole trace that led to an error: the request, the messages it triggered, and the failure. Combine that with the state of your product at the time, so it can investigate what happened and test a fix.</p>
                </header>
                <div class="monitoring-agent-example">
                    <div>
                        <span class="monitoring-agent-example__label">From failure to understanding</span>
                        <h3>The whole story.<br />Not just the error.</h3>
                        <p>Follow the chain of events, travel back to earlier product state, and compare what changed. Your agent gets the context to reproduce the problem and write a regression test.</p>
                    </div>
                    <figure>
                        <figcaption>Reservation trace <span>Context for your agent</span></figcaption>
                        <pre><code>{`POST /api/reservations
  → ReserveTicket
    → StartPayment
      → PaymentProviderTimeout

Reservation: reservation-1042
State at failure: awaiting payment`}</code></pre>
                    </figure>
                </div>
            </div>
        </section>
        <section class="cloud-proof-next-conclusion" aria-labelledby="monitoring-conclusion-title">
            <div class="v4-shell cloud-proof-shell">
                <p class="cloud-proof-next__eyebrow">Built into the cloud</p>
                <h2 id="monitoring-conclusion-title">Your product runs.<br /><span>You can see how.</span></h2>
                <p>Audit trails, application logs, traces, issues, documents, and insights belong to the same foundation your product already runs on.</p>
                <div class="cloud-proof-next__actions">
                    <a class="v4-button v4-button--primary" href="/get-started">Start building <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                    <a class="v4-button v4-button--secondary" href="/product-code">Explore the product code <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                </div>
            </div>
        </section>
    </main>
    <MarketingFooter />
    <script src="/js/v4.js?v=20260904-2" defer></script>
</body>
</html>
