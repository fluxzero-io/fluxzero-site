---
import { fluxzeroBrand } from '../config/brand.mjs';
---
<a href="/" class="site-title" aria-label="Fluxzero home">
    <img class="brand-lockup brand-lockup-dark" src={fluxzeroBrand.logo} width="181" height="40" alt="Fluxzero">
    <img class="brand-lockup brand-lockup-light" src={fluxzeroBrand.logoLight} width="181" height="40" alt="Fluxzero">
    <img class="brand-mark brand-mark-dark" src={fluxzeroBrand.mark} width="22" height="24" alt="Fluxzero">
    <img class="brand-mark brand-mark-light" src={fluxzeroBrand.markLight} width="22" height="24" alt="Fluxzero">
</a>
<style>
    .site-title { display: flex; align-items: center; flex-shrink: 0; text-decoration: none; }
    .brand-lockup { display: block; width: clamp(120px, 10.5vw, 140px); height: auto; }
    .brand-mark, .brand-lockup-light { display: none; }
    @media (min-width: 375px) {
        :global([data-theme="light"]) .brand-lockup-dark { display: none; }
        :global([data-theme="light"]) .brand-lockup-light { display: block; }
    }
    @media (max-width: 600px) { .brand-lockup { width: 120px; } }
    @media (max-width: 374px) {
        .brand-lockup { display: none; }
        .brand-mark { display: block; width: 22px; height: 24px; }
        .brand-mark-light { display: none; }
        :global([data-theme="light"]) .brand-mark-dark { display: none; }
        :global([data-theme="light"]) .brand-mark-light { display: block; }
    }
</style>
