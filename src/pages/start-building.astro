---
import BrandHead from '../components/BrandHead.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';

const codingTools = [
    { id: 'claude', name: 'Claude Code', href: 'https://code.claude.com/docs/en/desktop' },
    { id: 'codex', name: 'Codex', href: 'https://developers.openai.com/codex/cloud' },
    { id: 'cursor', name: 'Cursor', href: 'https://cursor.com/download' },
    { id: 'other', name: 'Other', href: '' },
];
const directionFields = [
    {
        id: 'builder-type',
        label: 'Builder type',
        key: 'builderType',
        options: ['Solo', 'Startup', 'Team'],
    },
    {
        id: 'project-stage',
        label: 'Project stage',
        key: 'projectStage',
        options: ['Prototype', 'New project', 'Existing product rebuild', 'Live product'],
    },
    {
        id: 'experience-level',
        label: 'Experience level',
        key: 'experienceLevel',
        options: ['Non-technical', 'Product builder', 'Developer', 'Advanced'],
    },
    {
        id: 'builder-role',
        label: 'Role',
        key: 'role',
        options: ['Founder', 'Product lead', 'Designer', 'Developer', 'Operator'],
    },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead title="Start building with Fluxzero" description="Choose your AI tool, connect Fluxzero, and start building on a production-ready foundation" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,200;1,300;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css?v=20260624-14">
    <link rel="stylesheet" href="/css/marketing-shell.css?v=20260623-1">
</head>
<body class="start-body">
<MarketingHeader />

<main class="start-page">
    <section class="start-hero" aria-labelledby="start-hero-title">
        <div class="start-hero__content">
            <p class="start-eyebrow">Start building</p>
            <h1 id="start-hero-title">Start building with Fluxzero</h1>
            <p>Choose your AI tool, connect Fluxzero, and start building on a production-ready foundation</p>
        </div>

    </section>

    <section class="start-guide" aria-label="Fluxzero build setup">
        <article class="start-step start-step--agent" id="select-agent">
            <div class="start-step__number" aria-hidden="true">1</div>
            <div class="start-step__body">
                <h2>Select agent</h2>
                <p>Install the AI build tool you want Fluxzero to work with.</p>

                <div class="agent-picker" data-agent-picker>
                    <details class="agent-dropdown" data-agent-dropdown>
                        <summary class="agent-dropdown__summary">
                            <span class="agent-selected">
                                <span class="agent-selected__icon" data-agent-selected-icon aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M12 3.5 14.8 9l5.7 2.7-5.7 2.5L12 20.5l-2.8-6.3-5.7-2.5L9.2 9 12 3.5Z"/><path d="M12 8.2v7.6M8.4 11.9h7.2"/></svg>
                                </span>
                                <span class="agent-selected__text">
                                    <strong data-agent-selected-name>Claude Code</strong>
                                    <small>Selected agent</small>
                                </span>
                            </span>
                        </summary>
                        <div class="agent-dropdown__menu">
                            {codingTools.map((tool) => (
                                <label
                                    class={`agent-option${tool.id === 'other' ? ' agent-option--muted' : ''}`}
                                    data-agent-option
                                    data-agent-id={tool.id}
                                    data-agent-name={tool.name}
                                    data-agent-href={tool.href}
                                >
                                    <input type="radio" name="ai-agent" value={tool.id} checked={tool.id === 'claude'}>
                                    <span class="agent-option__icon" aria-hidden="true">
                                        {tool.id === 'claude' && (
                                            <svg viewBox="0 0 24 24"><path d="M12 3.5 14.8 9l5.7 2.7-5.7 2.5L12 20.5l-2.8-6.3-5.7-2.5L9.2 9 12 3.5Z"/><path d="M12 8.2v7.6M8.4 11.9h7.2"/></svg>
                                        )}
                                        {tool.id === 'codex' && (
                                            <svg viewBox="0 0 24 24"><path d="M11.2 19.4a3.5 3.5 0 0 0 6.8-1.2V13l-6-3.4"/><path d="M5.2 15a3.5 3.5 0 0 0 4.5 5.3L14 17.7v-6.9"/><path d="M6 7.6a3.5 3.5 0 0 0-2.3 6.4L8 16.6l6-3.4"/><path d="M12.8 4.6A3.5 3.5 0 0 0 6 5.8v5.1l6 3.5"/><path d="M18.8 9A3.5 3.5 0 0 0 14.3 3.7L10 6.3v6.9"/><path d="M18 16.3a3.5 3.5 0 0 0 2.3-6.4L16 7.4l-6 3.4"/></svg>
                                        )}
                                        {tool.id === 'cursor' && (
                                            <svg viewBox="0 0 24 24"><path d="M5 3.5 19.5 12 5 20.5V3.5Z"/><path d="m9 8 6.5 4L9 16V8Z"/></svg>
                                        )}
                                        {tool.id === 'other' && (
                                            <svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                        )}
                                    </span>
                                    <span class="agent-option__text">{tool.name}</span>
                                </label>
                            ))}
                        </div>
                    </details>
                    <p class="agent-download-note" data-agent-download-note>
                        <span data-agent-download-copy>Not installed yet?</span>
                        <a href="https://code.claude.com/docs/en/desktop" target="_blank" rel="noreferrer" data-agent-download-link>
                            Download <span data-agent-download-name>Claude Code</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7"/><path d="M9 7h8v8"/></svg>
                        </a>
                        <span data-agent-other-note hidden>Use the AI tool you already work with.</span>
                    </p>
                </div>
            </div>
        </article>

        <article class="start-step start-step--installer" id="install-fluxzero">
            <div class="start-step__number" aria-hidden="true">2</div>
            <div class="start-step__body start-step__body--split">
                <div>
                    <h2>Install Fluxzero</h2>
                    <p>Make sure it is installed before proceeding.</p>
                    <div class="start-actions fluxzero-install-action">
                        <button class="fluxzero-download-cta" type="button" disabled>
                            <span>Download Fluxzero</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/></svg>
                        </button>
                    </div>
                </div>
                <div class="fluxzero-app-icon" aria-label="Fluxzero installer app icon">
                    <span class="logo-mark fluxzero-app-icon__mark" aria-hidden="true"></span>
                </div>
            </div>
        </article>

        <article class="start-step start-step--brief" id="project-brief">
            <div class="start-step__number" aria-hidden="true">3</div>
            <div class="start-step__body">
                <h2>Set direction</h2>
                <p>Tell Fluxzero what kind of build this is.</p>

                <form class="brief-form" id="project-brief-form">
                    <div class="brief-field brief-field--prompt">
                        <div class="brief-field__head">
                            <span>Your idea</span>
                            <button class="prompt-edit-button" type="button" data-prompt-edit aria-label="Edit prompt" aria-pressed="false">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 20 4.2-1 10.6-10.6a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z"/><path d="m14.5 6.5 3 3"/></svg>
                            </button>
                        </div>
                        <textarea id="brief-idea" rows="4" data-brief-idea placeholder="A platform that helps..." readonly></textarea>
                    </div>

                    <div class="brief-grid brief-grid--direction">
                        {directionFields.map((field) => (
                            <label class="brief-field" for={field.id}>
                                <span>{field.label}</span>
                                <select id={field.id} data-direction-field data-direction-key={field.key}>
                                    {field.options.map((option) => <option value={option}>{option}</option>)}
                                </select>
                            </label>
                        ))}
                    </div>

                    <pre data-combined-prompt hidden>Original idea:
A platform that helps...

Project brief additions:
Selected agent:
Claude Code

Builder type:
Solo

Project stage:
Prototype

Experience level:
Non-technical

Role:
Founder

Fluxzero automatically handles:
- Project structure
- Database
- Base interface
- Deployment preparation

You stay in control of:
- Content
- Features
- Adjustments
- Launch</pre>
                </form>
            </div>
        </article>

        <div class="start-final" data-start-handoff>
            <button class="open-project-cta" type="button" data-codex-button data-codex-prompt-key="fluxzeroCodexHandoff">Open project</button>
            <p class="handoff-message" data-handoff-message role="status" aria-live="polite"></p>
        </div>
    </section>
</main>

<script src="/js/start-building.js?v=20260624-4" defer></script>
</body>
</html>
