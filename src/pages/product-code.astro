    <span class="tok-type">ContactEmail</span> <span class="tok-field">contactEmail</span>) {

    <span class="tok-annotation">@AssertLegal</span>
    <span class="tok-keyword">void</span> <span class="tok-method">assertOwner</span>(<span class="tok-type">Reservation</span> reservation, <span class="tok-type">User</span> user) {
        <span class="tok-keyword">if</span> (!reservation.<span class="tok-method">customerId</span>()
