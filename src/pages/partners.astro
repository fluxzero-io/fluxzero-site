---
import '../../public/css/v4.css';
import '../../public/css/marketing-shell.css';
import '../../public/css/marketing-forms.css';
import '../../public/css/partners.css';
import BrandHead from '../components/BrandHead.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead title="Partners — Fluxzero" description="More projects. Less to manage. Fluxzero maintains the technical foundation, so your team can focus on the product. Let’s talk." />
</head>
<body class="v4-page partners-page">
    <a class="partners-skip" href="#main">Skip to content</a>
    <MarketingHeader />
    <main id="main" class="partners-main">
        <div class="partners-layout">
            <header class="partners-intro">
                <h1>More projects.<br><span>Less to manage.</span></h1>
                <div class="partners-reasons">
                    <h2>Why partners choose Fluxzero</h2>
                    <ol>
                        <li>Turn demos into reliable products with minimal effort.</li>
                        <li>Ship more with less maintenance.</li>
                        <li>See what went wrong and fix it faster.</li>
                    </ol>
                </div>
                <div class="partners-benefits">
                    <h2>As a Fluxzero partner</h2>
                    <p class="partners-lead">You work directly with the Fluxzero team. We help you get started, answer your questions and guide you as you build. We can also refer clients to you.</p>
                    <p class="partners-lead">Get in touch for details on commercial terms.</p>
                </div>
            </header>

            <section class="partners-contact marketing-form-panel contact-form-wrap" aria-labelledby="contact-title">
                <form action="https://getform.io/f/bejeorxa" id="contactForm" class="contact-form" method="POST" novalidate>
                    <div class="contact-form-head">
                        <h2 id="contact-title">Become a partner.</h2>
                    </div>
                    <input type="hidden" name="_gotcha">
                    <input type="hidden" name="source" value="Partners">
                    <div class="contact-field">
                        <label for="fn">Name</label>
                        <input name="name" type="text" id="fn" autocomplete="name" required>
                    </div>
                    <div class="contact-field">
                        <label for="email">Work email</label>
                        <input name="email" type="email" id="email" autocomplete="email" required>
                    </div>
                    <div class="contact-field">
                        <label for="message">Tell us about your projects</label>
                        <textarea name="message" id="message" rows="4" required></textarea>
                    </div>
                    <button type="submit" id="submitButton" class="btn-p contact-submit" data-confirmation="true"><span data-button-label>Send message</span></button>
                    <p id="formStatus" class="form-status partners-status" role="status" aria-live="polite" data-success-message="Thanks! We'll be in touch."></p>
                </form>
            </section>
        </div>
    </main>
    <MarketingFooter />
    <script src="../scripts/contact-form.ts"></script>
</body>
</html>
