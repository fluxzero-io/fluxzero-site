const consumerCode = `<span class="tok-annotation">@Component</span>
<span class="tok-annotation">@Consumer</span>(<span class="tok-field">name</span> = <span class="tok-string">"reservation-receipts"</span>, <span class="tok-field">threads</span> = <span class="tok-number">4</span>)
<span class="tok-keyword">final</span> <span class="tok-keyword">class</span> <span class="tok-type">ReservationReceipts</span> {
    <span class="tok-annotation">@HandleEvent</span>
    <span class="tok-keyword">void</span> <span class="tok-method">create</span>(<span class="tok-type">ConfirmReservation</span> event, <span class="tok-type">Reservation</span> reservation) {
