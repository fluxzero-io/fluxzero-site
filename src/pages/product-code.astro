    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">Reservation</span> <span class="tok-method">remove</span>(<span class="tok-type">Reservation</span> reservation) {
        <span class="tok-keyword">return</span> <span class="tok-literal">null</span>;
