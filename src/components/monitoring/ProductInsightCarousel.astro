---
import '../../../public/css/marketing-buttons.css';
import { productInsightSections } from '../../data/product-insight';
import DashboardExample from './DashboardExample.astro';

const slides = productInsightSections.map(section => ({
    id: section.id,
    view: section.view,
    name: section.label.split(' · ')[1],
}));
---

<section class="cloud-proof-section cloud-proof-next-section insight-section" id="product-insight" aria-labelledby="product-insight-title">
    <div class="v4-shell cloud-proof-shell">
        <header class="cloud-proof-copy" data-reveal>
            <p class="cloud-proof-next__number">06 · Product insight</p>
            <h2 id="product-insight-title">Deep insight.<br /><span>Built in from day one.</span></h2>
            <p>Fluxzero gives your agent all the evidence it needs to understand production. Every product starts with this depth of insight, without extra tools or setup.</p>
        </header>

        <product-insight-carousel class="insight-carousel" data-insight-carousel data-monitoring-group role="region" aria-roledescription="carousel" aria-label="Product insight examples">
            <div class="insight-carousel__toolbar" data-llms-exclude>
                <div class="insight-carousel__picker" role="group" aria-label="Choose an insight example">
                    {slides.map((slide, index) => (
                        <button type="button" id={`insight-${slide.id}-picker`} data-insight-picker={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`insight-${slide.id}`}>
                            {slide.name}
                        </button>
                    ))}
                </div>
            </div>

            <div class="insight-carousel__track" id="insight-slides" data-insight-track>
                {slides.map(slide => (
                    <article class="insight-carousel__slide" id={`insight-${slide.id}`} data-insight-slide aria-labelledby={`insight-${slide.id}-picker`}>
                        <DashboardExample view={slide.view} sharedHeight mobileApplication={slide.view === 'insights' ? 'Payments' : undefined} />
                    </article>
                ))}
            </div>
        </product-insight-carousel>
        <div class="insight-section__actions">
            <a class="btn-s" href="/product-insight/">See how Fluxzero gives you full insight →</a>
        </div>
    </div>
</section>

<style>
    .insight-section {
        --monitoring-line: rgba(134, 181, 220, .18);
    }

    .insight-section__actions {
        display: flex;
        justify-content: center;
        margin-top: 34px;
    }

    .insight-carousel {
        display: block;
        margin-top: 52px;
        --insight-progress: 0;
        --insight-frame-height: max(880px, var(--monitoring-height, 0px));
    }

    .insight-carousel__toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 34px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--proof-line);
    }

    .insight-carousel__picker {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .insight-carousel button {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 10px 15px;
        border: 1px solid var(--proof-line);
        border-radius: 999px;
        background: rgba(13, 25, 39, .65);
        color: #a9b8ca;
        font: 500 13px/1.4 var(--font-body);
        cursor: pointer;
        transition: background .18s, border-color .18s, color .18s;
    }

    .insight-carousel button:hover,
    .insight-carousel button[aria-pressed="true"] {
        border-color: rgba(114, 184, 244, .65);
        background: rgba(69, 142, 205, .15);
        color: #cbe8ff;
    }

    .insight-carousel button:focus-visible {
        outline: 2px solid var(--proof-blue);
        outline-offset: 4px;
    }

    .insight-carousel__picker button::before,
    .insight-carousel__picker button::after {
        content: '';
        position: absolute;
        right: 15px;
        bottom: -8px;
        left: 15px;
        height: 2px;
        border-radius: 2px;
        opacity: 0;
        background: rgba(134, 181, 220, .15);
        pointer-events: none;
    }

    .insight-carousel__picker button::after {
        background: #87c4f3;
        transform: scaleX(var(--insight-progress));
        transform-origin: left;
    }

    .insight-carousel__picker button[aria-pressed="true"]::before,
    .insight-carousel__picker button[aria-pressed="true"]::after {
        opacity: .7;
    }

    /* Reserve the tallest demo to keep tab changes stable. */
    .insight-carousel :global(.monitoring-example__frame) {
        height: var(--insight-frame-height);
    }

    @media (prefers-reduced-motion: reduce) {
        .insight-carousel__picker button::before,
        .insight-carousel__picker button::after { display: none; }
    }

    .insight-carousel__track {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 100%;
        align-items: start;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
    }

    .insight-carousel__track::-webkit-scrollbar {
        display: none;
    }

    .insight-carousel__slide {
        min-width: 0;
        scroll-snap-align: start;
    }

    @media (max-width: 767px) {
        /* Each mobile tab uses its own content height. Hidden examples cannot
           leave an empty frame below the single Payments tree. */
        .insight-carousel__track { display: block; overflow: visible; }
        .insight-carousel__slide[inert] { display: none; }
        .insight-carousel :global(.monitoring-example__frame) {
            height: var(--monitoring-content-height, 640px);
        }
        .insight-carousel__picker button::before,
        .insight-carousel__picker button::after { display: none; }
    }

    @media (max-width: 600px) {
        .insight-section__actions .btn-s { width: 100%; justify-content: center; }
        .insight-carousel { margin-top: 36px; }
        .insight-carousel__toolbar { gap: 16px; }
    }
</style>

<script>
    class ProductInsightCarousel extends HTMLElement {
        private cleanup?: () => void;

        connectedCallback() {
            const track = this.querySelector<HTMLElement>('[data-insight-track]')!;
            const slides = [...this.querySelectorAll<HTMLElement>('[data-insight-slide]')];
            const pickers = [...this.querySelectorAll<HTMLButtonElement>('[data-insight-picker]')];
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            const mobile = window.matchMedia('(max-width: 767px)');
            const abort = new AbortController();
            const { signal } = abort;
            const duration = 8000;
            let active = 0;
            let scrollTarget: number | null = null;
            let scrollFrame = 0;
            let timerFrame = 0;
            let elapsed = 0;
            let lastTime = 0;
            let inView = false;
            let hovering = false;
            let focused = false;

            const resetProgress = () => {
                elapsed = 0;
                lastTime = performance.now();
                this.style.setProperty('--insight-progress', '0');
            };
            const update = (index: number) => {
                active = index;
                pickers.forEach((button, i) => button.setAttribute('aria-pressed', String(i === active)));
                slides.forEach((slide, i) => { slide.inert = i !== active; });
                resetProgress();
            };
            const goTo = (index: number) => {
                const target = (index + slides.length) % slides.length;
                scrollTarget = target;
                update(target);
                if (!mobile.matches) track.scrollTo({ left: target * track.clientWidth, behavior: 'instant' });
                if (!reducedMotion.matches) {
                    slides[target].getAnimations().forEach(animation => animation.cancel());
                    slides[target].animate([{ opacity: .2 }, { opacity: 1 }], { duration: 240, easing: 'ease-out' });
                }
            };
            const shouldRun = () => inView && !hovering && !focused && !document.hidden && !reducedMotion.matches && !mobile.matches;
            const tick = (time: number) => {
                timerFrame = 0;
                if (!shouldRun()) return;
                elapsed += time - lastTime;
                lastTime = time;
                if (elapsed >= duration) goTo(active + 1);
                this.style.setProperty('--insight-progress', String(elapsed / duration));
                timerFrame = requestAnimationFrame(tick);
            };
            const sync = () => {
                cancelAnimationFrame(timerFrame);
                if (shouldRun()) {
                    lastTime = performance.now();
                    timerFrame = requestAnimationFrame(tick);
                }
            };

            pickers.forEach((button, index) => {
                button.addEventListener('click', () => goTo(index), { signal });
                button.addEventListener('keydown', event => {
                    let target = index;
                    if (event.key === 'ArrowRight') target = (index + 1) % slides.length;
                    else if (event.key === 'ArrowLeft') target = (index + slides.length - 1) % slides.length;
                    else if (event.key === 'Home') target = 0;
                    else if (event.key === 'End') target = slides.length - 1;
                    else return;
                    event.preventDefault();
                    pickers[target].focus();
                    goTo(target);
                }, { signal });
            });

            track.addEventListener('pointerdown', () => { scrollTarget = null; }, { signal });
            track.addEventListener('wheel', () => { scrollTarget = null; }, { passive: true, signal });
            track.addEventListener('scroll', () => {
                if (mobile.matches) return;
                cancelAnimationFrame(scrollFrame);
                scrollFrame = requestAnimationFrame(() => {
                    if (scrollTarget !== null) {
                        if (Math.abs(track.scrollLeft - scrollTarget * track.clientWidth) < 2) scrollTarget = null;
                        return;
                    }
                    const index = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
                    if (index !== active) update(index);
                });
            }, { passive: true, signal });

            this.addEventListener('pointerenter', event => {
                if (event.pointerType === 'mouse') { hovering = true; sync(); }
            }, { signal });
            this.addEventListener('pointerleave', () => { hovering = false; sync(); }, { signal });
            this.addEventListener('focusin', () => { focused = true; sync(); }, { signal });
            this.addEventListener('focusout', event => {
                focused = event.relatedTarget instanceof Node && this.contains(event.relatedTarget);
                sync();
            }, { signal });
            // Focus inside an embedded demo does not bubble to the parent document.
            window.addEventListener('blur', () => {
                focused = this.contains(document.activeElement);
                sync();
            }, { signal });
            window.addEventListener('focus', () => {
                focused = this.contains(document.activeElement);
                sync();
            }, { signal });
            document.addEventListener('visibilitychange', sync, { signal });
            reducedMotion.addEventListener('change', sync, { signal });
            mobile.addEventListener('change', () => { goTo(active); sync(); }, { signal });

            const visibilityObserver = new IntersectionObserver(([entry]) => {
                inView = entry.isIntersecting && entry.intersectionRatio >= .25;
                sync();
            }, { threshold: [0, .25], rootMargin: '-72px 0px 0px' });
            visibilityObserver.observe(this);
            let width = track.clientWidth;
            const resizeObserver = new ResizeObserver(() => {
                if (track.clientWidth === width) return;
                width = track.clientWidth;
                scrollTarget = null;
                if (!mobile.matches) track.scrollTo({ left: active * width, behavior: 'instant' });
            });
            resizeObserver.observe(track);
            update(0);
            this.cleanup = () => {
                abort.abort();
                visibilityObserver.disconnect();
                resizeObserver.disconnect();
                cancelAnimationFrame(timerFrame);
                cancelAnimationFrame(scrollFrame);
            };
        }

        disconnectedCallback() { this.cleanup?.(); }
    }

    if (!customElements.get('product-insight-carousel')) customElements.define('product-insight-carousel', ProductInsightCarousel);
</script>
