---
import '../../public/css/v4.css';
import '../../public/css/agents.css';
import '../../public/css/technical-foundation.css';
import '../../public/css/technical-foundation-next.css';
import '../../public/css/marketing-shell.css';
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import FoundationSections from '../components/marketing/FoundationSections.astro';
import 'boxicons/css/boxicons.min.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead
        title="How Fluxzero keeps your product running — Fluxzero"
        description="See how Fluxzero gives every product the correctness, security, privacy, recovery, auditability, and scale enterprises require from day zero."
    />
</head>
<body class="v4-page agent4-page cloud-proof-page cloud-proof-next-page">
    <MarketingHeader active="how-it-works" />

    <main>
        <header class="cloud-proof-hero cloud-proof-next-hero">
            <span class="cloud-proof-hero__sun" aria-hidden="true"></span>
            <div class="v4-shell cloud-proof-shell">
                <p class="cloud-proof-hero__back" data-reveal><a href="/how-it-works/#customer-isolation" data-browser-back><i class="bx bx-left-arrow-alt" aria-hidden="true"></i> Back</a></p>
                <p class="cloud-proof-next__eyebrow" data-reveal>Technical foundation</p>
                <h1 data-reveal data-reveal-delay="1">How Fluxzero keeps<br><span>your product running.</span></h1>
                <p class="cloud-proof-hero__lead" data-reveal data-reveal-delay="2">Enterprises expect critical systems to keep their promises under pressure. That standard matters long before a product reaches enterprise size. With Fluxzero, it is built into every product from day zero.</p>
            </div>
        </header>

        <FoundationSections />

        <section class="cloud-proof-next-conclusion" aria-labelledby="conclusion-title">
            <div class="v4-shell cloud-proof-shell" data-reveal>
                <p class="cloud-proof-next__eyebrow">From day zero</p>
                <h2 id="conclusion-title">Enterprise-grade guarantees.<br><span>Democratized.</span></h2>
                <p>On an infrastructure cloud, you are responsible for these guarantees in every product. With Fluxzero, they are properties of the cloud.</p>
                <strong>Build the product. Skip everything else.</strong>
                <div class="cloud-proof-next__actions">
                    <a class="v4-button v4-button--primary" href="/get-started/"><span>Start building</span><i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                    <a class="v4-button v4-button--secondary" href="/docs/guides"><span>Inspect the technical docs</span><i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                </div>
            </div>
        </section>

    </main>

    <MarketingFooter />
    <script src="/js/v4.js?v=20260904-2" defer></script>
</body>
</html>
