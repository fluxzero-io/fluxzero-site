            min-height: 700px;
            padding: 28px;
            border-radius: 12px;
            border: 1px solid rgba(0, 179, 255, 0.32);
            background:
                radial-gradient(circle at 50% 0%, rgba(0, 179, 255, 0.11), transparent 46%),
