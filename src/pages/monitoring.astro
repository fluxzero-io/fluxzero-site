---
import '../../public/css/v4.css';
import '../../public/css/agents.css';
import '../../public/css/technical-foundation.css';
import '../../public/css/technical-foundation-next.css';
import '../../public/css/marketing-shell.css';
import '../../public/css/monitoring.css';
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import DashboardExample from '../components/monitoring/DashboardExample.astro';
import 'boxicons/css/boxicons.min.css';
const sections = [
    {id:'audit-trail',view:'audit',label:'01 · Audit trail',first:'Every action',second:'leaves a trail.',
        copy:'Find exactly what happened in your product, for example, why a reservation was cancelled or a payment never arrived. The original messages show what happened along the way.',
        notes:[['Product language','Follow the actions your product understands, with their original data attached.'],['Everything in one history','From web traffic to scheduled work and errors, the history is already there to investigate.'],['Search and filter','Narrow the history by message type, time, and relevant fields.']]},
    {id:'traces',view:'trace',label:'02 · Traces',first:'Follow the action.',second:'See exactly what it set in motion.',
        copy:'One action can trigger work across several applications. Follow its trace to see exactly what happened along the way and where time was spent.',
        notes:[['The whole chain','Follow a request through the work it triggered.'],['Across applications','See how different parts of your product worked together.'],['Timing included','Distinguish processing time from time spent waiting.']]},
    {id:'issues',view:'issues',label:'03 · Issues',first:'Your product’s issues.',second:'Your agent’s work queue.',
        copy:'Every product comes with a shared work queue for investigating and resolving failures. Your agent gets the evidence behind each issue, so it can work on the cause instead of asking you to explain the symptoms.',
        notes:[['Recognize recurring problems','See how often a failure happens and when it started.'],['Keep the evidence','Inspect individual occurrences with their error details and application context.'],['Track what needs attention','Resolve or mute issues, individually or in bulk. Keep open problems in view.']]},
    {id:'logs',view:'logs',label:'04 · Application logs',first:'Every application.',second:'One place for logs.',
        copy:'Logs from all your applications come together automatically. Search across them from one place, without a separate logging service to configure.',
        notes:[['Collected automatically','Your applications write their logs. The output is already available in the dashboard.'],['Search them together','Look across applications from one place.'],['Focus when needed','Filter by application, log level, and time.']]},
    {id:'documents',view:'documents',label:'05 · Documents',first:'See the data',second:'behind your product.',
        copy:'Explore the documents your product stores and makes searchable. Inspect exactly what is stored, with export available whenever you need the data outside the dashboard.',
        notes:[['Browse collections','Explore the different kinds of data your product works with.'],['Inspect the details','Open a document to see its fields and values.'],['Search directly','Find the records you need without writing SQL or building a separate administration screen.']]},
    {id:'insights',view:'insights',label:'06 · Insights',first:'Slowdowns and errors.',second:'Visible at a glance.',
        copy:'See where your product is slow or failing in one view. Open the affected part to see exactly what is happening there.',
        notes:[['Spot the bottlenecks','Find slow processing and work that is piling up.'],['Compare the workload','See how often each part runs and how much time it takes.'],['Focus on trouble','Bring errors and parts that have fallen behind into view.']]},
] as const;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BrandHead title="Deep insight. Built in from day one. — Fluxzero monitoring"
        description="Explore Fluxzero monitoring: audit trails, traces, issues, application logs, documents, and performance insights. Evidence for you and your agent, built into the cloud." />
</head>
<body class="v4-page agent4-page cloud-proof-page cloud-proof-next-page monitoring-page">
    <MarketingHeader active="how-it-works" />
    <main>
        <header class="cloud-proof-hero cloud-proof-next-hero monitoring-hero">
            <span class="monitoring-sun" aria-hidden="true"></span>
            <div class="v4-shell cloud-proof-shell">
                <p class="cloud-proof-hero__back"><a href="/how-it-works#layers-title" data-browser-back><i class="bx bx-left-arrow-alt" aria-hidden="true"></i> Back</a></p>
                <p class="cloud-proof-next__eyebrow">Monitoring</p>
                <h1>Deep insight.<br /><span>Built in from day one.</span></h1>
                <p class="cloud-proof-hero__lead">See exactly what your product is doing and understand why it behaves the way it does.</p>
                <p class="cloud-proof-hero__lead">Because everything runs on one shared foundation, the connections are already there. Every product starts with this depth of insight, without extra tools or setup.</p>
            </div>
        </header>
        {sections.map(section => (
            <article class="cloud-proof-section cloud-proof-next-section monitoring-section" id={section.id} aria-labelledby={`${section.id}-title`}>
                <div class="v4-shell cloud-proof-shell">
                    <header class="cloud-proof-copy">
                        <p class="cloud-proof-next__number">{section.label}</p>
                        <h2 id={`${section.id}-title`}>{section.first}<br /><span>{section.second}</span></h2>
                        <p>{section.copy}</p>
                    </header>
                    <DashboardExample view={section.view} />
                    <dl class="monitoring-notes">
                        {section.notes.map(([title,copy]) => <div><dt>{title}</dt><dd>{copy}</dd></div>)}
                    </dl>
                </div>
            </article>
        ))}
        <section class="cloud-proof-section cloud-proof-next-section monitoring-agent" aria-labelledby="agent-evidence-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy">
                    <p class="cloud-proof-next__number">07 · Working with your agent</p>
                    <h2 id="agent-evidence-title">A treasure trove<br /><span>for your agent.</span></h2>
                    <p>A database usually tells your agent what is true now. Logs reveal only what someone thought to record. That leaves your agent reconstructing how the product reached a particular state.</p>
                    <p>Here, the history connects what happened to what followed. Your agent can investigate the product as it was when something went wrong, with the trace that explains how it got there.</p>
                </header>
                <div class="monitoring-agent-example">
                    <div>
                        <span class="monitoring-agent-example__label">From failure to a tested fix</span>
                        <h3>Enough context<br />to move beyond guesswork.</h3>
                        <p>Your agent can turn a production failure into a reproducible test. That makes the fix something you can verify. Your tests can catch the same mistake next time.</p>
                    </div>
                    <figure>
                        <figcaption>Reservation trace <span>Context for your agent</span></figcaption>
                        <pre><code>{`POST /api/reservations
  → ReserveTicket
    → StartPayment
      → PaymentProviderTimeout

Reservation: reservation-1042
State at failure: awaiting payment`}</code></pre>
                    </figure>
                </div>
            </div>
        </section>
        <section class="cloud-proof-next-conclusion" aria-labelledby="monitoring-conclusion-title">
            <div class="v4-shell cloud-proof-shell">
                <p class="cloud-proof-next__eyebrow">Built into every product</p>
                <h2 id="monitoring-conclusion-title">Less to manage.<br /><span>More to see.</span></h2>
                <p>Fluxzero gives you a deeper understanding of what happens inside it. You can follow a single interaction through the whole product and understand how it reached its outcome.</p>
                <p>You and your agent get the full story, so improvements start with evidence instead of guesswork.</p>
                <div class="cloud-proof-next__actions">
                    <a class="v4-button v4-button--primary" href="/get-started">Start building <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                    <a class="v4-button v4-button--secondary" href="/product-code">Explore the product code <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                </div>
            </div>
        </section>
    </main>
    <MarketingFooter />
    <script src="/js/v4.js?v=20260904-2" defer></script>
</body>
</html>
