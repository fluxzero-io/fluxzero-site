---
// Project Generator Component for Fluxzero Documentation

export interface Template {
  name: string;
  description: string;
  language: 'java' | 'kotlin';
  defaultBuildTool: 'gradle' | 'maven';
}

const templates: Record<string, Template> = {
  'flux-basic-java': {
    name: 'Java Starter',
    description: 'A minimal Fluxzero setup for Java projects.',
    language: 'java',
    defaultBuildTool: 'maven'
  },
  'flux-basic-kotlin': {
    name: 'Kotlin Starter',
    description: 'A minimal Fluxzero setup for Kotlin projects.',
    language: 'kotlin',
    defaultBuildTool: 'gradle'
  },
  gamerental: {
    name: 'GameStore Demo',
    description: 'A complete demo application for game rentals.',
    language: 'java',
    defaultBuildTool: 'maven'
  }
};
---

<div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl shadow-lg overflow-hidden my-8" data-project-generator>
  <div class="bg-green-50 dark:bg-green-900/20 border-b border-green-200 dark:border-green-800 px-6 py-4">
    <div class="flex items-center gap-3">
      <div class="flex-shrink-0">
        <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
        </svg>
      </div>
      <div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Fluxzero Project Generator</h3>
        <p class="text-sm text-gray-600 dark:text-gray-300">Bootstrap your new Fluxzero project</p>
      </div>
    </div>
  </div>

  <form class="p-6" data-project-form>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="space-y-6">
        <div>
          <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Project Metadata
          </h4>

          <div class="space-y-2">
            <label for="project-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
              Project Name
            </label>
            <input
              id="project-name"
              type="text"
              value="demo"
              placeholder="my-awesome-project"
              required
              maxlength="50"
              data-project-field="projectName"
              class="w-full px-3 py-2.5 rounded-lg shadow-sm text-sm focus:outline-none focus:ring-2 border-gray-300 dark:border-gray-600 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-800 dark:text-white transition-colors"
            />
            <div hidden data-project-error="projectName" class="text-red-600 dark:text-red-400 text-xs mt-1"></div>
          </div>

          <div class="space-y-2 field-spacing">
            <label for="group-id" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
              Group
            </label>
            <input
              id="group-id"
              type="text"
              value="com.example"
              placeholder="com.example"
              data-project-field="groupId"
              class="w-full px-3 py-2.5 rounded-lg shadow-sm text-sm focus:outline-none focus:ring-2 border-gray-300 dark:border-gray-600 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-800 dark:text-white transition-colors"
            />
            <div hidden data-project-error="groupId" class="text-red-600 dark:text-red-400 text-xs mt-1"></div>
          </div>

          <div class="space-y-2 field-spacing">
            <label for="artifact-id" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
              Artifact ID
            </label>
            <input
              id="artifact-id"
              type="text"
              value="demo"
              placeholder="my-project"
              data-project-field="artifactId"
              class="w-full px-3 py-2.5 rounded-lg shadow-sm text-sm focus:outline-none focus:ring-2 border-gray-300 dark:border-gray-600 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-800 dark:text-white transition-colors"
            />
            <div hidden data-project-error="artifactId" class="text-red-600 dark:text-red-400 text-xs mt-1"></div>
          </div>

          <div class="field-spacing">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Build Tool</label>
            <div class="flex items-center gap-6">
              <label class="flex items-center gap-2 mt-0">
                <input type="radio" name="project-build-tool" value="gradle" data-project-build-tool class="text-primary-600 focus:ring-primary-500">
                <span class="text-sm text-gray-700 dark:text-gray-300">Gradle</span>
              </label>
              <label class="flex items-center gap-2 mt-0">
                <input type="radio" name="project-build-tool" value="maven" data-project-build-tool class="text-primary-600 focus:ring-primary-500" checked>
                <span class="text-sm text-gray-700 dark:text-gray-300">Maven</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div>
          <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            Project Template
          </h4>

          <div class="space-y-3">
            {Object.entries(templates).map(([templateId, template]) => (
              <label class="template-card block cursor-pointer mt-0" data-project-template-card data-template-id={templateId}>
                <input
                  type="radio"
                  name="project-template"
                  value={templateId}
                  data-project-template-option
                  class="hidden"
                  checked={templateId === 'flux-basic-java'}
                />
                <div class:list={[
                  'template-card-inner border-2 rounded-lg px-4 py-3 hover:border-primary-300 dark:hover:border-primary-600 transition-all',
                  templateId === 'flux-basic-java' ? 'border-primary-500 bg-primary-50 dark:bg-primary-900/20' : 'border-gray-200 dark:border-gray-700'
                ]} data-project-template-inner>
                  <div class="flex items-baseline gap-3">
                    <div class:list={[
                      'w-3 h-3 rounded-full border-2 mt-0.5',
                      templateId === 'flux-basic-java' ? 'border-primary-500 bg-primary-500' : 'border-gray-400'
                    ]} data-project-template-dot></div>
                    <div class="flex-1 mt-0">
                      <div class="flex items-center justify-between mb-1 gap-2 flex-wrap">
                        <h5 class="font-medium text-gray-900 dark:text-white">{template.name}</h5>
                        <span class:list={[
                          'inline-flex items-center gap-1.5 px-2 py-1 rounded text-xs font-medium',
                          template.language === 'java' ? 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300' : 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300'
                        ]}>
                          {template.language === 'java' ? (
                            <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M8.851 18.56s-.917.534.653.714c1.902.218 2.874.187 4.969-.211 0 0 .552.346 1.321.646-4.699 2.013-10.633-.118-6.943-1.149M8.276 15.933s-1.028.761.542.924c2.032.209 3.636.227 6.413-.308 0 0 .384.389.987.602-5.679 1.661-12.007.13-7.942-1.218M13.116 11.475c1.158 1.333-.304 2.533-.304 2.533s2.939-1.518 1.589-3.418c-1.261-1.772-2.228-2.652 3.007-5.688 0-.001-8.216 2.051-4.292 6.573M19.33 20.504s.679.559-.747.991c-2.712.822-11.288 1.069-13.669.033-.856-.373.75-.89 1.254-.998.527-.114.828-.093.828-.093-.953-.671-6.156 1.317-2.643 1.887 9.58 1.553 17.462-.7 14.977-1.82M9.292 13.21s-4.362 1.036-1.544 1.412c1.189.159 3.561.123 5.77-.062 1.806-.152 3.618-.477 3.618-.477s-.637.272-1.098.587c-4.429 1.165-12.986.623-10.522-.568 2.082-1.006 3.776-.892 3.776-.892M17.116 17.584c4.503-2.34 2.421-4.589.968-4.285-.355.074-.515.138-.515.138s.132-.207.385-.297c2.875-1.011 5.086 2.981-.928 4.562 0-.001.07-.062.09-.118M14.401 0s2.494 2.494-2.365 6.33c-3.896 3.077-.888 4.832-.001 6.836-2.274-2.053-3.943-3.858-2.824-5.539 1.644-2.469 6.197-3.665 5.19-7.627M9.734 23.924c4.322.277 10.959-.153 11.116-2.198 0 0-.302.775-3.572 1.391-3.688.694-8.239.613-10.937.168 0-.001.553.457 3.393.639"/>
                            </svg>
                          ) : (
                            <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                              <path d="M0 24l12-12L0 0v24zM12 12L24 0v24L12 12z"/>
                            </svg>
                          )}
                          <span>{template.language === 'java' ? 'Java' : 'Kotlin'}</span>
                        </span>
                      </div>
                      <p class="text-sm text-gray-600 dark:text-gray-400">{template.description}</p>
                    </div>
                  </div>
                </div>
              </label>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-between mt-8 pt-6 border-t border-gray-200 dark:border-gray-700 gap-4 flex-wrap">
      <div hidden data-project-message class="inline-flex items-center gap-2 text-sm text-red-600 dark:text-red-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" data-project-message-icon d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        <span data-project-message-text></span>
      </div>

      <button
        type="submit"
        data-project-submit
        class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white font-medium px-6 py-3 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
      >
        <span data-project-submit-icon aria-hidden="true">↓</span>
        <span data-project-submit-text>Generate</span>
      </button>
    </div>
  </form>
</div>

<script is:inline src="/js/project-generator-core.js" defer></script>
<script is:inline src="/js/project-generator-docs.js" defer></script>

<style>
  /* Reset margin-top for all elements within ProjectGenerator */
  [data-project-generator] * {
    margin-top: 0;
  }

  /* Add proper spacing between form fields */
  .field-spacing {
    margin-top: 1rem;
  }
</style>
