---
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead title="Fluxzero — We've got your backend" description="You write the logic. Fluxzero provides the backend runtime you never had time to build properly. Java or Kotlin. Cloud or self-hosted." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,200;1,300;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css?v=20260429-11">
    <link rel="stylesheet" href="/css/marketing-shell.css?v=20260505-1">
</head>
<body>
<MarketingHeader />

<!-- 1 · HERO -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-core">
      <div class="hero-bg-radial"></div>
      <div class="hero-bg-ellipse"></div>
      <div class="hero-bg-base"></div>
      <div class="hero-bg-fade">
        <div class="hero-bg-fade-left"></div>
        <div class="hero-bg-fade-right"></div>
      </div>
    </div>
  </div>
  <div class="hero-mobile-logo" aria-hidden="true">
      <span class="logo-mark hero-logo-mark"></span>
      <span class="hero-logo-wordmark">FLUXZERO</span>
  </div>
  <h1 class="rv d1" id="hero-title"><span class="em">We&rsquo;ve got your back<span class="hero-end">end.</span></span></h1>

    <p class="hero-sub rv d2">
        Build your product without ever hitting a wall. Start with a <span class="hero-no-break">production-ready</span> foundation for AI.
    </p>

    <div class="hero-ctas rv d3">
        <a href="#get-started" class="btn-p">Generate your app →</a>
        <a href="/contact" class="btn-s">Request launch access</a>
    </div>
    <div class="hero-signals rv d4" aria-label="Product highlights">
        <p class="hero-signal hero-signal-tools" aria-label="Build with Codex, Claude Code, Cursor, or Copilot">
            <span class="hero-live-dot" aria-hidden="true"></span>
            <span class="hero-signal-label">Build with</span>
            <span class="hero-tool-rotator" aria-hidden="true">
                <span>Codex</span>
                <span>Claude Code</span>
                <span>Cursor</span>
                <span>Copilot</span>
            </span>
        </p>
        <p class="hero-signal hero-signal-pay">
            <span class="hero-live-dot" aria-hidden="true"></span>
            <span>Only pay once you&rsquo;re live.</span>
        </p>
    </div>
</section>

<div class="sp"></div>

<section class="facts facts-carded rv section-stack" id="production-gap-content" aria-labelledby="production-gap-content-title">
    <div class="section-intro">
        <h2 class="facts-heading h2-two-line" id="production-gap-content-title">For anyone who wants to launch real software, not demos</h2>
        <p class="facts-sub"><span>With Fluxzero, what works on your device works in production.</span><br>No backend engineering before you go live.</p>
    </div>

    <div class="facts-g section-grid">
        <div class="fc">
            <div class="fc-head">
                <h4>Never get stuck at demo</h4>
            </div>
            <p>Just build your features and ship them. Launch knowing the backend is already taken care of. No setup or assembly.</p>
            <div class="fc-visual pg-demo-visual" aria-hidden="true">
                <svg viewBox="0 0 280 150">
                    <text class="pg-label" x="24" y="34">BUILT</text>
                    <text class="pg-label" x="102" y="112">WORKING</text>
                    <text class="pg-label" x="208" y="34">LAUNCHED</text>
                    <path class="pg-path" d="M34 74 C88 40 112 100 142 74 S202 42 236 74"/>
                    <path class="pg-path--active" d="M34 74 C88 40 112 100 142 74 S202 42 236 74"/>
                    <circle class="pg-node" cx="34" cy="74" r="9"/>
                    <circle class="pg-node" cx="142" cy="74" r="9"/>
                    <circle class="pg-node pg-node--live" cx="236" cy="74" r="13"/>
                    <path class="pg-check pg-check--small" d="m30 73 3 3 6-7"/>
                    <path class="pg-check pg-check--small" d="m138 73 3 3 6-7"/>
                    <path class="pg-check" d="m230 74 4 4 8-9"/>
                </svg>
            </div>
        </div>

        <div class="fc">
            <div class="fc-head">
                <h4>Never break what already works</h4>
            </div>
            <p>New prompts do not break what you already shipped.<br class="desktop-break"> Feature one hundred builds as fast as feature one.</p>
            <div class="fc-visual pg-traffic-visual" aria-hidden="true">
                <div class="pg-traffic-row" style="--traffic-width: 72%; --traffic-delay: 0s"></div>
                <div class="pg-traffic-row" style="--traffic-width: 54%; --traffic-delay: -1.1s"></div>
                <div class="pg-traffic-row" style="--traffic-width: 86%; --traffic-delay: -2.2s"></div>
                <div class="pg-traffic-row" style="--traffic-width: 64%; --traffic-delay: -0.5s"></div>
            </div>
        </div>

        <div class="fc">
            <div class="fc-head">
                <h4>Never leave security to chance</h4>
            </div>
            <p>Security and hardening are part of the architecture, not something AI has to invent.</p>
            <div class="fc-visual pg-ready-visual" aria-hidden="true">
                <div class="pg-ready-line"></div>
                <div class="pg-ready-block">Auth</div>
                <div class="pg-ready-block">Permissions</div>
                <div class="pg-ready-block">Isolation</div>
                <div class="pg-ready-block">Hardening</div>
            </div>
        </div>

        <div class="fc">
            <div class="fc-head">
                <h4>Never rebuild due to success</h4>
            </div>
            <p>No matter how ambitious your business gets, the foundation is already there. From MVP to enterprise without rewrites.</p>
            <div class="fc-visual pg-business-visual" aria-hidden="true">
                <svg viewBox="0 0 280 142">
                    <path class="pg-business-grid" d="M28 116 H244 M28 88 H244 M28 60 H244 M28 32 H244 M64 20 V116 M112 20 V116 M160 20 V116 M208 20 V116"/>
                    <path class="pg-business-arrow-glow" d="M32 108 L74 90 L104 98 L140 66 L172 76 L226 30"/>
                    <path class="pg-business-arrow" d="M32 108 L74 90 L104 98 L140 66 L172 76 L226 30"/>
                    <path class="pg-business-arrow-head" d="M244 14 L233 38 L219 21 Z"/>
                    <circle class="pg-business-spark" cx="74" cy="90" r="2.2"/>
                    <circle class="pg-business-spark" cx="140" cy="66" r="2.2"/>
                    <text class="pg-business-label" x="24" y="128">IDEA</text>
                    <text class="pg-business-label" x="114" y="128">USERS</text>
                    <text class="pg-business-label" x="202" y="128">BUSINESS</text>
                </svg>
            </div>
        </div>
    </div>
</section>

<!-- 3 · SPLIT -->
<section class="system-split rv section-stack" id="system-split" aria-labelledby="system-split-title">
    <div class="system-split__head">
        <h2 class="system-split__title" id="system-split-title">Build only what matters</h2>
        <p class="system-split__subtitle">The full potential of AI can only be unlocked if all technical concerns<br class="desktop-break"> move out of your product.</p>
    </div>

    <div class="system-split__map">
        <div class="system-split__panel system-split__panel--interactive" data-inside-panel>
            <div class="system-split__panel-inner">
                <div class="system-split__face system-split__face--front">
                    <p class="system-split__eyebrow">You build</p>
                    <h3 class="system-split__panel-title">The products people use</h3>
                    <ul class="system-split__list">
                        <li>The product experience</li>
                        <li>What users see and do</li>
                        <li>The features unique to your product</li>
                    </ul>
                    <button class="system-split__inside-btn" type="button" data-inside-toggle aria-expanded="false" aria-label="See domain apps inside">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4.3 4.2A5.2 5.2 0 0 1 12 3.9l.9.9V2.2h1.2v4.7H9.4V5.7h2.7l-.9-.9a4 4 0 0 0-5.9.3 4.1 4.1 0 0 0-.8 1.7l-1.2-.2c.2-.9.5-1.7 1-2.4Zm7.4 7.6A5.2 5.2 0 0 1 4 12.1l-.9-.9v2.6H1.9V9.1h4.7v1.2H3.9l.9.9a4 4 0 0 0 5.9-.3 4.1 4.1 0 0 0 .8-1.7l1.2.2c-.2.9-.5 1.7-1 2.4Z"/>
                        </svg>
                        <span>See inside</span>
                    </button>
                </div>

                <div class="system-split__face system-split__face--back" aria-hidden="true">
                    <p class="system-split__eyebrow">Inside your product</p>
                    <h3 class="system-split__panel-title">UIs and business logic</h3>
                    <div class="system-split__apps" aria-label="Examples of domain apps">
                        <span class="system-split__app--ui">
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.2 4.1h11.6v7.4H3.2V4.1Zm1.2 1.2v5h9.2v-5H4.4Zm3.7 7.3h1.8v1.2h2.4V15H5.7v-1.2h2.4v-1.2Z"/></svg>
                            <small>UI</small><strong>Web UI</strong>
                        </span>
                        <span class="system-split__app--ui">
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M6 2.7h6c.7 0 1.3.6 1.3 1.3v10c0 .7-.6 1.3-1.3 1.3H6c-.7 0-1.3-.6-1.3-1.3V4c0-.7.6-1.3 1.3-1.3Zm0 1.2V14h6V3.9H6Zm2.1 8.8h1.8v.9H8.1v-.9Z"/></svg>
                            <small>UI</small><strong>Mobile app</strong>
                        </span>
                        <span>
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.2 3.2h11.6v3.6H3.2V3.2Zm1.2 1.2v1.2h9.2V4.4H4.4Zm-1.2 3h11.6V11H3.2V7.4Zm1.2 1.2v1.2h9.2V8.6H4.4Zm-1.2 3h11.6v3.2H3.2v-3.2Zm1.2 1.2v.8h9.2v-.8H4.4Z"/></svg>
                            <small>Domain app</small><strong>Shipping</strong>
                        </span>
                        <span>
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.2 3.2h11.6v3.6H3.2V3.2Zm1.2 1.2v1.2h9.2V4.4H4.4Zm-1.2 3h11.6V11H3.2V7.4Zm1.2 1.2v1.2h9.2V8.6H4.4Zm-1.2 3h11.6v3.2H3.2v-3.2Zm1.2 1.2v.8h9.2v-.8H4.4Z"/></svg>
                            <small>Domain app</small><strong>Inventory</strong>
                        </span>
                        <span>
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.2 3.2h11.6v3.6H3.2V3.2Zm1.2 1.2v1.2h9.2V4.4H4.4Zm-1.2 3h11.6V11H3.2V7.4Zm1.2 1.2v1.2h9.2V8.6H4.4Zm-1.2 3h11.6v3.2H3.2v-3.2Zm1.2 1.2v.8h9.2v-.8H4.4Z"/></svg>
                            <small>Domain app</small><strong>Billing</strong>
                        </span>
                        <span>
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.2 3.2h11.6v3.6H3.2V3.2Zm1.2 1.2v1.2h9.2V4.4H4.4Zm-1.2 3h11.6V11H3.2V7.4Zm1.2 1.2v1.2h9.2V8.6H4.4Zm-1.2 3h11.6v3.2H3.2v-3.2Zm1.2 1.2v.8h9.2v-.8H4.4Z"/></svg>
                            <small>Domain app</small><strong>CRM</strong>
                        </span>
                    </div>
                    <button class="system-split__inside-btn" type="button" data-inside-toggle aria-expanded="false" aria-label="Back to interfaces">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4.3 4.2A5.2 5.2 0 0 1 12 3.9l.9.9V2.2h1.2v4.7H9.4V5.7h2.7l-.9-.9a4 4 0 0 0-5.9.3 4.1 4.1 0 0 0-.8 1.7l-1.2-.2c.2-.9.5-1.7 1-2.4Zm7.4 7.6A5.2 5.2 0 0 1 4 12.1l-.9-.9v2.6H1.9V9.1h4.7v1.2H3.9l.9.9a4 4 0 0 0 5.9-.3 4.1 4.1 0 0 0 .8-1.7l1.2.2c-.2.9-.5 1.7-1 2.4Z"/>
                        </svg>
                        <span>Back</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="system-split__runtime" aria-hidden="true">
            <div class="system-split__flows">
                <span class="system-split__flow" style="--y: 62px; --line-opacity: 0.52"></span>
                <span class="system-split__flow" style="--y: 92px; --line-opacity: 0.8"></span>
                <span class="system-split__flow" style="--y: 125px; --line-opacity: 0.62"></span>
                <span class="system-split__flow" style="--y: 158px; --line-opacity: 0.74"></span>
                <span class="system-split__flow" style="--y: 188px; --line-opacity: 0.48"></span>
                <span class="system-split__flow-dot" style="--y: 62px; --duration: 4.9s; --delay: -1.2s"></span>
                <span class="system-split__flow-dot system-split__flow-dot--reverse" style="--y: 92px; --duration: 3.9s; --delay: -3.4s"></span>
                <span class="system-split__flow-dot" style="--y: 125px; --duration: 4.5s; --delay: -4.8s"></span>
                <span class="system-split__flow-dot system-split__flow-dot--reverse" style="--y: 158px; --duration: 5.3s; --delay: -2.1s"></span>
                <span class="system-split__flow-dot" style="--y: 188px; --duration: 5.9s; --delay: -3s"></span>
            </div>
        </div>

        <div class="system-split__panel system-split__panel--right system-split__panel--interactive" data-inside-panel>
            <div class="system-split__panel-inner">
                <div class="system-split__face system-split__face--front">
                    <p class="system-split__eyebrow">Fluxzero provides</p>
                    <h3 class="system-split__panel-title">The foundation underneath</h3>
                    <ul class="system-split__list">
                        <li>Everything behind the product</li>
                        <li>The technical parts every product needs</li>
                        <li>What makes it reliable and production-grade</li>
                    </ul>
                    <button class="system-split__inside-btn" type="button" data-inside-toggle aria-expanded="false" aria-label="See what Fluxzero provides inside">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4.3 4.2A5.2 5.2 0 0 1 12 3.9l.9.9V2.2h1.2v4.7H9.4V5.7h2.7l-.9-.9a4 4 0 0 0-5.9.3 4.1 4.1 0 0 0-.8 1.7l-1.2-.2c.2-.9.5-1.7 1-2.4Zm7.4 7.6A5.2 5.2 0 0 1 4 12.1l-.9-.9v2.6H1.9V9.1h4.7v1.2H3.9l.9.9a4 4 0 0 0 5.9-.3 4.1 4.1 0 0 0 .8-1.7l1.2.2c-.2.9-.5 1.7-1 2.4Z"/>
                        </svg>
                        <span>See inside</span>
                    </button>
                </div>

                <div class="system-split__face system-split__face--back" aria-hidden="true">
                    <p class="system-split__eyebrow">Inside Fluxzero</p>
                    <h3 class="system-split__panel-title">The runtime behind your apps</h3>
                    <div class="system-split__apps system-split__apps--fluxzero" aria-label="Fluxzero runtime capabilities">
                        <span class="system-split__app--runtime">
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M9 2.4 14.7 5.7v6.6L9 15.6l-5.7-3.3V5.7L9 2.4Zm0 1.4L4.5 6.4v5.2L9 14.2l4.5-2.6V6.4L9 3.8Zm0 2.4 2.5 1.4v2.8L9 11.8l-2.5-1.4V7.6L9 6.2Z"/></svg>
                            <small>Core</small><strong>Fluxzero runtime</strong>
                        </span>
                        <span>
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2.8 5.2h12.4v7.6H2.8V5.2Zm1.2 1.2v5.2h10V6.4H4Zm2 1.4h6v1.2H6V7.8Zm0 2h4.2V11H6V9.8Z"/></svg>
                            <small>Web</small><strong>Web traffic</strong>
                        </span>
                        <span>
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M9 2.5 14 4.4v3.7c0 3.2-1.8 5.7-5 7.4-3.2-1.7-5-4.2-5-7.4V4.4L9 2.5Zm0 1.3-3.8 1.4v2.9c0 2.5 1.2 4.5 3.8 5.9 2.6-1.4 3.8-3.4 3.8-5.9V5.2L9 3.8Z"/></svg>
                            <small>Security</small><strong>Built-in protection</strong>
                        </span>
                        <span>
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M3.2 4.2h11.6v2.4H3.2V4.2Zm0 3.6h11.6v2.4H3.2V7.8Zm0 3.6h11.6v2.4H3.2v-2.4Z"/></svg>
                            <small>Messages</small><strong>Message history</strong>
                        </span>
                        <span>
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M9 3c3.2 0 5.8.9 5.8 2v8c0 1.1-2.6 2-5.8 2s-5.8-.9-5.8-2V5c0-1.1 2.6-2 5.8-2Zm0 1.2c-2.6 0-4.3.6-4.6.9.3.3 2 .9 4.6.9s4.3-.6 4.6-.9c-.3-.3-2-.9-4.6-.9Zm-4.6 3v1.6c.9.5 2.6.8 4.6.8s3.7-.3 4.6-.8V7.2c-1.1.6-2.8.9-4.6.9s-3.5-.3-4.6-.9Zm0 3.5V13c.3.3 2 .8 4.6.8s4.3-.5 4.6-.8v-2.3c-1.1.6-2.8.9-4.6.9s-3.5-.3-4.6-.9Z"/></svg>
                            <small>Data</small><strong>Data storage</strong>
                        </span>
                        <span>
                            <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M7.8 3.4a4.4 4.4 0 1 1 0 8.8 4.4 4.4 0 0 1 0-8.8Zm0 1.2a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4Zm3.1 6.9.9-.9 3 3-.9.9-3-3Z"/></svg>
                            <small>Query</small><strong>Search</strong>
                        </span>
                    </div>
                    <button class="system-split__inside-btn" type="button" data-inside-toggle aria-expanded="false" aria-label="Back to Fluxzero foundation">
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4.3 4.2A5.2 5.2 0 0 1 12 3.9l.9.9V2.2h1.2v4.7H9.4V5.7h2.7l-.9-.9a4 4 0 0 0-5.9.3 4.1 4.1 0 0 0-.8 1.7l-1.2-.2c.2-.9.5-1.7 1-2.4Zm7.4 7.6A5.2 5.2 0 0 1 4 12.1l-.9-.9v2.6H1.9V9.1h4.7v1.2H3.9l.9.9a4 4 0 0 0 5.9-.3 4.1 4.1 0 0 0 .8-1.7l1.2.2c-.2.9-.5 1.7-1 2.4Z"/>
                        </svg>
                        <span>Back</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

</section>

<section id="backend-any-product-content" aria-labelledby="backend-any-product-content-title" class="rv section-stack">
    <header class="rv">
        <h2 id="backend-any-product-content-title">The hard technical work already done</h2>
        <p>AI can now build sophisticated software and focus entirely on your product.<br class="desktop-break"> <span class="mobile-copy-break">Fluxzero provides the foundation that makes software trustworthy.</span></p>
    </header>

    <div>
        <article class="rv">
            <h3>Ready for real users</h3>
            <p>Your app starts with the checks, guardrails, and defaults it needs before real people and real data arrive.</p>
            <div class="backend-card-visual backend-grade-visual" aria-hidden="true">
                <div class="backend-launch-stage">
                    <div class="backend-launch-glow"></div>
                    <div class="backend-launch-stars">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <div class="backend-launch-pad"></div>
                    <div class="backend-launch-rocket">
                        <div class="backend-launch-body">
                            <div class="backend-launch-window"></div>
                        </div>
                        <div class="backend-launch-nozzle"></div>
                        <div class="backend-launch-fin backend-launch-fin--left"></div>
                        <div class="backend-launch-fin backend-launch-fin--right"></div>
                        <div class="backend-launch-flame"></div>
                        <div class="backend-launch-trail"></div>
                    </div>
                </div>
            </div>
        </article>

        <article class="rv">
            <h3>No backend assembly</h3>
            <p>No piecing together the technical concerns every real product needs before you can ship.</p>
            <div class="backend-card-visual backend-assembly-visual" aria-hidden="true">
                <div class="backend-assembly-stage">
                    <div class="backend-assembly-list">
                        <div class="backend-assembly-item" style="--item-delay: 0s">Sign in</div>
                        <div class="backend-assembly-item" style="--item-delay: -0.2s">User access</div>
                        <div class="backend-assembly-item" style="--item-delay: -0.4s">Data</div>
                        <div class="backend-assembly-item" style="--item-delay: -0.6s">Search</div>
                        <div class="backend-assembly-item" style="--item-delay: -0.8s">Tests</div>
                        <div class="backend-assembly-item" style="--item-delay: -1s">Deploy</div>
                        <div class="backend-assembly-item" style="--item-delay: -1.2s">Recovery</div>
                        <div class="backend-assembly-item" style="--item-delay: -1.4s">Visibility</div>
                    </div>
                </div>
            </div>
        </article>

        <article class="rv">
            <h3>Built by backenders</h3>
            <p>Built by people with deep experience building systems and ops tooling for software that cannot fail.</p>
            <div class="backend-card-visual backend-team-visual" aria-hidden="true">
                <div class="backend-team-stage">
                    <div class="backend-team-ring"></div>
                    <div class="backend-team-line"></div>
                    <div class="backend-team-line--vertical"></div>
                    <div class="backend-team-chip backend-team-chip--scale">Scale</div>
                    <div class="backend-team-chip backend-team-chip--ops">Ops</div>
                    <div class="backend-team-chip backend-team-chip--frameworks">Uptime</div>
                    <div class="backend-team-chip backend-team-chip--systems">Security</div>
                    <div class="backend-team-core">Production<br>foundation</div>
                </div>
            </div>
        </article>
    </div>
</section>

<div class="sp"></div>

<!-- 6 · FIRST USE -->
