{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flux-website",
	"account_id": "fbb4ae392a349c3a4c7b713ec57dbc29",
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2025-06-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"run_worker_first": [
			"/",
			"/index.html",
			"/how-it-works",
			"/how-it-works/",
			"/how-it-works/index.html",
			"/product-code",
			"/product-code/",
			"/product-code/index.html",
			"/technical-foundation",
			"/technical-foundation/",
			"/technical-foundation/index.html",
			"/monitoring",
			"/monitoring/",
			"/monitoring/index.html",
			"/monitoring/index.md",
			"/product-insight",
			"/product-insight/",
			"/product-insight/index.html",
			"/pricing",
			"/pricing/",
			"/pricing/index.html",
			"/about",
			"/about/",
			"/about/index.html",
			"/get-started",
			"/get-started/",
			"/get-started/index.html",
			"/contact",
			"/contact/",
			"/contact/index.html",
			"/docs/getting-started/introduction",
			"/docs/getting-started/introduction/",
			"/docs/getting-started/introduction/index.html",
			"/docs/getting-started/core-concepts",
			"/docs/getting-started/core-concepts/",
			"/docs/getting-started/core-concepts/index.html"
		]
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"preview": {
			"vars": {
				"FEEDBACK_PROVIDER": "github-issues",
				"GITHUB_REPO": "fluxzero-io/fluxzero-site"
			}
		},
		"production": {
			"vars": {
				"FEEDBACK_PROVIDER": "github-issues",
				"GITHUB_REPO": "fluxzero-io/fluxzero-site"
			},
			"routes": [
				{
					"pattern": "fluxzero.io",
					"custom_domain": true
				},
				{
					"pattern": "www.fluxzero.io",
					"custom_domain": true
				}
			]
		}
	}
}
