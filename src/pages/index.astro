---
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import { fluxzeroBrand } from '../config/brand.mjs';

const comparisonRows = [
    {
        label: 'Built for',
        values: [
            { status: 'Developer teams', kind: 'owned' },
            { status: 'Developer teams', kind: 'owned' },
            { status: 'Anyone building with AI', kind: 'included' },
        ],
    },
    {
        label: 'Inside your application',
        values: [
            { status: 'Product + schemas, policies & infrastructure adapters', kind: 'owned' },
            { status: 'Product + services, repositories & infrastructure architecture', kind: 'owned' },
            { status: 'Product behavior only', kind: 'included' },
        ],
    },
    {
        label: 'What the cloud handles',
        values: [
            { status: 'Postgres capabilities + frontend hosting', kind: 'owned' },
            { status: 'Deployments, networking & databases', kind: 'owned' },
            { status: 'The complete technical execution', kind: 'included' },
        ],
    },
    {
        label: 'Adding a feature',
        values: [
            { status: 'Product behavior + schemas, policies & integrations', kind: 'owned' },
            { status: 'Product behavior + services, repositories & deployment', kind: 'owned' },
            { status: 'Product behavior only', kind: 'included' },
        ],
    },
    {
        label: 'AI must understand',
        values: [
            { status: 'Product + SQL + policies + integrations', kind: 'owned' },
            { status: 'Product + services + operations', kind: 'owned' },
            { status: 'Product behavior only', kind: 'included' },
        ],
    },
    {
        label: 'Security, recovery & audit',
        values: [
            { status: 'Designed across database and application', kind: 'owned' },
            { status: 'Designed inside your application', kind: 'owned' },
            { status: 'Handled by the cloud', kind: 'included' },
        ],
    },
    {
        label: 'Scaling',
        values: [
            { status: 'Scale and tune each layer', kind: 'owned' },
            { status: 'Configure each service', kind: 'owned' },
            { status: 'Automatic across the application', kind: 'included' },
        ],
    },
    {
        label: 'Engineering team',
        values: [
            { status: 'Needed as complexity grows', kind: 'owned' },
            { status: 'Required for serious applications', kind: 'owned' },
            { status: 'Not required', kind: 'included' },
        ],
    },
    {
        label: 'Platform improvements',
        values: [
            { status: 'You adopt and integrate the changes', kind: 'owned' },
            { status: 'You upgrade your architecture', kind: 'owned' },
            { status: 'Every application inherits it', kind: 'included' },
        ],
    },
    {
        label: 'Path to full scale',
        values: [
            { status: 'May require re-architecture or replatforming', kind: 'owned' },
            { status: 'May require re-architecture or replatforming', kind: 'owned' },
            { status: 'The same model at every scale', kind: 'included' },
        ],
    },
    {
        label: 'Home jurisdiction',
        values: [
            { status: 'Singapore + United States', kind: 'owned' },
            { status: 'United States', kind: 'owned' },
            { status: 'European Union', kind: 'included' },
        ],
    },
];

const comparisonOptions = [
    {
        name: 'Supabase + Vercel',
        sub: 'Postgres platform + frontend cloud',
        body: 'A powerful Postgres development platform paired with a frontend cloud. Your application continues to own database design, access policies, and how both sides evolve together.',
        index: 0,
    },
    {
        name: 'Railway',
        sub: 'Application infrastructure',
        body: 'A flexible deployment platform for services and databases. Your application continues to own how those services become one secure, resilient production system.',
        index: 1,
    },
    {
        name: 'Fluxzero',
        sub: 'The complete application cloud',
        body: 'Product behavior is the application. Fluxzero owns storage, communication, security, recovery, observability, and scale underneath.',
        index: 2,
        featured: true,
    },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead title="Fluxzero — The European cloud for AI-built apps" description="Fluxzero is the European application cloud for people and AI agents building, running, and scaling real software." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,200;1,300;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css?v=20260625-2">
    <link rel="stylesheet" href="/css/v4-home.css?v=20260902-2">
    <link rel="stylesheet" href="/css/marketing-shell.css?v=20260625-logo-2">
</head>
<body class="v4-home">
<MarketingHeader />

<!-- 1 · HERO -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-core">
      <div class="hero-bg-radial"></div>
      <div class="hero-bg-ellipse"></div>
      <div class="hero-bg-base"></div>
      <div class="hero-bg-fade">
        <div class="hero-bg-fade-left"></div>
        <div class="hero-bg-fade-right"></div>
      </div>
    </div>
  </div>
  <div class="hero-mobile-logo" aria-hidden="true">
      <img class="hero-logo-lockup" src={fluxzeroBrand.logo} width="181" height="40" alt="">
  </div>
  <h1 class="rv d1" id="hero-title"><span class="hero-title-main">The European cloud</span><br><span class="em">for AI-built apps</span></h1>

    <p class="hero-sub rv d2">
        A complete application cloud with frontend, backend, data, security, deployment, and observability built in—and operated as one.
    </p>

    <div class="hero-ctas rv d3">
        <a href="/start-building" class="btn-p">Get started →</a>
        <a href="#production-gap-content" class="btn-s">See how it works <span class="hero-cta-arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="hero-signals rv d4" aria-label="European operation">
        <p class="hero-signal hero-signal--eu">
            <span class="hero-eu-stars" aria-hidden="true">
                {Array.from({ length: 12 }, (_, index) => <span style={`--star:${index}`}>★</span>)}
            </span>
            <span>100% EU-operated · Built on ISO 27001-certified and SOC 2 Type 2-audited infrastructure.</span>
        </p>
    </div>
</section>

<div class="sp"></div>

<section class="facts facts-carded rv section-stack" id="production-gap-content" aria-labelledby="production-gap-content-title">
    <div class="section-intro">
        <h2 class="facts-heading h2-two-line" id="production-gap-content-title">The cloud for anyone</h2>
        <p class="facts-sub"><span>Other clouds leave developers to integrate infrastructure.</span><br>Fluxzero keeps it out of your application—so anyone can build and ship serious products with AI.</p>
    </div>

    <div class="facts-g section-grid">
        <div class="fc">
            <div class="fc-head">
                <h4>Ship without an engineering team</h4>
            </div>
            <p>AI gives you a software team. Fluxzero gives your product a world-class platform.</p>
            <div class="fc-visual pg-demo-visual" aria-hidden="true">
                <svg viewBox="0 0 280 150">
                    <text class="pg-label" x="24" y="34">BUILT</text>
                    <text class="pg-label" x="102" y="112">WORKING</text>
                    <text class="pg-label" x="208" y="34">LAUNCHED</text>
                    <path class="pg-path" d="M34 74 C88 40 112 100 142 74 S202 42 236 74"/>
                    <path class="pg-path--active" d="M34 74 C88 40 112 100 142 74 S202 42 236 74"/>
                    <circle class="pg-node" cx="34" cy="74" r="9"/>
                    <circle class="pg-node" cx="142" cy="74" r="9"/>
                    <circle class="pg-node pg-node--live" cx="236" cy="74" r="13"/>
                    <path class="pg-check pg-check--small" d="m30 73 3 3 6-7"/>
                    <path class="pg-check pg-check--small" d="m138 73 3 3 6-7"/>
                    <path class="pg-check" d="m230 74 4 4 8-9"/>
                </svg>
            </div>
        </div>

        <div class="fc">
            <div class="fc-head">
                <h4>A feature stays a feature</h4>
            </div>
            <p>Every new feature is product behavior—not more infrastructure for AI to build and maintain.</p>
            <div class="fc-visual v4-feature-visual" aria-hidden="true">
                <div class="v4-feature-stage">
                    <div class="v4-feature-app">
                        <b>YOUR APPLICATION</b>
                        <div><span>USERS</span><span>ORDERS</span><span>PAYMENTS</span><span>WORKFLOWS</span></div>
                    </div>
                    <div class="v4-feature-connectors"><i></i><i></i><i></i><i></i></div>
                    <div class="v4-feature-cloud">
                        <b>FLUXZERO CLOUD</b>
                        <div><span>DATA</span><span>MESSAGING</span><span>SECURITY</span><span>RECOVERY</span><span>SCALE</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fc">
            <div class="fc-head">
                <h4>Secure and resilient by design</h4>
            </div>
            <p>Validation, authorization, isolation, retries, and recovery are built in from the start—not bolted on later.</p>
            <div class="fc-visual pg-traffic-visual" aria-hidden="true">
                <div class="pg-traffic-row" style="--traffic-width: 72%; --traffic-delay: 0s"></div>
                <div class="pg-traffic-row" style="--traffic-width: 54%; --traffic-delay: -1.1s"></div>
                <div class="pg-traffic-row" style="--traffic-width: 86%; --traffic-delay: -2.2s"></div>
                <div class="pg-traffic-row" style="--traffic-width: 64%; --traffic-delay: -0.5s"></div>
            </div>
        </div>

        <div class="fc">
            <div class="fc-head">
                <h4>Scale without replatforming</h4>
            </div>
            <p>The same application model works locally and at full scale, so growth does not force a new architecture.</p>
            <div class="fc-visual pg-business-visual" aria-hidden="true">
                <svg viewBox="0 0 280 142">
                    <path class="pg-business-grid" d="M28 116 H244 M28 88 H244 M28 60 H244 M28 32 H244 M64 20 V116 M112 20 V116 M160 20 V116 M208 20 V116"/>
                    <path class="pg-business-arrow-glow" d="M32 108 L74 90 L104 98 L140 66 L172 76 L226 30"/>
                    <path class="pg-business-arrow" d="M32 108 L74 90 L104 98 L140 66 L172 76 L226 30"/>
                    <path class="pg-business-arrow-head" d="M244 14 L233 38 L219 21 Z"/>
                    <circle class="pg-business-spark" cx="74" cy="90" r="2.2"/>
                    <circle class="pg-business-spark" cx="140" cy="66" r="2.2"/>
                    <text class="pg-business-label" x="24" y="128">IDEA</text>
                    <text class="pg-business-label" x="114" y="128">USERS</text>
                    <text class="pg-business-label" x="202" y="128">BUSINESS</text>
                </svg>
            </div>
        </div>
    </div>
</section>


<section class="comparison comparison-v4 rv section-stack" id="platform-comparison" aria-labelledby="comparison-title">
    <div class="section-intro comparison-v4__heading">
        <h2 class="h2-two-line" id="comparison-title">Other clouds run infrastructure.<br><span>Fluxzero runs your application.</span></h2>
        <p>Other clouds provide managed infrastructure components that your application must integrate into a correct production system. Fluxzero handles that technical execution, so every new feature adds product value without adding infrastructure to maintain.</p>
    </div>

    <div class="comparison-desktop section-grid">
        <div class="comparison-head">
            <div class="comparison-head__corner" aria-hidden="true"></div>
            {comparisonOptions.map((option) => (
                <div class:list={['comparison-head__option', { 'is-featured': option.featured }]}>
                    <h3>{option.name}</h3>
                    <p>{option.sub}</p>
                </div>
            ))}
        </div>
        <div class="comparison-table" role="table" aria-label="Comparison of application cloud approaches">
            {comparisonRows.map((row) => (
                <div class="comparison-table__row" role="row">
                    <div class="comparison-table__label" role="rowheader">{row.label}</div>
                    {comparisonOptions.map((option) => {
                        const value = row.values[option.index];
                        return (
                            <div class:list={['comparison-table__cell', { 'is-featured': option.featured }]} role="cell">
                                <span class:list={['comparison-table__mark', `is-${value.kind}`]} aria-hidden="true">
                                    {value.kind === 'included' ? '✓' : '—'}
                                </span>
                                <strong>{value.status}</strong>
                            </div>
                        );
                    })}
                </div>
            ))}
        </div>
    </div>

    <div class="comparison-mobile section-grid">
        {comparisonOptions.map((option) => (
            <details class:list={['comparison-disclosure', { 'is-featured': option.featured }]} open={option.featured}>
                <summary>
                    <span>
                        <strong>{option.name}</strong>
                        <small>{option.sub}</small>
                    </span>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5"/></svg>
                </summary>
                <div class="comparison-disclosure__body">
                    <p>{option.body}</p>
                    <dl>
                        {comparisonRows.map((row) => (
                            <>
                                <dt>{row.label}</dt>
                                <dd>
                                    <span class:list={['comparison-table__mark', `is-${row.values[option.index].kind}`]} aria-hidden="true">
                                        {row.values[option.index].kind === 'included' ? '✓' : '—'}
                                    </span>
                                    <strong>{row.values[option.index].status}</strong>
                                </dd>
                            </>
                        ))}
                    </dl>
                </div>
            </details>
        ))}
    </div>

    <div class="comparison-v4__actions">
        <a class="btn-s" href="/agents">Explore the technical differences →</a>
    </div>
</section>

<div class="sp"></div>

<!-- 4 · AI -->
<section class="ai rv section-stack" id="ai-works-better" aria-labelledby="ai-works-better-title">
    <div class="section-intro">
        <p class="ai-eyebrow">No technical noise</p>
        <h2 class="h2-two-line" id="ai-works-better-title"><span class="ai-line-1">AI works better</span><span class="ai-line-2">when there&rsquo;s less to think about</span></h2>

        <p class="ai-body">
            When AI does not have to integrate cloud infrastructure, it can stay focused on the product behavior you actually care about.
        </p>
    </div>

    <div class="ai-points section-grid">
        <div class="ai-pt">
            <h4>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 7.5h14M5 12h10M5 16.5h7" stroke-width="1.7" stroke-linecap="round"/>
                    <path d="m16 16.5 2 2 4-5" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Spend fewer tokens
            </h4>
            <p>Spend your prompt budget on product behavior, decisions, and user experience.</p>
        </div>
        <div class="ai-pt">
            <h4>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3.7 18.2 6v5.2c0 4.1-2.5 7.6-6.2 9.1-3.7-1.5-6.2-5-6.2-9.1V6L12 3.7Z" stroke-width="1.7" stroke-linejoin="round"/>
                    <path d="m9.2 12.1 1.9 1.9 3.9-4.3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Less risk
            </h4>
            <p>Infrastructure correctness no longer depends on what AI happens to generate.</p>
        </div>
        <div class="ai-pt">
            <h4>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m8 9-3 3 3 3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="m16 9 3 3-3 3" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="m10.5 16.5 3-9" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
                100% product context
            </h4>
            <p>Your agent reasons about users, rules, and workflows instead of infrastructure architecture.</p>
        </div>
    </div>
</section>

<div class="sp"></div>


<!-- 8 · PROOF -->
<section class="proof rv section-stack" id="proven-foundation" aria-labelledby="proven-foundation-title">
    <div class="proof-label">Built to scale</div>
    <div class="section-intro">
        <h2 class="h2-single" id="proven-foundation-title">Start small.<br>Scale without starting over.</h2>
        <div class="proof-body">
            <p>The same application model already powers mission-critical systems<br class="desktop-break"> with high throughput and complex business logic.</p>
        </div>
    </div>

    <div class="proof-logos" aria-label="Teams building with Fluxzero">
        <a class="proof-logo" href="https://www.portbase.com/en/" target="_blank" rel="noreferrer"><img src="/assets/fluxzero/portbase-dark.svg" alt="Portbase"></a>
        <a class="proof-logo" href="https://zoef.app/en/passenger" target="_blank" rel="noreferrer"><img src="/assets/fluxzero/zoef-dark.svg" alt="Zoef"></a>
        <a class="proof-logo" href="https://openvoy.com" target="_blank" rel="noreferrer"><img src="/assets/fluxzero/openvoy-dark.svg" alt="OpenVoy"></a>
        <a class="proof-logo" href="https://flowmaps.com" target="_blank" rel="noreferrer"><img src="/assets/fluxzero/flowmaps-dark.svg" alt="Flowmaps"></a>
        <a class="proof-logo" href="https://moxi.health/en/" target="_blank" rel="noreferrer"><img src="/assets/fluxzero/moxi-dark.svg" alt="Moxi"></a>
    </div>

    <div class="proof-stats section-grid" data-proof-stats>
        <div class="proof-stat">
            <div class="num"><span class="proof-count" data-count-to="100">100</span><span>+</span></div>
            <div class="label">GB / min throughput</div>
        </div>
        <div class="proof-stat">
            <div class="num"><span class="proof-count" data-count-to="1">1</span><span>M+</span></div>
            <div class="label">committed events / sec</div>
        </div>
        <div class="proof-stat">
            <div class="num"><span class="proof-count" data-count-to="99.9" data-decimals="1">99.9</span><span>%</span></div>
            <div class="label">Uptime</div>
        </div>
    </div>

</section>

<div class="sp"></div>

<!-- 6b · CLOUD -->
<section class="cloud-section rv section-stack" id="cloud-section-content" aria-labelledby="cloud-section-content-title">
    <div class="section-intro">
        <h2 class="h2-single" id="cloud-section-content-title">Hosted in Europe.<br>Managed end to end.</h2>
        <p class="cloud-sub">Run the complete application on audited European infrastructure, without operating servers or stitching services together.</p>
    </div>

    <div class="cloud-grid section-grid">
        <div class="cloud-card">
            <h4><span class="cloud-icon" aria-hidden="true">&uarr;</span>A cloud that keeps improving</h4>
            <p>New capabilities and runtime improvements reach your application without migrations or rewrites.</p>
        </div>
        <div class="cloud-card">
            <h4><span class="cloud-icon" aria-hidden="true">&check;</span>On audited infrastructure</h4>
            <p>ISO 27001 and SOC 2 Type 2 certified.</p>
        </div>
        <div class="cloud-card">
            <h4><span class="cloud-icon cloud-icon--europe" aria-hidden="true">EU</span>European foundation</h4>
            <p>Built and operated from Europe, with strong standards for data handling and privacy.</p>
        </div>
    </div>

</section>

<div class="sp"></div>


<!-- 9 · FAQ -->
<section class="faq rv section-stack" id="faq" aria-labelledby="faq-title">
    <div class="section-intro">
        <h2 class="faq-heading h2-single" id="faq-title">Frequently asked questions</h2>
    </div>

    <div class="faq-list section-grid">
        <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">
                <span>Is my product code still mine?</span>
                <span class="faq-arrow">+</span>
            </button>
            <div class="faq-a">
                <p>Yes. You own the product you build: the features, flows, user experience, and product logic. Fluxzero provides the backend foundation and runtime underneath it.</p>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">
                <span>Can I export my data?</span>
                <span class="faq-arrow">+</span>
            </button>
            <div class="faq-a">
                <p>Yes. Your product data should never feel trapped. Fluxzero is built around clear product data and will support exporting it when you need to move, analyze, or back it up.</p>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">
                <span>How is Fluxzero different from Supabase + Vercel or Railway?</span>
                <span class="faq-arrow">+</span>
            </button>
            <div class="faq-a">
                <p>Supabase + Vercel and Railway are strong platforms for developer teams that want to compose or operate their own services. Fluxzero takes responsibility for the application foundation too, so your agent can focus on product behavior instead of assembling the architecture underneath.</p>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">
                <span>How is Fluxzero different from Lovable, Bolt, or Replit?</span>
                <span class="faq-arrow">+</span>
            </button>
            <div class="faq-a">
                <p>Those tools help you build or generate an app. You can use that output as the starting point for a Fluxzero app, so you do not have to start over.</p>
                <p>Fluxzero adds the backend foundation that lets the app become real software: something you can run, test, launch, and keep improving with users.</p>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">
                <span>What kinds of products is Fluxzero good for?</span>
                <span class="faq-arrow">+</span>
            </button>
            <div class="faq-a">
                <p>Fluxzero is a good fit for products with users, data, permissions, workflows, and business logic: SaaS apps, marketplaces, portals, internal tools, workflow products, and AI-enabled software.</p>
                <p>There is no scale ceiling on what you can build or run. Fluxzero is designed for products that may start small and grow into sophisticated, high-volume systems.</p>
                <p>It is not meant for simple landing pages, content-only sites, throwaway demos, or products where you specifically want to design every layer of infrastructure yourself.</p>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">
                <span>Do I need to know backend development?</span>
                <span class="faq-arrow">+</span>
            </button>
            <div class="faq-a">
                <p>No. You need to understand the product you want to build. Your coding agent can work on features, flows, and behavior while Fluxzero keeps the backend foundation out of your prompt loop.</p>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">
                <span>Can developers take it further later?</span>
                <span class="faq-arrow">+</span>
            </button>
            <div class="faq-a">
                <p>Yes. Fluxzero gives your team a clean Java codebase focused on features, flows, and behavior, with behavior tests around the things that matter. Real developers can keep building in their own IDE, review the code, add more tests, and go deeper into the technical model when needed.</p>
                <p>That makes it easy to hand over when the product grows. Java talent is widely available, and because backend complexity stays out of the product layer, founders can keep building with AI alongside the team.</p>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">
                <span>Can I use Codex, Claude Code, Cursor, or my own IDE?</span>
                <span class="faq-arrow">+</span>
            </button>
            <div class="faq-a">
                <p>Yes. Start with your product idea, review the project brief, and open the build in Codex, Claude Code, Cursor, or your IDE. Fluxzero is designed to fit the way builders are already using AI to ship software.</p>
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">
                <span>When do I pay?</span>
                <span class="faq-arrow">+</span>
            </button>
            <div class="faq-a">
                <p>You can get started before paying. You only pay when you go live.</p>
            </div>
        </div>
    </div>

    <p class="faq-help">Still wondering? <a href="/contact">Get in touch</a> and we'll help.</p>
