---
import '../../public/css/v4.css';
import '../../public/css/marketing-shell.css';
import '../../public/css/about.css';
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';

---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead title="About Fluxzero — A foundation for every builder" description="Great ideas deserve to become real products. A European team putting a reliable software foundation within every builder’s reach." />
</head>
<body class="v4-page about-page">
<MarketingHeader active="about" />
<main class="about-main">
    <section class="about-mission" aria-labelledby="mission-title">
        <p class="about-eyebrow">Why we build Fluxzero</p>
        <h1 id="mission-title">Great ideas deserve<br>to become <span>real products.</span></h1>
        <p class="about-lead">AI is opening software creation to more people.<br>We believe the foundation underneath should be ready for them.</p>
        <div class="about-copy">
            <p>We built Fluxzero so anyone can turn an idea into a reliable product, without first becoming an expert in backend architecture and cloud infrastructure.</p>
            <p>We’re a European team with years of experience building and running enterprise software. Our mission is to put that foundation within every builder’s reach.</p>
        </div>
    </section>
    <div class="about-actions">
        <a class="v4-button v4-button--secondary" href="/contact/">Talk to us <span aria-hidden="true">→</span></a>
    </div>
</main>
<MarketingFooter />

<script>
    async function initSystemStatus() {
        const link = document.querySelector('[data-status-link]');
        const dot = document.querySelector('[data-status-dot]');
        if (!link || !dot || typeof fetch !== 'function') return;

        try {
            const response = await fetch('https://fluxzero.statuspage.io/api/v2/status.json', { cache: 'no-store' });
            if (!response.ok) return;

            const payload = await response.json();
            const status = payload && payload.status ? payload.status : {};
            const indicator = ['none', 'minor', 'major', 'critical', 'maintenance'].includes(status.indicator)
                ? status.indicator
                : 'none';
            const description = status.description || 'System status';

            dot.dataset.status = indicator;
            link.setAttribute('aria-label', 'System status: ' + description);
            link.title = description;
        } catch (error) {
            /* Keep the default healthy dot if the status API is unavailable. */
        }
    }

    initSystemStatus();
</script>
</body>
</html>
