{
  "name": "fluxzero-website",
  "description": "Public marketing website and technical documentation for Fluxzero",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro sync && pnpm sync:docs && astro dev",
    "start": "pnpm dev",
    "build": "astro sync && pnpm sync:docs && astro build && node scripts/generate-llms.mjs && node scripts/sitemap-dates.mjs && node scripts/check-discovery.mjs",
    "preview": "wrangler dev --env preview",
    "astro": "astro",
    "sync:docs": "node scripts/sync-sdk-docs.mjs",
    "test:changelog": "node --import tsx --test src/loaders/*releases.test.ts",
    "test:llms": "node --test scripts/generate-llms.test.mjs",
    "test:product-code": "node tests/product-code/generate.mjs && mvn -B -f tests/product-code/pom.xml test",
    "test:discovery": "node --test scripts/check-discovery.test.mjs scripts/markdown-negotiation.test.mjs",
    "check:discovery": "node scripts/check-discovery.mjs",
    "test:seo": "node --test src/utils/docs-description.test.mjs"
  },
  "config": {
    "javadoc.optional": false,
    "ghreleases.optional": false
  },
  "dependencies": {
    "@astro-community/astro-embed-youtube": "^0.5.6",
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.9",
    "@astrojs/starlight": "^0.34.3",
    "@types/node": "^22.15.29",
    "alpinejs": "^3.15.0",
    "astro": "^5.8.2",
    "astro-mermaid": "^1.0.4",
    "bootstrap": "^5.3.5",
    "boxicons": "^2.1.4",
    "cleave.js": "^1.6.0",
    "dompurify": "^3.2.7",
    "imagesloaded": "^5.0.0",
    "jarallax": "^2.2.1",
    "lightgallery": "2.9.0-beta.1",
    "marked": "^16.3.0",
    "mermaid": "^11.9.0",
    "nouislider": "^15.8.1",
    "parallax-js": "^3.1.0",
    "rellax": "^1.12.1",
    "semver": "^7.8.5",
    "sharp": "^0.34.2",
    "shufflejs": "^6.1.2",
    "smooth-scroll": "^16.1.3",
    "starlight-links-validator": "^0.18.0",
    "swiper": "^11.2.6",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/starlight-tailwind": "^4.0.1",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/alpinejs": "^3.13.11",
    "@types/semver": "^7.8.0",
    "parse5": "^7.3.0",
    "sass": "^1.80.3",
    "sass-embedded": "^1.92.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.3",
    "wrangler": "4.40.3"
  }
}
