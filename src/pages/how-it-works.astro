---
import { Image } from 'astro:assets';
import heroBackdrop from '../../public/assets/fluxzero/agent-hero-horizon.png';
import '../../public/css/v4.css';
import '../../public/css/agents.css';
import '../../public/css/technical-foundation.css';
import '../../public/css/technical-foundation-next.css';
import '../../public/css/marketing-shell.css';
import '../../public/css/monitoring.css';
import '../../public/css/how-it-works.css';
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import FoundationSections from '../components/marketing/FoundationSections.astro';
import ProductInsightCarousel from '../components/monitoring/ProductInsightCarousel.astro';
import 'boxicons/css/boxicons.min.css';

---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead
        title="How it works — Fluxzero"
        description="See how Fluxzero runs your product with correctness, security, privacy, recovery, scale, and deep insight built in from day zero."
    />
</head>
<body class="v4-page agent4-page cloud-proof-page cloud-proof-next-page how-it-works-page">
    <MarketingHeader active="how-it-works" />
    <main>
    <section class="agent4-hero" aria-labelledby="agent4-title">
        <Image class="agent4-hero__backdrop" src={heroBackdrop} widths={[640, 1280, 1920]} sizes="100vw" format="webp" quality={85} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
        <div class="v4-shell agent4-hero__inner">
            <div class="agent4-hero__copy">
                <h1 id="agent4-title" data-reveal>AI lets anyone build products.<br><span>Time for the cloud to catch up.</span></h1>
                <p data-reveal data-reveal-delay="1">Enterprises expect critical systems to keep their promises under pressure. That standard matters long before a product reaches enterprise size. With Fluxzero, it is built into every product from day zero.</p>
                <div class="v4-actions agent4-hero__actions" data-reveal data-reveal-delay="2">
                    <a class="v4-button v4-button--primary" href="/get-started/">Get started <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                    <a class="v4-button v4-button--secondary" href="/docs/">Read the technical docs</a>
                </div>
            </div>
        </div>
    </section>

    <FoundationSections>
        <ProductInsightCarousel slot="auditability" />
    </FoundationSections>

    <section class="cloud-proof-next-conclusion" aria-labelledby="monitoring-conclusion-title">
        <div class="v4-shell cloud-proof-shell">
            <p class="cloud-proof-next__eyebrow">Built into every product</p>
            <h2 id="monitoring-conclusion-title">Less to manage.<br /><span>More to see.</span></h2>
            <div class="cloud-proof-next__actions">
                <a class="v4-button v4-button--primary" href="/get-started/">Start building <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                <a class="v4-button v4-button--secondary" href="/product-code/">Explore the product code <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
            </div>
        </div>
    </section>
    </main>
    <MarketingFooter />
    <script src="/js/v4.js?v=20260904-3" defer></script>
</body>
</html>
