            background: linear-gradient(135deg, #D9F5FF 0%, #48A7F6 100%);
            box-shadow: 0 14px 30px rgba(32, 134, 240, 0.16);
        }

        .pricing-v2-flip-card {
            padding: 0;
            perspective: 1600px;
            overflow: visible;
            background: transparent;
            border: 0;
            box-shadow: none;
