---
import LegacyPricing from '../components/marketing/LegacyPricing.astro';
import CapacityPricing from '../components/marketing/CapacityPricing.astro';
import {loadPricingCatalog} from '../utils/capacity-pricing.mjs';
const capacity = import.meta.env.PRICING_MODEL === 'capacity';
const catalog = capacity ? await loadPricingCatalog(import.meta.env.PRICING_CATALOG_URL) : null;
---
{capacity ? <CapacityPricing catalog={catalog} /> : <LegacyPricing />}
