---
import '../../public/css/home.css';
import '../../public/css/v4-home.css';
import '../../public/css/marketing-shell.css';
import '../../public/css/agent-cloud-home.css';
import AgentInstruction from '../components/marketing/AgentInstruction.astro';
import AgentReflections from '../components/marketing/AgentReflections.astro';
import CloudChoice from '../components/marketing/CloudChoice.astro';
import CustomerShowcase from '../components/marketing/CustomerShowcase.astro';
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import { fluxzeroBrand } from '../config/brand.mjs';

const comparisonRows = [
    {
        label: "Agent builds",
        values: [
            { status: "Product behavior + technical stack", kind: 'owned' },
            { status: "Product behavior", kind: 'included' },
        ],
    },
    {
        label: "Team required as you grow",
        values: [
            { status: "Backend/platform expertise", kind: 'owned' },
            { status: "No backend team required", kind: 'included' },
        ],
    },
    {
        label: "Adding a feature",
        values: [
            { status: "Changes across the entire stack", kind: 'owned' },
            { status: "Just add the feature", kind: 'included' },
        ],
    },
    {
        label: "Audit trail",
        values: [
            { status: "Build it yourself", kind: 'owned' },
            { status: "Built into the cloud", kind: 'included' },
        ],
    },
    {
        label: "Failure/recovery",
        values: [
            { status: "Your agent's responsibility", kind: 'owned' },
            { status: "Cloud responsibility", kind: 'included' },
        ],
    },
    {
        label: "When something breaks",
        values: [
            { status: "Piece together logs and state", kind: 'owned' },
            { status: "See exactly what happened", kind: 'included' },
        ],
    },
    {
        label: "Maintaining the foundation",
        values: [
            { status: "Ongoing work for your agent", kind: 'owned' },
            { status: "Maintained and improved by Fluxzero", kind: 'included' },
        ],
    },
    {
        label: "Path to scale",
        values: [
            { status: "Refactor or start over", kind: 'owned' },
            { status: "No rebuild needed", kind: 'included' },
        ],
    },
];

const comparisonOptions = [
    { name: 'Other clouds', sub: 'Supabase, Vercel, Railway, Lovable & others', index: 0 },
    { name: 'Fluxzero', sub: 'The product cloud', index: 1, featured: true },
];

const homepageFaqs = [
    {
        id: 'faq-what-is-fluxzero',
        question: 'What is Fluxzero?',
        llmsSummary: true,
        answer: [
            'Fluxzero is a cloud designed to work especially well with coding agents. It handles the data, security, reliability, and scale, so you and your agent can focus on what your product should do.',
            'Once your product is live, you and your agent can see what happens, investigate problems, and keep improving it.',
        ],
    },
    {
        id: 'faq-generated-backend',
        question: 'My agent can generate a backend. Why should it use Fluxzero?',
        answer: [
            'Other clouds give your agent infrastructure and services to turn into a reliable product. The backend it builds is still yours to secure, maintain, and scale. Fluxzero takes care of that foundation, so your agent can focus on product features.',
            'Coding agents work better when they have less to think about. With the technical foundation taken care of, your agent can focus its attention and context on your product’s features, rules, and user experience.',
        ],
    },
    {
        id: 'faq-building',
        question: 'What does building with Fluxzero look like?',
        answer: [],
        steps: [
            'Describe your product. Copy the getting-started instruction into your coding agent and tell it what you want to build.',
            'Try it locally. Run the app on your computer, check how it behaves, and refine it with your agent.',
            'Publish it. When you are ready, deploy your product to Fluxzero.',
        ],
        links: [
            { href: '/docs/getting-started/introduction/', label: 'Learn more in the docs' },
            { href: 'https://dashboard.fluxzero.io/', label: 'Ready to deploy?' },
        ],
    },
    {
        id: 'faq-coding-experience',
        question: 'Do I need coding experience?',
        answer: [
            'No. You describe what your product should do, and your coding agent writes the code. You try the result and refine it together.',
            'Developers can also review, change, and extend the same application code alongside your agent.',
        ],
    },
    {
        id: 'faq-coding-agents',
        question: 'Which coding agents can I use?',
        answer: [
            'You can use Claude Code, Codex, Cursor, Gemini CLI, or GitHub Copilot. Copy the getting-started instruction into your agent to give it the Fluxzero guidance and tools it needs to build your product.',
        ],
        link: { href: '/#get-started', label: 'Get the instruction for your agent' },
    },
    {
        id: 'faq-products',
        question: 'What kinds of products can I build?',
        answer: [
            'Fluxzero suits a wide range of applications: SaaS products, marketplaces, portals, internal tools, consumer apps, and AI-enabled software.',
            'Infrastructure products that depend on running a specific underlying component, such as a database service built around a particular database engine, are not a good fit.',
        ],
    },
    {
        id: 'faq-existing-product',
        question: 'Can I bring an existing product?',
        answer: [
            'Yes. Your existing product gives your agent a starting point: its features, design, and business rules. Your agent can adapt the backend to use Fluxzero and help migrate your data. How much needs to change depends on how your product is built today.',
        ],
        link: { href: '/contact/', label: 'Tell us about your product' },
    },
    {
        id: 'faq-companies',
        question: 'What kinds of companies run on Fluxzero?',
        answer: [
            'Fluxzero is used in production by single-founder companies, scale-ups, and enterprises with complex business logic and mission-critical workloads.',
        ],
        link: { href: '/how-it-works/', label: 'See how Fluxzero keeps your product running' },
    },
    {
        id: 'faq-growth',
        question: 'Will I outgrow Fluxzero or need to rebuild later?',
        answer: [
            'No. The same application works locally and at production scale. Individual workloads can receive more capacity as your product grows, without forcing the whole product onto a new architecture.',
        ],
    },
    {
        id: 'faq-product-insight',
        question: 'How do I keep track of my product once it’s live?',
        answer: [
            'You and your agent can follow what happens in your product, investigate errors, and spot performance issues. A searchable history lets you trace an interaction back to the user or system behind it and see how it unfolded across your apps.',
        ],
        link: { href: '/product-insight/', label: 'See how Fluxzero gives you full insight' },
    },
    {
        id: 'faq-ownership',
        question: 'Do I own my code and data?',
        answer: [
            'Yes. Your application code and product data remain yours. Your data can be exported in a machine-readable format.',
        ],
    },
    {
        id: 'faq-pricing',
        question: 'When do I start paying?',
        answer: [
            'Building and running locally is free. You start paying when you activate a plan to put your product online.',
        ],
        link: { href: '/pricing/', label: 'See pricing' },
    },
];

const homepageFaqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homepageFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
            '@type': 'Answer',
            text: [...faq.answer, ...(faq.steps?.map((step, index) => `${index + 1}. ${step}`) ?? [])].join('\n\n'),
        },
    })),
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead title="Fluxzero — Your agent needs a better cloud" description="Run your product on the cloud where scale, security and reliability come built in." />
    <script type="application/ld+json" set:html={JSON.stringify(homepageFaqSchema)}></script>
</head>
<body class="v4-home agent-cloud-home">
<MarketingHeader />

<main>
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-core">
      <div class="hero-bg-radial"></div>
      <div class="hero-bg-ellipse"></div>
      <div class="hero-bg-base"></div>
      <div class="hero-bg-fade">
        <div class="hero-bg-fade-left"></div>
        <div class="hero-bg-fade-right"></div>
      </div>
    </div>
  </div>
  <div class="hero-mobile-logo" aria-hidden="true">
      <img class="hero-logo-lockup" src={fluxzeroBrand.logo} width="181" height="40" alt="">
  </div>
  <h1 class="rv d1" id="hero-title"><span class="hero-title-main">Your agent needs</span><br><span class="em">a better cloud.</span></h1>

    <p class="hero-sub rv d2">
        Run your product on the cloud where scale, security and reliability come built in.
    </p>

    <div class="hero-ctas rv d3">
        <a href="#get-started" class="btn-p">Get started <span aria-hidden="true">↓</span></a>
        <a href="/how-it-works/" class="btn-s">See how it works <span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-signals rv d4" aria-label="European operation">
        <p class="hero-signal hero-signal--eu">
            <span class="hero-eu-stars" aria-hidden="true">
                {Array.from({ length: 12 }, (_, index) => <span style={`--star:${index}`}>★</span>)}
            </span>
            <span>100% EU-operated · Built on ISO 27001-certified and SOC 2 Type 2-audited infrastructure.</span>
        </p>
    </div>
</section>

<section class="homepage-start rv section-stack" id="get-started" aria-labelledby="get-started-title">
    <header class="section-intro">
        <p class="eyebrow">To get started</p>
        <h2 id="get-started-title">Copy this into your agent.</h2>
    </header>
    <AgentInstruction instructionSource />
</section>

<AgentReflections />

<CloudChoice />

<section class="comparison comparison-v4 rv section-stack" id="platform-comparison" aria-labelledby="comparison-title">
    <div class="section-intro comparison-v4__heading">
        <h2 id="comparison-title">A cloud that works for your agent.</h2>
    </div>

    <div class="comparison-desktop section-grid" role="table" aria-label="Comparison of application cloud approaches">
        <div class="comparison-head" role="row">
            <div class="comparison-head__corner" role="columnheader" aria-label="Comparison category"></div>
            {comparisonOptions.map((option) => (
                <div class:list={['comparison-head__option', { 'is-featured': option.featured }]} role="columnheader">
                    <h3>{option.name}</h3>
                    <p>{option.sub}</p>
                </div>
            ))}
        </div>
        <div class="comparison-table" role="rowgroup">
            {comparisonRows.map((row) => (
                <div class="comparison-table__row" role="row">
                    <div class="comparison-table__label" role="rowheader">{row.label}</div>
                    {comparisonOptions.map((option) => {
                        const value = row.values[option.index];
                        return (
                            <div class:list={['comparison-table__cell', { 'is-featured': option.featured }]} role="cell">
                                <span class:list={['comparison-table__mark', `is-${value.kind}`]} aria-hidden="true">
                                    {value.kind === 'included' ? '✓' : '—'}
                                </span>
                                <strong>{value.status}</strong>
                            </div>
                        );
                    })}
                </div>
            ))}
        </div>
    </div>

    <div class="comparison-mobile section-grid" data-llms-exclude>
        {comparisonOptions.map((option) => (
            <details class:list={['comparison-disclosure', { 'is-featured': option.featured }]} open={option.featured}>
                <summary>
                    <span>
                        <strong>{option.name}</strong>
                        <small>{option.sub}</small>
                    </span>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5"/></svg>
                </summary>
                <div class="comparison-disclosure__body">
                    <dl>
                        {comparisonRows.map((row) => (
                            <>
                                <dt>{row.label}</dt>
                                <dd>
                                    <span class:list={['comparison-table__mark', `is-${row.values[option.index].kind}`]} aria-hidden="true">
                                        {row.values[option.index].kind === 'included' ? '✓' : '—'}
                                    </span>
                                    <strong>{row.values[option.index].status}</strong>
                                </dd>
                            </>
                        ))}
                    </dl>
                </div>
            </details>
        ))}
    </div>

    <div class="comparison-v4__actions">
        <a class="btn-s" href="/how-it-works/">See how Fluxzero works →</a>
    </div>
</section>

<CustomerShowcase />

<section class="cta-end homepage-finish rv" aria-labelledby="cta-end-title">
    <div class="section-intro">
        <h2 class="homepage-finish__title" id="cta-end-title">Why are you still here?</h2>
    </div>
    <div class="homepage-finish__prompt" data-llms-exclude>
        <AgentInstruction showAgents={false} />
    </div>
    <div class="cta-btns homepage-finish__actions">
        <button class="btn-p" type="button" aria-expanded="false" aria-controls="faq" data-toggle-faq>FAQ <span class="homepage-finish__chevron" aria-hidden="true">↓</span></button>
        <a href="/pricing/" class="btn-s">Pricing <span aria-hidden="true">→</span></a>
    </div>
    <div class="faq homepage-faq" id="faq" aria-labelledby="faq-title" data-llms-include hidden>
        <div class="faq-list">
            <header class="homepage-faq__header">
                <h2 class="faq-heading" id="faq-title">Frequently asked questions</h2>
            </header>
            {homepageFaqs.map((faq) => (
                <details class="faq-item" name="homepage-faq" id={faq.id}>
                    <summary class="faq-q"><span>{faq.question}</span><span class="faq-arrow" aria-hidden="true">+</span></summary>
                    <div class="faq-a">
                        {faq.answer.map((paragraph) => <p data-llms-summary={faq.llmsSummary || undefined}>{paragraph}</p>)}
                        {faq.steps && <ol class="faq-steps" role="list">{faq.steps.map(step => <li>{step}</li>)}</ol>}
                        {faq.link && <p><a href={faq.link.href}>{faq.link.label} <span aria-hidden="true">→</span></a></p>}
                        {faq.links && <p class="faq-links">{faq.links.map(link => <a href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}</p>}
                    </div>
                </details>
            ))}
        </div>
        <p class="faq-help">Still wondering? <a href="/contact/">Get in touch</a> and we'll help.</p>
    </div>
</section>
</main>

<MarketingFooter />
<script src="/js/home.js?v=20261003-1" defer></script>
<script src="/js/start-building-v4.js?v=20261002-1" defer></script>
<script>
    const faqToggle = document.querySelector<HTMLButtonElement>('[data-toggle-faq]');
    const faqPanel = document.querySelector<HTMLElement>('#faq');
    const reduceFaqMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let faqAnimation: Animation | null = null;
    const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('#faq details[id]'));
    let faqScrollFrame = 0;

    function setFaqExpanded(expanded: boolean, animate: boolean) {
        if (!faqToggle || !faqPanel) return;
        faqToggle.setAttribute('aria-expanded', String(expanded));
        faqPanel.inert = !expanded;

        if (!animate || reduceFaqMotion.matches) {
            faqAnimation?.cancel();
            faqAnimation = null;
            faqPanel.hidden = !expanded;
            faqPanel.classList.remove('is-transitioning');
            return;
        }

        const currentStyle = getComputedStyle(faqPanel);
        const start = {
            height: `${faqPanel.getBoundingClientRect().height}px`,
            paddingTop: faqPanel.hidden ? '0px' : currentStyle.paddingTop,
            opacity: faqPanel.hidden ? '0' : currentStyle.opacity,
            transform: faqPanel.hidden ? 'translateY(-16px)' : currentStyle.transform,
        };
        faqAnimation?.cancel();
        faqAnimation = null;

        faqPanel.hidden = false;
        faqPanel.classList.add('is-transitioning');
        const animation = faqPanel.animate([start, {
            height: expanded ? `${faqPanel.scrollHeight}px` : '0px',
            paddingTop: expanded ? getComputedStyle(faqPanel).paddingTop : '0px',
            opacity: expanded ? '1' : '0',
            transform: expanded ? 'translateY(0)' : 'translateY(-16px)',
        }], {
            duration: expanded ? 460 : 300,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
        });
        faqAnimation = animation;
        animation.onfinish = () => {
            if (faqAnimation !== animation) return;
            faqPanel.hidden = !expanded;
            faqPanel.classList.remove('is-transitioning');
            faqAnimation = null;
        };
    }

    function applyFaqLocation(animate = false, scroll = false) {
        let hash = '';
        try { hash = decodeURIComponent(window.location.hash.slice(1)); } catch { /* Ignore malformed fragments. */ }
        const selected = faqItems.find(item => item.id === hash);
        setFaqExpanded(hash === 'faq' || Boolean(selected), animate);
        faqItems.forEach(item => { item.open = item === selected; });
        cancelAnimationFrame(faqScrollFrame);
        if (scroll && (selected || hash === 'faq')) {
            faqScrollFrame = requestAnimationFrame(() => {
                (selected ?? faqPanel)?.scrollIntoView({ behavior: 'instant', block: 'start' });
            });
        }
    }

    function navigateFaq(hash: string, animate = false) {
        const url = new URL(window.location.href);
        url.hash = hash;
        if (url.href !== window.location.href) history.pushState(null, '', url);
        applyFaqLocation(animate);
    }

    faqToggle?.addEventListener('click', () => {
        navigateFaq(faqToggle.getAttribute('aria-expanded') === 'true' ? '' : 'faq', true);
    });
    faqItems.forEach(item => {
        item.querySelector('summary')?.addEventListener('click', event => {
            event.preventDefault();
            navigateFaq(item.open ? 'faq' : item.id);
        });
    });

    // The URL is the only source of FAQ state, including reloads and shared links.
    applyFaqLocation();
    window.addEventListener('popstate', () => applyFaqLocation(false, true));
    window.addEventListener('hashchange', () => applyFaqLocation(false, true));
    window.addEventListener('pageshow', () => applyFaqLocation(false, true));

</script>
</body>
</html>
