<span class="tok-annotation">@ProtectData</span>
<span class="tok-keyword">record</span> <span class="tok-type">ContactEmail</span>(
    <span class="tok-annotation">@NotBlank</span> <span class="tok-annotation">@Email</span> <span class="tok-type">String</span> <span class="tok-field">value</span>) {}`;

const webCode = `<span class="tok-keyword">record</span> <span class="tok-type">ReservationRequest</span>(
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">TicketId</span> <span class="tok-field">ticketId</span>) {}

<span class="tok-annotation">@Component</span>
<span class="tok-annotation">@Path</span>(<span class="tok-string">"/api/reservations"</span>)
<span class="tok-keyword">final class</span> <span class="tok-type">ReservationApi</span> {
