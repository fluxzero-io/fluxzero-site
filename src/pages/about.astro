---
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead title="About Fluxzero - Origin story" description="The origin story behind Fluxzero: why we made a production-ready foundation available to builders using AI." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,200;1,300;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/marketing-shell.css?v=20260625-logo-2">
    <style is:global>
        @font-face {
            font-family: 'Google Sans Flex';
            src: url('/fonts/google-sans-flex/GoogleSansFlex-Black.ttf') format('truetype');
            font-weight: 900;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Inter';
            src: url('/fonts/inter/Inter-Regular.ttf') format('truetype');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }

        :root {
            --bg: #05070B;
            --text: #F4F7FF;
            --text-secondary: #A7B4C8;
            --text-tertiary: #6E7C93;
            --accent: #00B3FF;
            --green: #4de1c4;
            --font-body: 'Inter', -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro", system-ui, sans-serif;
            --font-display: 'Google Sans Flex', sans-serif;
            --font-mono: 'Inter', -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro", system-ui, sans-serif;
            --font-italic: 'Newsreader', serif;
            --max-w: 1120px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            background: #1E1E22;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            min-height: 100vh;
            color: var(--text);
            font-family: var(--font-body);
            background:
                radial-gradient(ellipse at 50% -6%, rgba(255, 150, 76, 0.18), transparent 34%),
                radial-gradient(circle at 72% 12%, rgba(0, 179, 255, 0.07), transparent 28%),
                linear-gradient(to top right, #1E1E22 0%, #000000 100%);
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background:
                linear-gradient(rgba(76, 101, 129, 0.022) 1px, transparent 1px),
                linear-gradient(90deg, rgba(76, 101, 129, 0.022) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: linear-gradient(180deg, transparent, #000 18%, #000 74%, transparent);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .story-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            font-weight: 700;
            transition: transform 0.14s ease, border-color 0.14s ease, background-color 0.14s ease;
        }

        .story-cta:hover {
            transform: translateY(-1px);
        }

        main {
            width: min(100%, 960px);
            margin: 0 auto;
            padding: 142px 32px 0;
        }

        .origin-story {
            display: grid;
            gap: 68px;
            padding-bottom: 104px;
        }

        .story-kicker {
            margin: 0 0 22px;
            color: transparent;
            background: linear-gradient(90deg, #D9F5FF 0%, #2F7FBA 100%);
            -webkit-background-clip: text;
            background-clip: text;
            font-family: var(--font-mono);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.16em;
            line-height: 1.2;
            text-transform: uppercase;
        }

        h1,
        h2 {
            font-family: var(--font-display);
            font-weight: 900;
            letter-spacing: -0.026em;
            text-wrap: balance;
            scroll-margin-top: 104px;
        }

        h1 {
            max-width: 780px;
            font-size: clamp(40px, 5.8vw, 58px);
            line-height: 1.08;
        }

        .intro {
            max-width: 760px;
            margin-top: 30px;
            color: rgba(221, 232, 247, 0.78);
            font-size: clamp(20px, 2.3vw, 25px);
            line-height: 1.62;
        }

        .intro-small {
            max-width: 720px;
            margin-top: 24px;
            color: rgba(221, 232, 247, 0.68);
            font-size: 18px;
            line-height: 1.72;
        }

        .story-block {
            display: grid;
            grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
            gap: clamp(28px, 6vw, 72px);
            align-items: start;
        }

        .story-block h2 {
            max-width: 320px;
            color: rgba(244, 247, 255, 0.94);
            font-size: clamp(26px, 3.1vw, 34px);
            line-height: 1.16;
        }

        .story-copy {
            display: grid;
            gap: 22px;
        }

        .story-copy p {
            color: rgba(221, 232, 247, 0.76);
            font-size: 19px;
            line-height: 1.74;
        }

        .story-copy strong {
            color: rgba(244, 247, 255, 0.95);
            font-weight: 600;
        }

        .quote-panel {
            position: relative;
            overflow: hidden;
            margin: 4px 0;
            padding: clamp(26px, 4.5vw, 40px);
            border: 1px solid rgba(244, 247, 255, 0.08);
            border-radius: 18px;
            background:
                radial-gradient(circle at 84% 0%, rgba(0, 179, 255, 0.10), transparent 34%),
                radial-gradient(circle at 18% 100%, rgba(255, 150, 76, 0.08), transparent 38%),
                linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.014)),
                rgba(9, 12, 17, 0.72);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.05),
                0 22px 60px rgba(0, 0, 0, 0.22);
        }

        .quote-panel p {
            max-width: 760px;
            color: rgba(244, 247, 255, 0.92);
            font-family: var(--font-display);
            font-size: clamp(23px, 3.1vw, 32px);
            font-weight: 600;
            letter-spacing: -0.026em;
            line-height: 1.24;
            text-wrap: balance;
        }

        .final-block {
            position: relative;
            overflow: hidden;
            padding: clamp(34px, 6vw, 58px);
            border: 1px solid rgba(0, 179, 255, 0.16);
            border-radius: 20px;
            background:
                radial-gradient(circle at 50% 0%, rgba(255, 150, 76, 0.14), transparent 42%),
                radial-gradient(circle at 82% 18%, rgba(0, 179, 255, 0.12), transparent 34%),
                rgba(8, 12, 18, 0.66);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.05),
                0 24px 70px rgba(0, 0, 0, 0.24);
        }

        .final-block h2 {
            max-width: 680px;
            font-size: clamp(28px, 4vw, 40px);
            line-height: 1.14;
        }

        .final-block .story-kicker {
            margin-bottom: 16px;
            font-size: 10px;
            letter-spacing: 0.13em;
        }

        .final-block p {
            max-width: 720px;
            margin-top: 24px;
            color: rgba(221, 232, 247, 0.78);
            font-size: 20px;
            line-height: 1.68;
        }

        .final-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 34px;
        }

        .story-cta {
            min-height: 58px;
            min-width: 220px;
            padding: 0 28px;
            color: #160719;
            background: linear-gradient(135deg, #D9F5FF 0%, #2086F0 100%);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.42),
                0 0 32px rgba(0, 179, 255, 0.16);
        }


        @media (max-width: 860px) {

            .story-block {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {

            main {
                padding: 106px 20px 0;
            }

            .origin-story {
                gap: 52px;
                padding-bottom: 76px;
            }

            h1 {
                font-size: clamp(34px, 9.5vw, 44px);
            }

            .intro {
                margin-top: 24px;
                font-size: 18px;
            }

            .intro-small {
                margin-top: 18px;
                font-size: 16.5px;
            }

            .story-copy p {
                font-size: 17px;
            }

            .final-actions {
                width: 100%;
            }

            .story-cta {
                width: 100%;
                min-width: 0;
            }

        }
    </style>
</head>
<body>
<MarketingHeader active="about" />

<main>
    <article class="origin-story">
        <header>
            <p class="story-kicker">Origin story</p>
            <h1 id="origin-story">Fluxzero started with a simple frustration.</h1>
            <p class="intro">Building software kept drifting away from the product itself.</p>
            <p class="intro intro-small">The first time we tried to build a serious product, we thought the hard part would be the idea, the users, and the product itself. Instead, we got buried in everything around it.</p>
        </header>

        <section class="story-block">
            <h2 id="work-around-product">The work around the product kept taking over</h2>
            <div class="story-copy">
                <p>Again and again, we saw the same thing happen. A team would start with a clear product idea, then slowly disappear into the foundation beneath it: auth, data, architecture, permissions, deployment, operations, monitoring, failures, security, scale.</p>
                <p>None of that work is optional. It is the work that makes software trustworthy. But it is also the work that turns a product into an infrastructure project before anyone even gets to use it.</p>
            </div>
        </section>

        <section class="quote-panel">
            <p>We did not want another workaround. We wanted the foundation we wished had existed from the start.</p>
        </section>

        <section class="story-block">
            <h2 id="ai-changed-who-could-build">Then AI changed who could build</h2>
            <div class="story-copy">
                <p>AI made it possible for founders, designers, frontenders, domain experts, and small teams to build working software at a speed that used to be impossible.</p>
                <p>That is exciting. But it also exposes the same old problem in a sharper way. It makes little sense for AI to rebuild the foundation every time it builds a product. And it's risky too: builders are left trusting technical choices while trying to build the product itself.</p>
            </div>
        </section>

        <section class="story-block">
            <h2 id="reusable-foundation">So we made our foundation reusable</h2>
            <div class="story-copy">
                <p>For years, we built systems where correctness, reliability, testing, operations, and scale mattered from day one. Fluxzero grew out of that work.</p>
                <p>Our obsession is simple: build a best-in-class backend foundation, and keep it out of the product layer so it never slows builders down.</p>
            </div>
        </section>

        <section class="final-block">
            <p class="story-kicker">What this means now</p>
            <h2 id="real-foundation">Every builder can start on a real foundation</h2>
            <p>Fluxzero gives anyone building with AI a production-ready backend from the start. You focus on the product. Fluxzero handles the architecture underneath, so what you build can become real software.</p>
            <div class="final-actions">
                <a href="/start-building" class="story-cta">Start building &rarr;</a>
            </div>
        </section>
    </article>
</main>

<MarketingFooter />

<script>
    async function initSystemStatus() {
        const link = document.querySelector('[data-status-link]');
        const dot = document.querySelector('[data-status-dot]');
        if (!link || !dot || typeof fetch !== 'function') return;

        try {
            const response = await fetch('https://fluxzero.statuspage.io/api/v2/status.json', { cache: 'no-store' });
            if (!response.ok) return;

            const payload = await response.json();
            const status = payload && payload.status ? payload.status : {};
            const indicator = ['none', 'minor', 'major', 'critical', 'maintenance'].includes(status.indicator)
                ? status.indicator
                : 'none';
            const description = status.description || 'System status';

            dot.dataset.status = indicator;
            link.setAttribute('aria-label', 'System status: ' + description);
            link.title = description;
        } catch (error) {
            /* Keep the default healthy dot if the status API is unavailable. */
        }
    }

    initSystemStatus();
</script>
</body>
</html>
