---
import '../../public/css/v4.css';
import '../../public/css/marketing-shell.css';
import '../../public/css/partners.css';
import BrandHead from '../components/BrandHead.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead title="Partners — Fluxzero" description="More projects. Less to manage. Fluxzero maintains the technical foundation, so your team can focus on the product. Let’s talk." />
</head>
<body class="v4-page partners-page">
    <a class="partners-skip" href="#main">Skip to content</a>
    <MarketingHeader />
    <main id="main" class="partners-main">
        <div class="partners-layout">
            <header class="partners-intro">
                <p class="partners-eyebrow">For agencies &amp; builders</p>
                <h1>More projects.<br><span>Less to manage.</span></h1>
                <p class="partners-lead">Take on more client projects. Fluxzero runs and maintains the technical foundation, so your team can focus on the product.</p>
                <p class="partners-lead">As a partner, you work directly with the Fluxzero team. We help you get started, answer your questions and guide you as you build.</p>
            </header>

            <section class="partners-contact" aria-labelledby="contact-title">
                <h2 id="contact-title">Become a partner.</h2>
                <form action="https://getform.io/f/bejeorxa" id="contactForm" method="POST" novalidate>
                    <input type="hidden" name="_gotcha">
                    <input type="hidden" name="source" value="Partners">
                    <div class="partners-fields">
                        <div class="partners-field">
                            <label for="fn">Name</label>
                            <input name="name" type="text" id="fn" autocomplete="name" required>
                        </div>
                        <div class="partners-field">
                            <label for="email">Work email</label>
                            <input name="email" type="email" id="email" autocomplete="email" required>
                        </div>
                    </div>
                    <div class="partners-field">
                        <label for="message">Tell us about your projects</label>
                        <textarea name="message" id="message" rows="4" required></textarea>
                    </div>
                    <button type="submit" id="submitButton" class="v4-button v4-button--primary" data-confirmation="true"><span data-button-label>Send message</span></button>
                    <p id="formStatus" class="partners-status" role="status" aria-live="polite" data-success-message="Thanks! We'll be in touch."></p>
                </form>
            </section>
        </div>
    </main>
    <footer class="partners-footer">
        <span>© {new Date().getFullYear()} Fluxzero</span>
        <a href="/docs/about/privacy/">Privacy</a>
    </footer>
    <script src="../scripts/contact-form.ts"></script>
</body>
</html>
