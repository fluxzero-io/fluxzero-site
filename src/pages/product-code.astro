            <span class="tok-type">ReservationId</span>.<span class="tok-keyword">class</span>);

        <span class="tok-type">Fluxzero</span>.<span class="tok-call">sendCommandAndWait</span>(
            <span class="tok-keyword">new</span> <span class="tok-type">ReserveTicket</span>(
                reservationId, request.<span class="tok-call">ticketId</span>()));
        <span class="tok-keyword">return</span> reservationId;
