---
import { websiteOidcConfig } from '../../config/website-oidc.mjs';

const oidc = websiteOidcConfig(import.meta.env);
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <title>Completing sign-in</title>
</head>
<body
    data-website-oidc-callback={oidc.enabled ? '' : undefined}
    data-oidc-issuer={oidc.enabled ? oidc.issuer : undefined}
    data-oidc-client-id={oidc.enabled ? oidc.clientId : undefined}
>
<script>
    import { finishSilentWebsiteOidc } from '../../scripts/website-oidc';
    void finishSilentWebsiteOidc();
</script>
</body>
</html>
