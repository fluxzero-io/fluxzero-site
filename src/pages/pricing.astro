                radial-gradient(circle at 50% 0%, rgba(0, 179, 255, 0.11), transparent 46%),
                linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.016)),
                rgba(8, 12, 18, 0.8);
