---
import { Aside } from '@astrojs/starlight/components';

// Get the current page path and construct the GitHub edit URL
const pagePath = Astro.url.pathname.replace(/\/$/, '').slice(1);
const docsPath = pagePath.replace(/^docs\//, '');
const editUrl = `https://github.com/fluxzero-io/fluxzero-sdk-java/edit/main/docs/developer/${docsPath}.mdx`;
---

<Aside type="caution" title="Work in Progress">
  This page is currently under construction. Help us improve it by <a href={editUrl}>editing this page on GitHub</a>.
</Aside>