}`;

const historyCode = `<span class="tok-annotation">@Component</span>
<span class="tok-annotation">@Consumer</span>(<span class="tok-field">name</span> = <span class="tok-string">"customer-rewards-v1"</span>, <span class="tok-field">minIndex</span> = <span class="tok-number">0</span>)
<span class="tok-keyword">final class</span> <span class="tok-type">CustomerRewards</span> {
    <span class="tok-annotation">@HandleEvent</span>
    <span class="tok-keyword">void</span> <span class="tok-method">reward</span>(
            <span class="tok-type">ConfirmReservation</span> event,
