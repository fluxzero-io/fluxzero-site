---
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import ProductCodePanel from '../components/marketing/ProductCodePanel.astro';
import 'boxicons/css/boxicons.min.css';

const actionCode = `<span class="tok-keyword">record</span> <span class="tok-type">ReserveTicket</span>(
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">ReservationId</span> <span class="tok-field">reservationId</span>,
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">TicketId</span> <span class="tok-field">ticketId</span>) {

    <span class="tok-annotation">@AssertLegal</span>
    <span class="tok-keyword">void</span> <span class="tok-method">assertAvailable</span>(<span class="tok-type">Ticket</span> ticket) {
        <span class="tok-keyword">if</span> (ticket.<span class="tok-method">status</span>() != <span class="tok-type">AVAILABLE</span>) {
            <span class="tok-keyword">throw</span> <span class="tok-type">TicketErrors</span>.notAvailable;
        }
    }

    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">Ticket</span> <span class="tok-method">reserve</span>(<span class="tok-type">Ticket</span> ticket) {
        <span class="tok-keyword">return</span> ticket.<span class="tok-method">withStatus</span>(<span class="tok-type">RESERVED</span>);
    }

    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">Reservation</span> <span class="tok-method">createReservation</span>(<span class="tok-type">User</span> user) {
        <span class="tok-keyword">return</span> <span class="tok-type">Reservation</span>.<span class="tok-call">awaitingPayment</span>(
            reservationId, ticketId, <span class="tok-type">CustomerId</span>.<span class="tok-call">from</span>(user));
    }
}`;

const modelCode = `<span class="tok-annotation">@Model</span>
<span class="tok-keyword">record</span> <span class="tok-type">Show</span>(
    <span class="tok-annotation">@EntityId</span> <span class="tok-type">ShowId</span> <span class="tok-field">showId</span>,
    <span class="tok-type">String</span> <span class="tok-field">name</span>,
    <span class="tok-type">ShowStatus</span> <span class="tok-field">status</span>) {}

<span class="tok-annotation">@Model</span>
<span class="tok-keyword">record</span> <span class="tok-type">Ticket</span>(
    <span class="tok-annotation">@EntityId</span> <span class="tok-type">TicketId</span> <span class="tok-field">ticketId</span>,
    <span class="tok-annotation">@Parent</span>(<span class="tok-field">pathInParent</span> = <span class="tok-string">"tickets"</span>)
    <span class="tok-type">ShowId</span> <span class="tok-field">showId</span>,
    <span class="tok-type">Seat</span> <span class="tok-field">seat</span>,
    <span class="tok-annotation">@With</span> <span class="tok-annotation">@Facet</span> <span class="tok-type">TicketStatus</span> <span class="tok-field">status</span>) {}

<span class="tok-annotation">@Model</span>
<span class="tok-keyword">record</span> <span class="tok-type">Reservation</span>(
    <span class="tok-annotation">@EntityId</span> <span class="tok-type">ReservationId</span> <span class="tok-field">reservationId</span>,
    <span class="tok-annotation">@Parent</span>(<span class="tok-field">pathInParent</span> = <span class="tok-string">"reservations"</span>)
    <span class="tok-type">TicketId</span> <span class="tok-field">ticketId</span>,
    <span class="tok-type">CustomerId</span> <span class="tok-field">customerId</span>,
    <span class="tok-annotation">@With</span> <span class="tok-type">ReservationStatus</span> <span class="tok-field">status</span>,
    <span class="tok-annotation">@With</span> <span class="tok-type">ContactEmail</span> <span class="tok-field">contactEmail</span>) {}

<span class="tok-keyword">record</span> <span class="tok-type">Seat</span>(
    <span class="tok-annotation">@Facet</span> <span class="tok-type">String</span> <span class="tok-field">section</span>,
    <span class="tok-annotation">@Sortable</span> <span class="tok-keyword">int</span> <span class="tok-field">row</span>,
    <span class="tok-keyword">int</span> <span class="tok-field">number</span>) {}`;

const testCode = `<span class="tok-annotation">@Test</span>
<span class="tok-keyword">void</span> <span class="tok-method">reservesAnAvailableTicket</span>() {
    fixture
        .<span class="tok-call">givenCommands</span>(<span class="tok-string">"/ticketing/available-ticket.json"</span>)
        .<span class="tok-call">whenCommandByUser</span>(<span class="tok-string">"customer-42"</span>,
            <span class="tok-string">"/ticketing/reserve-ticket.json"</span>)
        .<span class="tok-call">expectOnlyEvents</span>(
            <span class="tok-string">"/ticketing/reserve-ticket.json"</span>);
}

<span class="tok-annotation">@Test</span>
<span class="tok-keyword">void</span> <span class="tok-method">rejectsASecondReservation</span>() {
    fixture
        .<span class="tok-call">givenCommands</span>(<span class="tok-string">"/ticketing/available-ticket.json"</span>)
        .<span class="tok-call">givenCommandsByUser</span>(<span class="tok-string">"customer-42"</span>,
            <span class="tok-string">"/ticketing/reserve-ticket.json"</span>)
        .<span class="tok-call">whenCommandByUser</span>(<span class="tok-string">"customer-77"</span>,
            <span class="tok-string">"/ticketing/reserve-same-ticket.json"</span>)
        .<span class="tok-call">expectExceptionalResult</span>(<span class="tok-type">TicketErrors</span>.notAvailable)
        .<span class="tok-call">expectNoEvents</span>();
}`;

const searchCode = `<span class="tok-keyword">record</span> <span class="tok-type">FindAvailableTickets</span>(
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">ShowId</span> <span class="tok-field">showId</span>,
    <span class="tok-annotation">@NotBlank</span> <span class="tok-type">String</span> <span class="tok-field">section</span>)
        <span class="tok-keyword">implements</span> <span class="tok-type">Request</span>&lt;<span class="tok-type">List</span>&lt;<span class="tok-type">Ticket</span>&gt;&gt; {

    <span class="tok-annotation">@HandleQuery</span>
    <span class="tok-type">List</span>&lt;<span class="tok-type">Ticket</span>&gt; <span class="tok-method">handle</span>() {
        <span class="tok-keyword">return</span> <span class="tok-type">Fluxzero</span>.<span class="tok-call">search</span>(<span class="tok-type">Ticket</span>.class)
            .<span class="tok-call">whereParent</span>(showId)
            .<span class="tok-call">match</span>(<span class="tok-type">AVAILABLE</span>, <span class="tok-string">"status"</span>)
            .<span class="tok-call">match</span>(section, <span class="tok-string">"seat/section"</span>)
            .<span class="tok-call">sortBy</span>(<span class="tok-string">"seat/row"</span>)
            .<span class="tok-call">fetch</span>(<span class="tok-literal">50</span>);
    }
}`;

const timerCode = `<span class="tok-annotation">@Component</span>
<span class="tok-keyword">final class</span> <span class="tok-type">ReservationTimers</span> {
    <span class="tok-annotation">@HandleEvent</span>
    <span class="tok-keyword">void</span> <span class="tok-method">start</span>(<span class="tok-type">ReserveTicket</span> event) {
        <span class="tok-type">Fluxzero</span>.<span class="tok-call">scheduleCommand</span>(
            <span class="tok-keyword">new</span> <span class="tok-type">ExpireReservation</span>(
                event.<span class="tok-method">reservationId</span>(), event.<span class="tok-method">ticketId</span>()),
            <span class="tok-string">"expire-"</span> + event.<span class="tok-method">reservationId</span>(),
            <span class="tok-type">Duration</span>.<span class="tok-call">ofMinutes</span>(<span class="tok-literal">15</span>));
    }

    <span class="tok-annotation">@HandleEvent</span>
    <span class="tok-keyword">void</span> <span class="tok-method">stop</span>(<span class="tok-type">ConfirmReservation</span> event) {
        <span class="tok-type">Fluxzero</span>.<span class="tok-call">cancelSchedule</span>(
            <span class="tok-string">"expire-"</span> + event.<span class="tok-method">reservationId</span>());
    }
}`;

const expiryCode = `<span class="tok-keyword">record</span> <span class="tok-type">ExpireReservation</span>(
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">ReservationId</span> <span class="tok-field">reservationId</span>,
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">TicketId</span> <span class="tok-field">ticketId</span>) {

    <span class="tok-annotation">@AssertLegal</span>
    <span class="tok-keyword">void</span> <span class="tok-method">assertAwaitingPayment</span>(
            <span class="tok-type">Reservation</span> reservation, <span class="tok-type">Ticket</span> ticket) {
        <span class="tok-keyword">if</span> (reservation.<span class="tok-method">status</span>() != <span class="tok-type">AWAITING_PAYMENT</span>
                || ticket.<span class="tok-method">status</span>() != <span class="tok-type">RESERVED</span>
                || !reservation.<span class="tok-method">ticketId</span>().<span class="tok-call">equals</span>(ticketId)) {
            <span class="tok-keyword">throw</span> <span class="tok-type">ReservationErrors</span>.notAwaitingPayment;
        }
    }

    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">Reservation</span> <span class="tok-method">expire</span>(<span class="tok-type">Reservation</span> reservation) {
        <span class="tok-keyword">return</span> reservation.<span class="tok-method">withStatus</span>(<span class="tok-type">EXPIRED</span>);
    }

    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">Ticket</span> <span class="tok-method">release</span>(<span class="tok-type">Ticket</span> ticket) {
        <span class="tok-keyword">return</span> ticket.<span class="tok-method">withStatus</span>(<span class="tok-type">AVAILABLE</span>);
    }
}`;

const packagePolicyCode = `<span class="tok-comment">// package-info.java</span>
<span class="tok-annotation">@RequiresUser</span>
<span class="tok-keyword">package</span> com.acme.ticketing;

<span class="tok-keyword">import</span> io.fluxzero.sdk.tracking.handling.authentication.RequiresUser;`;

const personalDataCode = `<span class="tok-keyword">record</span> <span class="tok-type">UpdateContactEmail</span>(
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">ReservationId</span> <span class="tok-field">reservationId</span>,
    <span class="tok-annotation">@NotNull</span> <span class="tok-annotation">@Valid</span> <span class="tok-annotation">@ProtectData</span>
    <span class="tok-type">ContactEmail</span> <span class="tok-field">contactEmail</span>) {

    <span class="tok-annotation">@AssertLegal</span>
    <span class="tok-keyword">void</span> <span class="tok-method">assertOwner</span>(<span class="tok-type">Reservation</span> reservation, <span class="tok-type">User</span> user) {
        <span class="tok-keyword">if</span> (!reservation.<span class="tok-method">customerId</span>()
                .<span class="tok-call">equals</span>(<span class="tok-type">CustomerId</span>.<span class="tok-call">from</span>(user))) {
            <span class="tok-keyword">throw</span> <span class="tok-type">ReservationErrors</span>.notOwner;
        }
    }

    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">Reservation</span> <span class="tok-method">update</span>(<span class="tok-type">Reservation</span> reservation) {
        <span class="tok-keyword">return</span> reservation.<span class="tok-method">withContactEmail</span>(contactEmail);
    }
}

<span class="tok-annotation">@ProtectData</span>
<span class="tok-keyword">record</span> <span class="tok-type">ContactEmail</span>(
    <span class="tok-annotation">@NotBlank</span> <span class="tok-annotation">@Email</span> <span class="tok-type">String</span> <span class="tok-field">value</span>) {}`;

const webCode = `<span class="tok-keyword">record</span> <span class="tok-type">ReservationRequest</span>(
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">TicketId</span> <span class="tok-field">ticketId</span>) {}

<span class="tok-annotation">@Component</span>
<span class="tok-annotation">@Path</span>(<span class="tok-string">"/api/reservations"</span>)
<span class="tok-keyword">final class</span> <span class="tok-type">ReservationApi</span> {
    <span class="tok-annotation">@HandlePost</span>
    <span class="tok-type">ReservationId</span> <span class="tok-method">reserve</span>(<span class="tok-annotation">@Valid</span> <span class="tok-type">ReservationRequest</span> request) {
        <span class="tok-keyword">var</span> reservationId = <span class="tok-type">Fluxzero</span>.<span class="tok-call">generateId</span>(
            <span class="tok-type">ReservationId</span>.class);

        <span class="tok-type">Fluxzero</span>.<span class="tok-call">sendCommandAndWait</span>(
            <span class="tok-keyword">new</span> <span class="tok-type">ReserveTicket</span>(
                reservationId, request.<span class="tok-method">ticketId</span>()));
        <span class="tok-keyword">return</span> reservationId;
    }
}`;

const historyCode = `<span class="tok-annotation">@Component</span>
<span class="tok-annotation">@Consumer</span>(<span class="tok-field">name</span> = <span class="tok-string">"customer-rewards-v1"</span>, <span class="tok-field">minIndex</span> = <span class="tok-literal">0</span>)
<span class="tok-keyword">final class</span> <span class="tok-type">CustomerRewards</span> {
    <span class="tok-annotation">@HandleEvent</span>
    <span class="tok-keyword">void</span> <span class="tok-method">reward</span>(
            <span class="tok-type">ConfirmReservation</span> event,
            <span class="tok-type">Reservation</span> reservation) {
        <span class="tok-type">Fluxzero</span>.<span class="tok-call">sendCommandAndWait</span>(
            <span class="tok-keyword">new</span> <span class="tok-type">GrantReservationReward</span>(
                <span class="tok-type">RewardGrantId</span>.<span class="tok-call">forReservation</span>(event.<span class="tok-method">reservationId</span>()),
                reservation.<span class="tok-method">customerId</span>(), <span class="tok-literal">100</span>));
    }
}

<span class="tok-keyword">record</span> <span class="tok-type">GrantReservationReward</span>(
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">RewardGrantId</span> <span class="tok-field">rewardGrantId</span>,
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">CustomerId</span> <span class="tok-field">customerId</span>,
    <span class="tok-annotation">@Positive</span> <span class="tok-keyword">int</span> <span class="tok-field">points</span>) {

    <span class="tok-annotation">@InterceptApply</span>
    <span class="tok-type">Object</span> <span class="tok-method">ignoreIfAlreadyGranted</span>(<span class="tok-type">Graph</span>&lt;<span class="tok-type">RewardGrant</span>&gt; current) {
        <span class="tok-keyword">return</span> current.<span class="tok-method">isPresent</span>() ? <span class="tok-literal">null</span> : <span class="tok-keyword">this</span>;
    }

    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">RewardGrant</span> <span class="tok-method">grant</span>() {
        <span class="tok-keyword">return new</span> <span class="tok-type">RewardGrant</span>(rewardGrantId, customerId, points);
    }
}

<span class="tok-annotation">@Model</span>
<span class="tok-keyword">record</span> <span class="tok-type">RewardGrant</span>(
    <span class="tok-annotation">@EntityId</span> <span class="tok-type">RewardGrantId</span> <span class="tok-field">rewardGrantId</span>,
    <span class="tok-type">CustomerId</span> <span class="tok-field">customerId</span>,
    <span class="tok-keyword">int</span> <span class="tok-field">points</span>) {}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead
        title="Product decisions are the code — Fluxzero"
        description="See how Fluxzero lets application code express real product behavior while the platform supplies the technical foundation underneath."
    />
    <link rel="stylesheet" href="/css/v4.css?v=20260905-1">
    <link rel="stylesheet" href="/css/technical-foundation.css?v=20260904-5">
    <link rel="stylesheet" href="/css/technical-foundation-next.css?v=20260910-11">
    <link rel="stylesheet" href="/css/product-code.css?v=20260911-11">
    <link rel="stylesheet" href="/css/marketing-shell.css?v=20260903-1">
</head>
<body class="v4-page cloud-proof-page cloud-proof-next-page product-code-page">
    <MarketingHeader active="how-it-works" />

    <main>
        <header class="cloud-proof-hero cloud-proof-next-hero product-code-hero">
            <span class="product-code-hero__sun" aria-hidden="true"></span>
            <div class="v4-shell cloud-proof-shell product-code-hero__layout">
                <div class="product-code-hero__copy">
                    <p class="cloud-proof-hero__back" data-reveal><a href="/how-it-works#behavior-title" data-browser-back><i class="bx bx-left-arrow-alt" aria-hidden="true"></i> Back</a></p>
                    <p class="cloud-proof-next__eyebrow" data-reveal>Product code</p>
                    <h1 data-reveal data-reveal-delay="1">Product decisions<br><span>are the code.</span></h1>
                    <p class="cloud-proof-hero__lead" data-reveal data-reveal-delay="2">Fluxzero moves the engineering foundation into the cloud. The application describes the decisions that make the product behave; the platform takes responsibility for executing them correctly.</p>
                </div>
            </div>
        </header>

        <article class="cloud-proof-section cloud-proof-next-section product-code-section" id="intent" aria-labelledby="intent-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy" data-reveal>
                    <p class="cloud-proof-next__number">01 · Product decisions</p>
                    <h2 id="intent-title">Commands describe decisions.<br><span>Rules and changes stay together.</span></h2>
                    <p>A command names something a user wants the product to do. It carries only the input needed for that decision, while the applicable rules and resulting state changes sit beside it in the same piece of code.</p>
                </header>
                <div class="product-code-proof product-code-proof--action" data-reveal data-reveal-delay="1">
                    <ProductCodePanel title="ReserveTicket.java" label="Action, rule, two changes" code={actionCode} />
                    <dl class="product-code-proof__notes">
                        <div><dt>Current models</dt><dd>Fluxzero loads the model state required by the typed IDs.</dd></div>
                        <div><dt>Current user</dt><dd>Fluxzero supplies the authenticated user from the message context.</dd></div>
                        <div><dt>Safe execution</dt><dd>Fluxzero applies every change together and rechecks concurrent decisions.</dd></div>
                    </dl>
                </div>
            </div>
        </article>

        <article class="cloud-proof-section cloud-proof-next-section product-code-section" id="domain-state" aria-labelledby="domain-state-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy" data-reveal>
                    <p class="cloud-proof-next__number">02 · Product state</p>
                    <h2 id="domain-state-title">Model state by lifecycle.<br><span>Not by storage.</span></h2>
                    <p>A model is an immutable state holder with its own identity and lifecycle. State that changes independently gets its own model; values without a separate lifecycle remain inside the model that owns them.</p>
                </header>
                <div class="product-code-proof product-code-proof--model" data-reveal data-reveal-delay="1">
                    <ProductCodePanel title="TicketingModel.java" label="State holders and relationships" code={modelCode} />
                    <dl class="product-code-proof__notes">
                        <div><dt>Durable state</dt><dd>Fluxzero stores accepted decisions and reconstructs the current model.</dd></div>
                        <div><dt>No data layer</dt><dd>Fluxzero loads and saves models by typed identity without repository code.</dd></div>
                        <div><dt>Relationships</dt><dd>Fluxzero maintains links between models and preserves their history.</dd></div>
                    </dl>
                </div>
            </div>
        </article>

        <article class="cloud-proof-section cloud-proof-next-section product-code-section" id="tests" aria-labelledby="tests-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy" data-reveal>
                    <p class="cloud-proof-next__number">03 · Behavior tests</p>
                    <h2 id="tests-title">Test messages and outcomes.<br><span>Not internal state.</span></h2>
                    <p>A test sends the same messages a real user would send and checks the outcome that follows. The scenario lives in external JSON, so it remains readable while the implementation changes.</p>
                </header>
                <div class="product-code-proof product-code-proof--test" data-reveal data-reveal-delay="1">
                    <ProductCodePanel title="ReserveTicketTest.java" label="Real user, real model pipeline" code={testCode} />
                    <dl class="product-code-proof__notes">
                        <div><dt>Same pipeline</dt><dd>Fluxzero runs the scenario through the application’s real model pipeline.</dd></div>
                        <div><dt>Complete context</dt><dd>Fluxzero supplies the user and runtime context declared by the fixture.</dd></div>
                        <div><dt>Observable proof</dt><dd>Fluxzero verifies the resulting messages or error without exposing internal state.</dd></div>
                    </dl>
                </div>
            </div>
        </article>

        <article class="cloud-proof-section cloud-proof-next-section product-code-section" id="search" aria-labelledby="search-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy" data-reveal>
                    <p class="cloud-proof-next__number">04 · Product queries</p>
                    <h2 id="search-title">Queries return product models.<br><span>No database access layer.</span></h2>
                    <p>A query names the answer the product needs and returns typed models. Its handler expresses selection and order in product terms without opening a database connection or mapping storage records.</p>
                </header>
                <div class="product-code-proof product-code-proof--query" data-reveal data-reveal-delay="1">
                    <ProductCodePanel title="FindAvailableTickets.java" label="Typed product question" code={searchCode} />
                    <dl class="product-code-proof__notes">
                        <div><dt>Current state</dt><dd>Fluxzero maintains a searchable view of accepted model changes.</dd></div>
                        <div><dt>Model graph</dt><dd>Fluxzero resolves parent relationships without joins in application code.</dd></div>
                        <div><dt>Query execution</dt><dd>Fluxzero applies selection and ordering; <code>@Sortable</code> is an optional speed hint.</dd></div>
                    </dl>
                </div>
            </div>
        </article>

        <article class="cloud-proof-section cloud-proof-next-section product-code-section" id="workflows" aria-labelledby="workflows-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy" data-reveal>
                    <p class="cloud-proof-next__number">05 · Scheduled decisions</p>
                    <h2 id="workflows-title">Schedule the next decision.<br><span>No job system required.</span></h2>
                    <p>A product decision can schedule an ordinary command for later. Another decision can cancel it, and a command that becomes due still follows the same rules as every immediate action.</p>
                </header>
                <div class="product-code-proof product-code-proof--stacked" data-reveal data-reveal-delay="1">
                    <div class="product-code-proof__code-stack">
                        <ProductCodePanel title="ReservationTimers.java" label="Start and cancel a deadline" code={timerCode} />
                        <ProductCodePanel title="ExpireReservation.java" label="Close and release together" code={expiryCode} />
                    </div>
                    <dl class="product-code-proof__notes">
                        <div><dt>Durable deadline</dt><dd>Fluxzero keeps the schedule through restarts and deployments.</dd></div>
                        <div><dt>Cancellation</dt><dd>Fluxzero finds and cancels the deadline by its stable identifier.</dd></div>
                        <div><dt>Current decision</dt><dd>Fluxzero loads current state and rechecks conflicts when the command runs.</dd></div>
                    </dl>
                </div>
            </div>
        </article>

        <article class="cloud-proof-section cloud-proof-next-section product-code-section" id="policy" aria-labelledby="policy-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy" data-reveal>
                    <p class="cloud-proof-next__number">06 · Access and privacy</p>
                    <h2 id="policy-title">Keep access rules beside the action.<br><span>The user is already in context.</span></h2>
                    <p>A product domain can require an authenticated user by default. The rule receives that user from context and decides whether the action is allowed, while sensitive values remain ordinary typed data in trusted code.</p>
                </header>
                <div class="product-code-proof product-code-proof--stacked" data-reveal data-reveal-delay="1">
                    <div class="product-code-proof__code-stack">
                        <ProductCodePanel title="package-info.java" label="Secure by default" code={packagePolicyCode} />
                        <ProductCodePanel title="UpdateContactEmail.java" label="Ownership and protected data" code={personalDataCode} />
                    </div>
                    <dl class="product-code-proof__notes">
                        <div><dt>Authenticated context</dt><dd>Fluxzero carries the current user into the applicable rule.</dd></div>
                        <div><dt>Default access</dt><dd>Fluxzero enforces the package policy before product behavior runs.</dd></div>
                        <div><dt>Protected values</dt><dd>Fluxzero separates protected data from durable messages so it can be erased independently.</dd></div>
                    </dl>
                </div>
            </div>
        </article>

        <article class="cloud-proof-section cloud-proof-next-section product-code-section" id="web" aria-labelledby="web-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy" data-reveal>
                    <p class="cloud-proof-next__number">07 · Web boundary</p>
                    <h2 id="web-title">Turn web input into a command.<br><span>Keep the endpoint thin.</span></h2>
                    <p>An endpoint accepts web input, creates any server-owned identity and sends the already-tested command. It returns an ordinary value or lets a product error flow back to the caller.</p>
                </header>
                <div class="product-code-proof product-code-proof--web" data-reveal data-reveal-delay="1">
                    <ProductCodePanel title="ReservationApi.java" label="HTTP to product action" code={webCode} />
                    <dl class="product-code-proof__notes">
                        <div><dt>Web input</dt><dd>Fluxzero maps and validates the request before the handler runs.</dd></div>
                        <div><dt>User context</dt><dd>Fluxzero carries the authenticated user with the resulting command.</dd></div>
                        <div><dt>Web response</dt><dd>Fluxzero maps ordinary return values and known errors to HTTP.</dd></div>
                    </dl>
                </div>
            </div>
        </article>

        <article class="cloud-proof-section cloud-proof-next-section product-code-section" id="evolution" aria-labelledby="evolution-title">
            <div class="v4-shell cloud-proof-shell">
                <header class="cloud-proof-copy" data-reveal>
                    <p class="cloud-proof-next__number">08 · Existing history</p>
                    <h2 id="evolution-title">Add a handler later.<br><span>Start from the first event.</span></h2>
                    <p>A new handler can begin at index zero and process decisions that happened before it existed. It receives the model exactly as it was after each event, so the new behavior can use the original product context.</p>
                </header>
                <div class="product-code-proof product-code-proof--history" data-reveal data-reveal-delay="1">
                    <ProductCodePanel title="CustomerRewards.java" label="New capability, complete history" code={historyCode} />
                    <dl class="product-code-proof__notes">
                        <div><dt>Complete history</dt><dd>Fluxzero retains the accepted events from the first product decision.</dd></div>
                        <div><dt>Historical context</dt><dd>Fluxzero supplies the model state that belonged to each event.</dd></div>
                        <div><dt>Reliable progress</dt><dd>Fluxzero tracks delivery and retries failures without losing the consumer’s place.</dd></div>
                    </dl>
                </div>
            </div>
        </article>

        <section class="cloud-proof-next-conclusion product-code-conclusion" aria-labelledby="conclusion-title">
            <div class="v4-shell cloud-proof-shell" data-reveal>
                <p class="cloud-proof-next__eyebrow">The split of responsibility</p>
                <h2 id="conclusion-title">Product decisions in the code.<br><span>Engineering in the cloud.</span></h2>
                <p>Builders and coding agents define behavior. Fluxzero keeps that behavior dependable from the first local test through production.</p>
                <strong>The product stays visible in the code.</strong>
                <div class="cloud-proof-next__actions">
                    <a class="v4-button v4-button--primary" href="/get-started"><span>Start building</span><i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                    <a class="v4-button v4-button--secondary" href="/docs"><span>Inspect the SDK</span><i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                </div>
            </div>
        </section>
    </main>

    <MarketingFooter />
    <script src="/js/v4.js?v=20260904-3" defer></script>
    <script src="/js/product-code.js?v=20260911-2" defer></script>
</body>
