            color: var(--text-secondary);
            font-size: var(--fs-body-secondary);
            line-height: var(--lh-card);
        }

        .pricing-v2-faq-a p + p {
            margin-top: 16px;
        }

        .pricing-v2-faq-help {
            margin-top: 22px;
            color: var(--text-secondary);
            font-size: 14.5px;
            line-height: 1.6;
            text-align: center;
        }

        .pricing-v2-faq-help a {
            color: #9BDFFF;
            font-weight: 650;
            text-decoration: underline;
            text-decoration-color: rgba(155, 223, 255, 0.42);
            text-underline-offset: 3px;
        }

        footer {
            position: relative;
            border-top: 1px solid rgba(221, 247, 255, 0.055);
            padding: 38px 32px 42px;
            max-width: var(--max-w);
            margin: 0 auto;
        }

        footer::before {
            content: "";
            position: absolute;
            left: 32px;
            right: 32px;
            top: -1px;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0, 179, 255, 0.16), transparent);
            pointer-events: none;
        }

        .ft {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
        }

        .ft-l {
            font-size: 13px;
            color: var(--text-tertiary);
        }

        .ft-r {
            display: flex;
            gap: 22px;
            font-size: 13px;
            color: var(--text-tertiary);
            flex-wrap: wrap;
        }

        .ft-r a {
            transition: color 0.14s ease;
        }

        .ft-r a:hover {
            color: var(--text-secondary);
        }

        @media (max-width: 1120px) {
            .pricing-v2-panel-scale {
                grid-template-columns: 1fr;
                max-width: 620px;
                margin: 0 auto;
            }

            .pricing-v2-card {
                min-height: auto;
            }

            .pricing-v2-flip-inner,
            .pricing-v2-flip-face {
                min-height: 660px;
            }
        }

        @media (max-width: 760px) {
            .pricing-v2 {
                width: min(calc(100% - 28px), 1180px);
                padding-top: 104px;
            }

            .pricing-v2-hero p {
                max-width: 330px;
                font-size: 16px;
                line-height: 1.5;
                text-wrap: pretty;
            }

            .pricing-v2-toggle {
                width: 100%;
                min-width: 0;
            }

            .pricing-v2-toggle label {
                padding: 0 14px;
            }

            .pricing-v2-panel-launch,
            .pricing-v2-panel-scale {
                grid-template-columns: 1fr;
                max-width: none;
            }

            .pricing-v2-card {
                padding: 24px;
            }

            .pricing-v2-flip-card {
                padding: 0;
            }

            .pricing-v2-flip-inner,
            .pricing-v2-flip-face {
                min-height: 0;
            }

            .pricing-v2-flip-face {
                padding: 24px;
            }

            .scale-calculator-back {
                width: auto;
            }

            .pricing-v2-included-grid {
                grid-template-columns: 1fr;
            }

            footer {
                padding: 24px 16px 32px;
            }

            .ft {
                justify-content: center;
                text-align: center;
            }

            .ft-r {
                justify-content: center;
            }
        }
    </style>
</head>
