---
import '../../public/css/home.css';
import '../../public/css/marketing-shell.css';
import '../../public/css/marketing-forms.css';
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead title="Contact Fluxzero" description="Contact Fluxzero for launch access, pricing questions, partnerships, and product feedback." />
    <style>
        body {
            background:
                radial-gradient(circle at 50% 0%, rgba(255, 150, 76, 0.11), transparent 34%),
                radial-gradient(circle at 78% 18%, rgba(0, 179, 255, 0.08), transparent 28%),
                var(--bg-page-gradient);
        }

        .contact-page {
            min-height: calc(100vh - 118px);
            padding: clamp(118px, 14vh, 154px) 24px clamp(74px, 10vh, 112px);
        }

        .contact-hero {
            max-width: 760px;
            margin: 0 auto clamp(30px, 5vw, 46px);
            text-align: center;
        }

        .contact-page section.contact-hero,
        .contact-page section.contact-card {
            padding: 0;
        }

        .contact-title {
            width: 100%;
            max-width: 760px;
            margin: 0 auto;
            font-size: clamp(42px, 6vw, 64px);
            line-height: 1.04;
            text-align: center;
            text-wrap: balance;
        }

        .contact-title-line {
            display: inline;
        }

        .contact-subtitle {
            max-width: 650px;
            margin: 24px auto 0;
            color: rgba(221, 232, 247, 0.76);
            font-size: clamp(17px, 1.8vw, 20px);
            line-height: 1.68;
        }

        .contact-card {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(260px, 300px);
            width: min(100%, 900px);
            margin: 0 auto;
        }

        .contact-side {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 28px;
            padding: clamp(24px, 3.4vw, 34px);
            border-left: 1px solid rgba(244, 247, 255, 0.075);
            background:
                radial-gradient(circle at 50% 0%, rgba(0, 179, 255, 0.08), transparent 44%),
                rgba(255, 255, 255, 0.018);
        }

        .contact-router {
            position: relative;
            height: 148px;
            border: 1px solid rgba(244, 247, 255, 0.075);
            border-radius: 18px;
            background:
                linear-gradient(rgba(76, 101, 129, 0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(76, 101, 129, 0.035) 1px, transparent 1px),
                rgba(4, 8, 13, 0.34);
            background-size: 22px 22px;
            overflow: hidden;
        }

        .contact-router svg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        .contact-route {
            fill: none;
            stroke: rgba(167, 180, 200, 0.18);
            stroke-width: 1.2;
        }

        .contact-route-live {
            fill: none;
            stroke: url(#contactRouteGradient);
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-dasharray: 44 186;
            animation: contactRoutePulse 3.4s linear infinite;
        }

        .contact-packet {
            fill: #D9F5FF;
            filter: drop-shadow(0 0 8px rgba(0, 179, 255, 0.38));
        }

        .contact-packet--warm {
            fill: #ffb27a;
            filter: drop-shadow(0 0 8px rgba(255, 150, 76, 0.34));
        }

        .contact-router-core {
            position: absolute;
            left: 50%;
            top: 50%;
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            border: 1px solid rgba(217, 245, 255, 0.18);
            border-radius: 14px;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03)),
                rgba(5, 7, 11, 0.76);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 0 28px rgba(0, 179, 255, 0.11);
            transform: translate(-50%, -50%) rotate(45deg);
        }

        .contact-router-core .logo-mark {
            width: 20px;
            height: 22px;
            transform: rotate(-45deg);
        }

        .contact-office {
            display: grid;
            gap: 16px;
        }

        .contact-office dl {
            display: grid;
            gap: 12px;
            margin: 0;
        }

        .contact-office div {
            display: grid;
            gap: 2px;
        }

        .contact-office dt {
            color: var(--text-tertiary);
            font-size: 12px;
        }

        .contact-office dd {
            margin: 0;
            color: rgba(221, 232, 247, 0.84);
            font-size: 14px;
            line-height: 1.55;
        }

        .contact-office dd a {
            color: rgba(217, 245, 255, 0.92);
            text-decoration: underline;
            text-decoration-color: rgba(0, 179, 255, 0.36);
            text-underline-offset: 3px;
            transition: color 0.14s ease, text-decoration-color 0.14s ease;
        }

        .contact-office dd a:hover {
            color: var(--text);
            text-decoration-color: rgba(0, 179, 255, 0.72);
        }

        .contact-side-note {
            color: var(--text-tertiary);
            font-size: 13px;
            line-height: 1.65;
        }

        @keyframes contactRoutePulse {
            from {
                stroke-dashoffset: 0;
            }

            to {
                stroke-dashoffset: -230;
            }
        }

        @media (max-width: 860px) {
            .contact-page {
                padding-top: 104px;
            }

            .contact-card {
                grid-template-columns: 1fr;
            }

            .contact-title {
                font-size: clamp(38px, 10vw, 48px);
            }

            .contact-side {
                border-top: 1px solid rgba(244, 247, 255, 0.075);
                border-left: 0;
            }
        }

        @media (min-width: 861px) {
            .contact-title-line {
                display: block;
            }
        }

        @media (max-width: 520px) {
            .contact-page {
                padding-left: 16px;
                padding-right: 16px;
            }

            .contact-side {
                padding: 22px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .contact-route-live {
                animation: none;
            }

            .contact-packet {
                display: none;
            }
        }
    </style>
</head>
<body>
<MarketingHeader />

<main class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-title">
        <h1 class="contact-title" id="contact-title"><span class="contact-title-line">Get in touch</span></h1>
        <p class="contact-subtitle">
            Questions about Fluxzero, pricing, partnerships, or something else? We’d love to hear from you.
        </p>
    </section>

    <section class="contact-card marketing-form-panel" aria-label="Contact form and other ways to reach us">
        <div class="contact-form-wrap">
            <form action="https://getform.io/f/bejeorxa" id="contactForm" method="POST" class="contact-form" novalidate>
                <div class="contact-form-head">
                    <h2>Send us a note</h2>
                    <p>A few lines are enough. We’ll take it from there.</p>
                </div>

                <input type="hidden" name="_gotcha" style="display:none !important">

                <div class="contact-field">
                    <label for="fn">Full name</label>
                    <input name="name" type="text" id="fn" autocomplete="name" required>
                </div>

                <div class="contact-field">
                    <label for="email">Email address</label>
                    <input name="email" type="email" id="email" autocomplete="email" required>
                </div>

                <div class="contact-field">
                    <label for="message">Message</label>
                    <textarea name="message" id="message" required></textarea>
                </div>

                <button type="submit" id="submitButton" class="btn-p contact-submit">Send</button>
                <div id="formStatus" class="form-status" aria-live="polite"></div>
            </form>
        </div>

        <aside class="contact-side" aria-label="Other ways to reach Fluxzero">
            <div class="contact-router" aria-hidden="true">
                <svg viewBox="0 0 280 148">
                    <defs>
                        <linearGradient id="contactRouteGradient" x1="0" x2="1" y1="0" y2="0">
                            <stop offset="0%" stop-color="#D9F5FF" stop-opacity="0"/>
                            <stop offset="45%" stop-color="#00B3FF" stop-opacity="0.85"/>
                            <stop offset="100%" stop-color="#FF964C" stop-opacity="0"/>
                        </linearGradient>
                        <path id="contactRouteTop" d="M24 36 C78 18 92 74 138 74 S204 25 256 42"/>
                        <path id="contactRouteMiddle" d="M24 74 H256"/>
                        <path id="contactRouteBottom" d="M24 112 C78 130 92 74 138 74 S204 123 256 106"/>
                    </defs>
                    <use href="#contactRouteTop" class="contact-route"></use>
                    <use href="#contactRouteMiddle" class="contact-route"></use>
                    <use href="#contactRouteBottom" class="contact-route"></use>
                    <use href="#contactRouteTop" class="contact-route-live"></use>
                    <use href="#contactRouteMiddle" class="contact-route-live"></use>
                    <use href="#contactRouteBottom" class="contact-route-live"></use>
                    <rect class="contact-packet" width="7" height="7" rx="2" x="-3.5" y="-3.5">
                        <animateMotion dur="3.2s" repeatCount="indefinite" rotate="auto">
                            <mpath href="#contactRouteTop"></mpath>
                        </animateMotion>
                    </rect>
                    <rect class="contact-packet contact-packet--warm" width="7" height="7" rx="2" x="-3.5" y="-3.5">
                        <animateMotion dur="2.8s" begin="-1.1s" repeatCount="indefinite" rotate="auto">
                            <mpath href="#contactRouteMiddle"></mpath>
                        </animateMotion>
                    </rect>
                    <rect class="contact-packet" width="7" height="7" rx="2" x="-3.5" y="-3.5">
                        <animateMotion dur="3.6s" begin="-2s" repeatCount="indefinite" rotate="auto">
                            <mpath href="#contactRouteBottom"></mpath>
                        </animateMotion>
                    </rect>
                </svg>
                <div class="contact-router-core">
                    <span class="logo-mark" aria-hidden="true"></span>
                </div>
            </div>

            <div class="contact-office">
                <dl>
                    <div>
                        <dt>Member of the press?</dt>
                        <dd>Send us a note <a href="mailto:press@fluxzero.io">here</a>.</dd>
                    </div>
                    <div>
                        <dt>Careers</dt>
                        <dd>Introduce yourself <a href="mailto:careers@fluxzero.io">here</a>.</dd>
                    </div>
                    <div>
                        <dt>Partnerships</dt>
                        <dd>Become a partner <a href="/partners/">here</a>.</dd>
                    </div>
                </dl>
            </div>

            <p class="contact-side-note">Messages are read by the people building Fluxzero.</p>
        </aside>
    </section>
</main>

<MarketingFooter />

<script src="../scripts/contact-form.ts"></script>
</body>
</html>
