---
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import 'boxicons/css/boxicons.min.css';

const contextBenefits = [
    {
        number: '01',
        icon: 'bx-code-alt',
        title: 'The product stays visible',
        copy: 'The application describes the product in its own terms, not through technical layers.',
    },
    {
        number: '02',
        icon: 'bx-history',
        title: 'A complete history',
        copy: 'Every interaction keeps its context, so you can trace what caused a problem.',
    },
    {
        number: '03',
        icon: 'bx-refresh',
        title: 'Fix and replay',
        copy: 'After a fix, affected work can be replayed without rebuilding the application around it.',
    },
    {
        number: '04',
        icon: 'bx-shield-quarter',
        title: 'Test the behavior',
        copy: 'Your agent can prove what a change does without setting up infrastructure first.',
    },
];

const cloudLayers = [
    { name: 'Model', icon: 'bx-cube', items: ['State', 'history', 'relationships', 'search'] },
    { name: 'Interaction', icon: 'bx-transfer-alt', items: ['Commands', 'events', 'queries', 'HTTP & WebSocket', 'schedules'] },
    { name: 'Policy', icon: 'bx-shield-quarter', items: ['Validation', 'authorization', 'invariants', 'data protection'] },
    { name: 'Cloud', icon: 'bx-layer', items: ['Cross-app routing', 'ordering', 'concurrency', 'recovery', 'observability', 'scale'] },
];

const javaExample = `<span class="tok-annotation">@Model</span>
<span class="tok-keyword">record</span> <span class="tok-type">Project</span>(
    <span class="tok-annotation">@EntityId</span> <span class="tok-type">ProjectId</span> <span class="tok-field">projectId</span>,
    <span class="tok-type">String</span> <span class="tok-field">name</span>) {}

<span class="tok-annotation">@Model</span>
<span class="tok-keyword">record</span> <span class="tok-type">Task</span>(
    <span class="tok-annotation">@EntityId</span> <span class="tok-type">TaskId</span> <span class="tok-field">taskId</span>,
    <span class="tok-annotation">@Parent</span>(pathInParent = <span class="tok-string">"tasks"</span>)
    <span class="tok-type">ProjectId</span> <span class="tok-field">projectId</span>,
    <span class="tok-type">String</span> <span class="tok-field">title</span>,
    <span class="tok-annotation">@With</span> <span class="tok-keyword">boolean</span> <span class="tok-field">completed</span>) {}

<span class="tok-keyword">record</span> <span class="tok-type">CompleteTask</span>(<span class="tok-type">TaskId</span> <span class="tok-field">taskId</span>) {
    <span class="tok-annotation">@AssertLegal</span>
    <span class="tok-keyword">void</span> <span class="tok-method">assertOpen</span>(<span class="tok-type">Task</span> task) {
        <span class="tok-keyword">if</span> (task.<span class="tok-method">completed</span>()) {
            <span class="tok-keyword">throw</span> <span class="tok-type">TaskErrors</span>.alreadyCompleted;
        }
    }

    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">Task</span> <span class="tok-method">apply</span>(<span class="tok-type">Task</span> task) {
        <span class="tok-keyword">return</span> task.<span class="tok-call">withCompleted</span>(<span class="tok-literal">true</span>);
    }
}`;

const testExample = `<span class="tok-annotation">@Test</span>
<span class="tok-keyword">void</span> <span class="tok-method">completeEmitsEvent</span>() {
    <span class="tok-field">testFixture</span>.<span class="tok-call">givenCommands</span>(
        <span class="tok-string">"create-project.json"</span>,
        <span class="tok-string">"create-task.json"</span>)
        .<span class="tok-call">whenCommand</span>(
            <span class="tok-string">"complete-task.json"</span>)
        .<span class="tok-call">expectEvents</span>(
            <span class="tok-string">"complete-task.json"</span>);
}`;

const comparisonRows = [
    {
        label: 'Application architecture',
        icon: 'bx-code-alt',
        other: 'Product behavior plus services, adapters and infrastructure architecture',
        fluxzero: 'Product behavior only',
    },
    {
        label: 'State and history',
        icon: 'bx-data',
        other: 'You design schemas, queries and transaction boundaries; state is stored as current snapshots unless you build history',
        fluxzero: 'Model state, relationships and complete history are built in',
    },
    {
        label: 'Coordination',
        icon: 'bx-transfer-alt',
        other: 'App code owns routing, concurrency, ordering and cross-service coordination',
        fluxzero: 'The cloud routes, orders and coordinates every interaction',
    },
    {
        label: 'Failure and recovery',
        icon: 'bx-shield-quarter',
        other: 'You build retries and recovery paths; crashes can still lose in-flight work',
        fluxzero: 'Durable delivery, replay and recovery are built into the cloud',
    },
    {
        label: 'Ingress and networking',
        icon: 'bx-network-chart',
        other: 'You assemble and secure gateways, proxies, service networking and discovery',
        fluxzero: 'One secured application boundary, handled by the cloud',
    },
    {
        label: 'Scale and operations',
        icon: 'bx-layer',
        other: 'Configure, connect, scale, monitor and operate every component and service',
        fluxzero: 'Distribution, backpressure, observability and scale are automatic',
    },
];

const comparisonOptions = [
    { name: 'Other clouds', sub: 'Supabase + Vercel, Railway and similar clouds', key: 'other', featured: false },
    { name: 'Fluxzero', sub: 'The product cloud', key: 'fluxzero', featured: true },
] as const;

const choiceOptions = [
    {
        title: 'Fluxzero',
        icon: 'bx-check-circle',
        copy: 'For builders who want to focus on product features and expect the technology underneath to just work.',
    },
    {
        title: 'A component cloud',
        icon: 'bx-circle',
        copy: 'For engineering teams that want full control over how their infrastructure is designed and operated, from service topology to capacity planning and failure recovery.',
    },
];

---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead
        title="Inside Fluxzero — The application cloud"
        description="See how Fluxzero keeps infrastructure out of your application so people and AI agents can focus on building the product."
    />
    <link rel="stylesheet" href="/css/v4.css?v=20260902-2">
    <link rel="stylesheet" href="/css/agents.css?v=20260905-1">
    <link rel="stylesheet" href="/css/marketing-shell.css?v=20260903-1">
</head>
<body class="v4-page agent4-page">
    <MarketingHeader active="how-it-works" />

<main>
    <section class="agent4-hero" aria-labelledby="agent4-title">
        <img class="agent4-hero__backdrop" src="/assets/fluxzero/agent-hero-horizon.png" alt="" aria-hidden="true">
        <div class="v4-shell agent4-hero__inner">
            <div class="agent4-hero__copy">
                <h1 id="agent4-title" data-reveal>AI lets anyone build products.<br><span>Time for the cloud to catch up.</span></h1>
                <p data-reveal data-reveal-delay="1">Fluxzero is the cloud for this new generation of builders.<br>You decide what to build. Your agent builds it. Fluxzero makes it run.</p>
                <div class="v4-actions agent4-hero__actions" data-reveal data-reveal-delay="2">
                    <a class="v4-button v4-button--primary" href="/get-started">Get started <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                    <a class="v4-button v4-button--secondary" href="/docs">Read the technical docs</a>
                </div>
            </div>
        </div>
    </section>

    <section class="agent4-bottleneck agent4-canvas-section" aria-labelledby="bottleneck-title">
        <div class="v4-shell agent4-bottleneck__layout">
            <div class="agent4-bottleneck__copy" data-reveal>
                <h2 id="bottleneck-title">More products should not mean<br><span>more infrastructure.</span></h2>
                <p>Traditional clouds were designed for engineering teams building and operating one product at a time. As AI creates more products, duplicating the same backend for each one no longer makes sense.</p>
            </div>
            <div class="agent4-duplication" data-reveal data-reveal-delay="1" aria-label="More products create more duplicated technical foundations on traditional clouds">
                {['Product 1', 'Product 2', 'Product 3', 'Product N'].map((product, index, products) => (
                    <>
                        {index === products.length - 1 && <div class="agent4-duplication__ellipsis" aria-hidden="true"><span></span><span></span><span></span></div>}
                        <article class="agent4-private-stack">
                            <h3 class="agent4-product-node"><i class="bx bx-cube-alt" aria-hidden="true"></i><span>{product}</span></h3>
                            <div class="agent4-stack-line" aria-hidden="true"></div>
                            <ul class="agent4-stack-box"><li class="is-product">Unique product logic</li><li>Services &amp; workers</li><li>Persistence</li><li>Messaging &amp; recovery</li><li>Gateways &amp; proxies</li><li>Load balancing</li><li>Security &amp; discovery</li><li>Observability</li><li>Deployment</li></ul>
                        </article>
                    </>
                ))}
            </div>
        </div>
    </section>

    <section class="agent4-boundary agent4-canvas-section" id="application-model" aria-labelledby="boundary-title">
        <div class="v4-shell agent4-boundary__layout">
            <header class="agent4-boundary__copy" data-reveal>
                <h2 id="boundary-title">Your product should be<br><span>the whole application.</span></h2>
                <p class="agent4-boundary__note">Traditional applications mix product features with the technical work needed to run them. With Fluxzero, the application contains only what makes the product unique. The cloud handles the rest.</p>
            </header>
            <div class="agent4-boundary__diagram" data-reveal data-reveal-delay="1">
                <article class="agent4-boundary__side agent4-boundary__side--traditional">
                    <div class="agent4-boundary__label"><strong>Inside a traditional application</strong><small>Everything below ships as part of the app</small></div>
                    <ul class="agent4-app-stack"><li class="is-product"><i class="bx bx-cube-alt" aria-hidden="true"></i> Product behavior</li><li>Service wiring and orchestration</li><li>Integration adapters</li><li>Persistence code and schemas</li><li>Retry and recovery paths</li><li>Ingress and service networking</li><li>Observability plumbing</li><li>Deployment topology</li></ul>
                </article>
                <i class="bx bx-right-arrow-alt agent4-boundary__arrow" aria-hidden="true"></i>
                <article class="agent4-boundary__side agent4-boundary__side--fluxzero">
                    <div class="agent4-boundary__label"><strong>Fluxzero application</strong></div>
                    <div class="agent4-product-box"><strong><i class="bx bx-cube-alt" aria-hidden="true"></i> Product behavior</strong></div>
                    <div class="agent4-cloud-box">
                        <div class="agent4-cloud-box__brand"><span class="logo-mark" aria-hidden="true"></span><strong>fluxzero <em>cloud</em></strong></div>
                        <ul class="agent4-cloud-box__items"><li><i class="bx bx-data" aria-hidden="true"></i>State &amp; history</li><li><i class="bx bx-transfer-alt" aria-hidden="true"></i>Message delivery</li><li><i class="bx bx-search" aria-hidden="true"></i>Search</li><li><i class="bx bx-check-shield" aria-hidden="true"></i>Policy enforcement</li><li><i class="bx bx-refresh" aria-hidden="true"></i>Replay &amp; recovery</li><li><i class="bx bx-bar-chart-alt-2" aria-hidden="true"></i>Observability</li><li><i class="bx bx-git-branch" aria-hidden="true"></i>Runtime routing</li><li><i class="bx bx-cloud-upload" aria-hidden="true"></i>Deployment &amp; scale</li></ul>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="agent4-layers agent4-canvas-section" aria-labelledby="layers-title">
        <div class="v4-shell agent4-layers__layout">
            <header class="agent4-layers__copy" data-reveal>
                <h2 id="layers-title">Everything your product<br><span>needs to run.</span></h2>
                <p>Built into Fluxzero, instead of assembled separately for every product.</p>
            </header>
            <div class="agent4-layer-list" data-reveal data-reveal-delay="1">
                {cloudLayers.map((layer) => (
                    <article>
                        <i class={`bx ${layer.icon}`} aria-hidden="true"></i>
                        <h3>{layer.name}</h3>
                        <p>{layer.items.join(' / ')}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="agent4-context agent4-canvas-section" aria-labelledby="context-title">
        <div class="v4-shell agent4-context__layout">
            <div class="agent4-context__copy" data-reveal>
                <h2 id="context-title">Let your agent<br><span>build the product.</span></h2>
                <p>Fluxzero keeps infrastructure out of the application, so your agent can focus on what the product should do.</p>
            </div>
            <div class="agent4-context__rail" data-reveal data-reveal-delay="1">
                {contextBenefits.map((benefit, index) => (
                    <article data-number={benefit.number}>
                        <div class="agent4-context__node" aria-hidden="true"></div>
                        <i class={`bx ${benefit.icon}`} aria-hidden="true"></i>
                        <h3>{benefit.title}</h3>
                        <p>{benefit.copy}</p>
                        {index < contextBenefits.length - 1 && <i class="bx bx-right-arrow-alt agent4-context__arrow" aria-hidden="true"></i>}
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="agent4-code agent4-canvas-section" aria-labelledby="behavior-title">
        <div class="v4-shell agent4-code__layout">
            <header class="agent4-code__copy" data-reveal>
                <h2 id="behavior-title">The code describes<br><span>the product.</span></h2>
                <p>Your product&rsquo;s behavior stays visible in the application. Fluxzero keeps the infrastructure out of the way.</p>
                <a class="agent4-code__docs" href="/docs">Read the technical docs <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
            </header>
            <div class="agent4-code__examples" data-reveal data-reveal-delay="1">
                <figure class="agent4-code__sample">
                    <figcaption class="agent4-code__bar"><strong>ProjectTasks</strong><small>Java</small></figcaption>
                    <pre><code class="language-java" set:html={javaExample}></code></pre>
                </figure>
                <figure class="agent4-code__test">
                    <figcaption class="agent4-code__bar"><strong>CompleteTaskTest</strong><small>Test</small></figcaption>
                    <pre><code class="language-java" set:html={testExample}></code></pre>
                </figure>
            </div>
        </div>
    </section>

    <section class="agent4-comparison agent4-canvas-section" id="evidence" aria-labelledby="comparison-title">
        <div class="v4-shell">
            <header class="agent4-comparison__heading" data-reveal>
                <h2 id="comparison-title">See what your application<br><span>is responsible for.</span></h2>
                <p>With other clouds, your application includes the product and the infrastructure around it. With Fluxzero, it contains only the product.</p>
            </header>
            <div class="agent4-comparison__table" data-reveal data-reveal-delay="1" role="table" aria-label="Comparison of application responsibilities">
                <div class="agent4-comparison__row agent4-comparison__head" role="row">
                    <div role="columnheader"><span class="sr-only">Responsibility</span></div>
                    {comparisonOptions.map((option) => (
                        <div class:list={[{ 'is-fluxzero': option.featured }]} role="columnheader"><strong>{option.name}</strong><small>{option.sub}</small></div>
                    ))}
                </div>
                {comparisonRows.map((row) => (
                    <div class="agent4-comparison__row" role="row">
                        <div role="rowheader"><i class={`bx ${row.icon}`} aria-hidden="true"></i><strong>{row.label}</strong></div>
                        <div role="cell" data-label="Other clouds"><span class="agent4-comparison__mark" aria-hidden="true">—</span>{row.other}</div>
                        <div class="is-fluxzero" role="cell" data-label="Fluxzero"><span class="agent4-comparison__mark is-included" aria-hidden="true">✓</span>{row.fluxzero}</div>
                    </div>
                ))}
            </div>
            <div class="agent4-comparison__mobile" data-reveal data-reveal-delay="1">
                {comparisonOptions.map((option) => (
                    <details class:list={[{ 'is-fluxzero': option.featured }]} open={option.featured}>
                        <summary><span><strong>{option.name}</strong><small>{option.sub}</small></span><i class="bx bx-chevron-down" aria-hidden="true"></i></summary>
                        <dl>{comparisonRows.map((row) => <><dt>{row.label}</dt><dd>{row[option.key]}</dd></>)}</dl>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <section class="agent4-compounding agent4-canvas-section" aria-labelledby="compounding-title">
        <div class="v4-shell agent4-compounding__layout">
            <header class="agent4-compounding__copy" data-reveal>
                <h2 id="compounding-title">Fluxzero improves.<br><span>Every product benefits.</span></h2>
                <p>Every improvement to Fluxzero reaches your product automatically. You do not have to rebuild or migrate it.</p>
            </header>
            <div class="agent4-compounding__visual" data-reveal data-reveal-delay="1" aria-label="One Fluxzero improvement reaches every product">
                <div class="agent4-compounding__cloud"><div><span class="logo-mark" aria-hidden="true"></span><strong>fluxzero</strong><small>Shared cloud runtime</small></div></div>
                <div class="agent4-compounding__connector"><small>Continuously improved</small><span><i class="bx bx-right-arrow-alt" aria-hidden="true"></i></span></div>
                <ul class="agent4-compounding__improvements">
                    <li><i class="bx bx-tachometer" aria-hidden="true"></i>Performance</li><li><i class="bx bx-shield-quarter" aria-hidden="true"></i>Hardening</li><li><i class="bx bx-bar-chart-alt-2" aria-hidden="true"></i>Operational insight</li><li><i class="bx bx-refresh" aria-hidden="true"></i>Recovery</li>
                </ul>
                <div class="agent4-compounding__connector"><small>Inherited automatically</small><span><i class="bx bx-right-arrow-alt" aria-hidden="true"></i></span></div>
                <div class="agent4-compounding__products"><small>Every product</small><div>{Array.from({ length: 8 }).map(() => <i class="bx bx-cube-alt" aria-hidden="true"></i>)}</div></div>
            </div>
        </div>
    </section>

    <section class="agent4-decision agent4-canvas-section" aria-labelledby="decision-title">
        <div class="v4-shell">
            <header class="agent4-decision__heading" data-reveal>
                <h2 id="decision-title">When to choose <span>Fluxzero.</span></h2>
                <p>Choose Fluxzero when you want to build the product, not the platform required to run it.</p>
            </header>
            <div class="agent4-decision__options" data-reveal data-reveal-delay="1">
                {choiceOptions.map((option) => (
                    <article>
                        <i class={`bx ${option.icon}`} aria-hidden="true"></i>
                        <div>
                            <h3>{option.title}</h3>
                            <p>{option.copy}</p>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="agent4-final agent4-canvas-section" aria-labelledby="final-title">
        <div class="v4-shell agent4-final__inner">
            <h2 id="final-title" data-reveal>Build what matters.<br>Let the cloud <span>carry the rest.</span></h2>
            <div class="v4-actions" data-reveal data-reveal-delay="1">
                <a class="v4-button v4-button--primary" href="/get-started">Get started <i class="bx bx-right-arrow-alt" aria-hidden="true"></i></a>
                <a class="v4-button v4-button--secondary" href="/docs">Explore the technical model</a>
            </div>
        </div>
    </section>
</main>

<MarketingFooter />
<script src="/js/v4.js?v=20260904-3" defer></script>
</body>
</html>
