---
import BrandHead from '../components/BrandHead.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';

const instruction = 'Use Fluxzero for my app. Ensure its plugin at https://github.com/fluxzero-io/fluxzero-agent-integrations is installed and available. If setup needs action from me, tell me what to do and stop. Otherwise, ask for my app requirements.';
const javaExample = `@HandleCommand
@RequiresUser
OrderId place(PlaceOrder command) {
    var order = Order.place(command);
    Fluxzero.apply(order);
    return order.id();
}`;

const capabilities = [
    {
        number: '01',
        title: 'One model for every interaction',
        copy: 'Commands, events, queries, web requests and schedules use the same handling, routing and tracking model.',
        items: ['Commands', 'Events', 'Queries', 'Web', 'Schedules'],
    },
    {
        number: '02',
        title: 'State without database plumbing',
        copy: 'Model product entities directly. Fluxzero handles persistence, event history, document projections and search.',
        items: ['Models', 'Persistence', 'Indexing', 'Search', 'Evolution'],
    },
    {
        number: '03',
        title: 'Correctness at the boundary',
        copy: 'Payload validation and user or role access are enforced before behavior runs. Sensitive fields can be protected automatically.',
        items: ['Validate', 'Authenticate', 'Authorize', 'Protect', 'Handle'],
    },
    {
        number: '04',
        title: 'Test behavior, not infrastructure',
        copy: 'The fixture runs handlers and HTTP behavior in memory, with the same product model used in production.',
        items: ['Arrange', 'Dispatch', 'Assert result', 'Assert events', 'No stack'],
    },
    {
        number: '05',
        title: 'Failure stays recoverable',
        copy: 'Messages keep their context. Tracking, error logs, replay and the dead-letter flow make failures visible and recoverable.',
        items: ['Trace', 'Correlate', 'Retry', 'Replay', 'Recover'],
    },
    {
        number: '06',
        title: 'Same model from local to scale',
        copy: 'Run against an in-memory Fluxzero server locally, then let the runtime route, balance and apply backpressure in the cloud.',
        items: ['Local', 'Deploy', 'Route', 'Balance', 'Scale'],
    },
];

const agentRows = [
    {
        label: 'Application model',
        supabase: 'Design schema, APIs and frontend/backend boundaries',
        railway: 'Design services, processes and their boundaries',
        fluxzero: 'Define product behavior and domain models',
    },
    {
        label: 'Persistence',
        supabase: 'Schema, migrations, policies and queries',
        railway: 'Provision databases, connections and backups',
        fluxzero: 'Choose the model; persistence and search follow',
    },
    {
        label: 'Security',
        supabase: 'Configure auth, RLS and service integration',
        railway: 'Configure auth, secrets, networking and app policy',
        fluxzero: 'Declare access and validation at the boundary',
    },
    {
        label: 'Testing',
        supabase: 'Run the local stack and integration tests',
        railway: 'Provide test services, data and CI harnesses',
        fluxzero: 'Test complete behavior in memory with fixtures',
    },
    {
        label: 'Recovery',
        supabase: 'Correlate behavior across platform and services',
        railway: 'Combine logs, retries, backups and app logic',
        fluxzero: 'Trace, replay and recover from the message history',
    },
    {
        label: 'Scale and operations',
        supabase: 'Manage the limits and shape of each service',
        railway: 'Scale and operate each deployed service',
        fluxzero: 'Runtime routing, load balancing and backpressure',
    },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <BrandHead
        title="Fluxzero for coding agents — Technical platform brief"
        description="A compact technical brief for AI coding agents evaluating Fluxzero's application model, persistence, security, testing and runtime."
    />
    <link rel="stylesheet" href="/css/v4.css?v=20260902-1">
    <link rel="stylesheet" href="/css/marketing-shell.css?v=20260902-1">
</head>
<body class="v4-page v4-agent-page">
<MarketingHeader active="agents" />

<main>
    <section class="agent-hero" aria-labelledby="agent-title">
        <div class="v4-shell agent-hero__grid">
            <div class="agent-hero__copy">
                <h1 id="agent-title">A smaller problem<br><span>for your agent to solve.</span></h1>
                <p>Describe product behavior. Fluxzero supplies the application model, persistence, security, testing, observability and runtime underneath.</p>

                <div class="agent-instruction">
                    <div class="agent-instruction__bar"><span>fluxzero-agent.txt</span><button type="button" data-copy-instruction>Copy</button></div>
                    <div class="agent-instruction__code"><code id="agent-instruction-text">{instruction}</code></div>
                    <p class="agent-instruction__status" data-copy-status role="status" aria-live="polite"></p>
                </div>
            </div>

            <div class="agent-map" aria-label="Inputs handled by the Fluxzero application cloud">
                <div class="agent-map__inputs">
                    <span>Web</span><span>API</span><span>Agent</span><span>Schedule</span><span>Event</span>
                </div>
                <div class="agent-map__core"><strong>FZ</strong><small>product behavior</small></div>
                <div class="agent-map__platform">
                    <span>Application model</span><span>Persistence</span><span>Security</span><span>Testing</span><span>Observability</span><span>Runtime</span>
                </div>
            </div>
        </div>
    </section>

    <section class="agent-capabilities v4-section" aria-labelledby="capabilities-title">
        <div class="v4-shell">
            <header class="v4-section-heading v4-section-heading--left agent-section-heading">
                <p class="v4-kicker">The application layer</p>
                <h2 id="capabilities-title">What disappears<br><span>from the agent’s workload.</span></h2>
                <p>Six platform concerns become one coherent programming model instead of six separate integration projects.</p>
            </header>

            <div class="agent-capability-grid">
                {capabilities.map((capability) => (
                    <article>
                        <p class="v4-number">{capability.number}</p>
                        <h3>{capability.title}</h3>
                        <p>{capability.copy}</p>
                        <div class="agent-capability__flow" aria-hidden="true">
                            {capability.items.map((item, index) => (
                                <><span>{item}</span>{index < capability.items.length - 1 && <i>→</i>}</>
                            ))}
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="agent-code v4-section" aria-labelledby="code-title">
        <div class="v4-shell agent-code__layout">
            <div>
                <p class="v4-kicker">Product behavior in code</p>
                <h2 id="code-title">The handler says<br><span>what should happen.</span></h2>
                <p>Validation and access are applied before the behavior runs. Persistence, routing and tracing do not appear in the product code.</p>
                <a href="https://github.com/fluxzero-io/fluxzero-sdk-java/blob/2.0.0-RC4/README.md" target="_blank" rel="noreferrer">Read the SDK reference <span aria-hidden="true">↗</span></a>
            </div>
            <div class="agent-code__sample" role="img" aria-label="Fluxzero Java example"><code>{javaExample}</code></div>
        </div>
    </section>

    <section class="agent-comparison v4-section" id="technical-comparison" aria-labelledby="agent-comparison-title">
        <div class="v4-shell">
            <header class="v4-section-heading v4-section-heading--center">
                <p class="v4-kicker">Agent workload</p>
                <h2 id="agent-comparison-title">What must the agent<br><span>generate and operate?</span></h2>
                <p>The distinction is not whether a platform can deploy software. It is how much application architecture remains inside the product.</p>
            </header>

            <div class="v4-comparison__table agent-comparison__table" role="table" aria-label="Technical comparison of agent workload">
                <div class="v4-comparison__row v4-comparison__head" role="row">
                    <div role="columnheader"><span class="sr-only">Technical concern</span></div>
                    <div role="columnheader"><strong>Supabase + Vercel</strong><span>Compose services</span></div>
                    <div role="columnheader"><strong>Railway</strong><span>Operate services</span></div>
                    <div class="is-fluxzero" role="columnheader"><strong>Fluxzero</strong><span>Express behavior</span></div>
                </div>
                {agentRows.map((row) => (
                    <div class="v4-comparison__row" role="row">
                        <div class="v4-comparison__label" role="rowheader">{row.label}</div>
                        <div role="cell" data-label="Supabase + Vercel">{row.supabase}</div>
                        <div role="cell" data-label="Railway">{row.railway}</div>
                        <div class="is-fluxzero" role="cell" data-label="Fluxzero"><span class="v4-check" aria-hidden="true">✓</span>{row.fluxzero}</div>
                    </div>
                ))}
            </div>

            <div class="agent-sources">
                <p>Compared against public platform documentation, checked September 2026:</p>
                <a href="https://supabase.com/docs/guides/platform" target="_blank" rel="noreferrer">Supabase platform ↗</a>
                <a href="https://supabase.com/docs/guides/local-development" target="_blank" rel="noreferrer">Supabase local development ↗</a>
                <a href="https://vercel.com/docs" target="_blank" rel="noreferrer">Vercel docs ↗</a>
                <a href="https://docs.railway.com/services" target="_blank" rel="noreferrer">Railway services ↗</a>
                <a href="https://docs.railway.com/deployments/scaling" target="_blank" rel="noreferrer">Railway scaling ↗</a>
                <a href="https://docs.railway.com/overview/production-readiness-checklist" target="_blank" rel="noreferrer">Railway production readiness ↗</a>
            </div>
        </div>
    </section>

    <section class="agent-links v4-section" aria-label="Next steps">
        <div class="v4-shell agent-links__grid">
            <a href="https://github.com/fluxzero-io/fluxzero-sdk-java/blob/2.0.0-RC4/README.md" target="_blank" rel="noreferrer">
                <span>Reference</span><strong>Read the SDK README</strong><i aria-hidden="true">↗</i>
            </a>
            <a href="/docs">
                <span>Documentation</span><strong>Explore the technical model</strong><i aria-hidden="true">→</i>
            </a>
            <a href="/start-building">
                <span>Build</span><strong>Start with a product idea</strong><i aria-hidden="true">→</i>
            </a>
        </div>
    </section>
</main>

<MarketingFooter />
<script src="/js/v4.js?v=20260902-1" defer></script>
</body>
</html>
