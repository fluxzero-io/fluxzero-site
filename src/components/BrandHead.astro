---
import { marketingPages, normalizePath } from '../../scripts/core-pages.mjs';
import { fluxzeroBrand, fluxzeroLogoCssUrl } from '../config/brand.mjs';

interface Props {
    title: string;
    description?: string;
    image?: string;
    imageAlt?: string;
}

const siteUrl = 'https://fluxzero.io';
const {
    title,
    description,
    image = fluxzeroBrand.socialImage,
    imageAlt = 'Fluxzero — The European cloud for AI-built apps',
} = Astro.props;
const brandCss = `:root{--fluxzero-logo-url:${fluxzeroLogoCssUrl};}`;
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const markdownPath = marketingPages.includes(normalizePath(Astro.url.pathname)) ? `${normalizePath(Astro.url.pathname)}index.md` : undefined;
const imageUrl = new URL(image, siteUrl).toString();
---

<title>{title}</title>
{description && <meta name="description" content={description}>}
<link rel="canonical" href={pageUrl}>
{markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} title="Markdown version of this page">}
<link rel="describedby" href="/llms.txt" title="Fluxzero site content for AI agents">
<link rel="alternate" type="text/plain" href="/llms-full.txt" title="Complete Fluxzero site content for AI agents">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Fluxzero">
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description}>}
<meta property="og:url" content={pageUrl}>
<meta property="og:image" content={imageUrl}>
<meta property="og:image:secure_url" content={imageUrl}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={imageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
{description && <meta name="twitter:description" content={description}>}
<meta name="twitter:image" content={imageUrl}>
<meta name="twitter:image:alt" content={imageAlt}>
<link rel="icon" href={fluxzeroBrand.faviconIco} sizes="16x16 32x32 48x48">
<link rel="icon" href={fluxzeroBrand.favicon32} sizes="32x32" type="image/png">
<link rel="icon" href={fluxzeroBrand.faviconSvg} sizes="any" type="image/svg+xml">
<link rel="apple-touch-icon" href={fluxzeroBrand.appleTouchIcon} sizes="180x180">
<link rel="mask-icon" href={fluxzeroBrand.safariPinnedTab} color="#2f78b6">
<link rel="manifest" href={fluxzeroBrand.webManifest}>
<meta name="msapplication-config" content={fluxzeroBrand.browserConfig}>
<meta name="theme-color" content="#05070B">
<style is:inline set:html={brandCss} />
