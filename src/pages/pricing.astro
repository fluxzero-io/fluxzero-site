<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fluxzero Pricing — Build free. Launch, then run.</title>
    <meta name="description" content="Fluxzero pricing for builders: build locally for free, put your app online with Starter, then run with Startup, Scale Up, or Enterprise.">
    <link rel="icon" href="/assets/fluxzero-logo-beb2804d3a4248cf9e5d05937269bfc6.svg" type="image/svg+xml">
    <style>
        @font-face {
            font-family: 'Google Sans Flex';
            src: url('/fonts/google-sans-flex/GoogleSansFlex-Black.ttf') format('truetype');
            font-weight: 900;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Inter';
            src: url('/fonts/inter/Inter-Regular.ttf') format('truetype');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }

        :root {
            --bg: #05070B;
            --bg-elevated: #0A0F17;
            --bg-card: #101826;
            --surface-panel: rgba(12, 13, 16, 0.92);
            --bg-page-gradient: linear-gradient(to top right, #1E1E22 0%, #000000 100%);
            --border: #1A2433;
            --border-subtle: rgba(26, 36, 51, 0.72);
            --text: #F4F7FF;
            --text-secondary: #A7B4C8;
            --text-tertiary: #6E7C93;
            --accent: #00B3FF;
            --accent-strong: #00B3FF;
            --accent-deep: #2086F0;
            --accent-secondary: #2086F0;
            --accent-secondary-soft: #6CCBFF;
            --accent-secondary-deep: #1B6ED0;
            --gradient-blue: linear-gradient(135deg, #2086F0 0%, #00B3FF 100%);
            --gradient-blue-soft: linear-gradient(135deg, rgba(32, 134, 240, 0.18) 0%, rgba(0, 179, 255, 0.08) 100%);
            --blue-soft: rgba(0, 179, 255, 0.86);
            --cyan-soft: rgba(32, 134, 240, 0.86);
            --surface-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
            --surface-shadow-hover: 0 14px 28px rgba(0, 0, 0, 0.28);
            --accent-glow: 0 0 16px rgba(0, 179, 255, 0.16);
            --fluxzero-logo-url: url('/assets/fluxzero-logo-beb2804d3a4248cf9e5d05937269bfc6.svg');
            --font-body: 'Inter', -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro", system-ui, sans-serif;
            --font-display: 'Google Sans Flex', sans-serif;
            --font-mono: 'Inter', -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro", system-ui, sans-serif;
            --max-w: 1120px;
            --section-pad: clamp(72px, 8vw, 104px);
            --stack-tight: 12px;
            --stack-medium: clamp(24px, 3vw, 28px);
            --stack-follow: clamp(28px, 3.5vw, 36px);
            --fs-body: 15px;
            --fs-body-strong: 16px;
            --fs-body-secondary: 14px;
            --fs-card-title: 15.5px;
            --fs-section-title: clamp(28px, 3vw, 34px);
            --fs-hero-title: clamp(40px, 6vw, 58px);
            --lh-heading: 1.08;
            --lh-body: 1.65;
            --lh-card: 1.6;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            position: relative;
            background: transparent;
            color: var(--text);
            font-family: var(--font-body);
            font-size: var(--fs-body);
            line-height: var(--lh-body);
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background: var(--bg-page-gradient);
            background-repeat: no-repeat;
            background-size: 100vw 100vh;
            opacity: 0.96;
        }

        ::selection { background: rgba(0, 179, 255, 0.9); color: #140a18; }
        a { color: inherit; text-decoration: none; }

        h1, h2, h3 {
            font-family: var(--font-display);
            font-weight: 900;
            letter-spacing: -0.03em;
            line-height: 1.05;
        }

        p {
            color: rgba(244, 247, 255, 0.84);
            line-height: var(--lh-body);
            font-weight: 400;
        }

        .eyebrow {
            font-family: var(--font-mono);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.16em;
            color: var(--blue-soft);
        }

        .page-shell {
            width: min(calc(100% - 32px), var(--max-w));
            margin: 0 auto;
        }

        .nav-shell {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            min-height: 72px;
            padding: 0 32px;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)),
                rgba(5, 7, 11, 0.42);
            border-bottom: 1px solid rgba(255, 255, 255, 0.14);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 18px 46px rgba(0, 0, 0, 0.18);
            backdrop-filter: blur(26px) saturate(150%);
            -webkit-backdrop-filter: blur(26px) saturate(150%);
        }

        .nav-logo-wrap {
            display: inline-flex;
            align-items: center;
            justify-content: flex-start;
            gap: 10px;
            min-height: 72px;
            padding: 0;
            flex: 0 0 auto;
        }

        .logo-mark {
            display: block;
            flex: 0 0 auto;
            background-image: var(--fluxzero-logo-url);
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
            aspect-ratio: 32 / 35;
        }

        .nav-logo-mark {
            height: 24px;
            width: 22px;
        }

        .nav-wordmark {
            color: transparent;
            background: linear-gradient(90deg, #D9F5FF 0%, #2F7FBA 100%);
            -webkit-background-clip: text;
            background-clip: text;
            font-family: var(--font-display);
            font-size: 16px;
            font-weight: 700;
            line-height: 1;
            letter-spacing: -0.002em;
            white-space: nowrap;
        }

        .nav-main,
        .nav-actions {
            min-height: 72px;
        }

        .nav-main {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex: 1 1 auto;
            min-width: 0;
        }

        .nav-main-links {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            gap: 28px;
            width: max-content;
        }

        .nav-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            padding: 0;
            font-size: 14px;
            color: var(--text-secondary);
            font-weight: 500;
            transition: color 0.14s ease, opacity 0.14s ease;
        }

        .nav-link:hover,
        .nav-link.is-active,
        .nav-link[aria-current="page"] {
            color: var(--text);
        }

        .nav-link-github {
            color: rgba(244, 247, 255, 0.86);
        }

        .nav-link-github svg {
            width: 18px;
            height: 18px;
            display: block;
            fill: currentColor;
            flex: 0 0 auto;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 14px;
            flex: 0 0 auto;
        }

        .nav-status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 40px;
            padding: 0;
            color: rgba(167, 180, 200, 0.82);
            font-family: var(--font-mono);
            font-size: 10.5px;
            line-height: 1;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            white-space: nowrap;
            transition: color 0.14s ease, opacity 0.14s ease;
        }

        .nav-status:hover {
            color: rgba(244, 247, 255, 0.9);
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 999px;
            background: #4de1c4;
            box-shadow: 0 0 10px rgba(77, 225, 196, 0.18);
            flex: 0 0 auto;
            animation: statusPulse 2.4s ease-in-out infinite;
        }

        .nav-status-label {
            display: inline-block;
        }

        .nav-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 600;
            min-height: 40px;
            padding: 0 18px;
            background: rgba(255, 255, 255, 0.06);
            color: var(--text);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 999px;
            transition: border-color 0.14s ease, background-color 0.14s ease, color 0.14s ease;
        }

        .nav-cta:hover {
            border-color: rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.1);
        }

        .btn-primary,
        .plan-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            padding: 0 16px;
            border-radius: 999px;
            border: 1px solid transparent;
            background: var(--gradient-blue);
            background-clip: padding-box;
            color: #08121d;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: -0.01em;
            overflow: hidden;
            box-shadow:
                inset 0 0 0 1px rgba(47, 127, 186, 0.46),
                var(--accent-glow);
            transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
        }

        .btn-primary:hover,
        .plan-cta:hover {
            transform: translateY(-1px);
            box-shadow:
                inset 0 0 0 1px rgba(47, 127, 186, 0.46),
                0 0 20px rgba(0, 179, 255, 0.18);
            filter: brightness(1.03);
        }

        .btn-secondary,
        .plan-cta-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 0 16px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.02);
            color: var(--text);
            font-size: 13px;
            font-weight: 600;
            transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.18s ease;
        }

        .btn-secondary:hover,
        .plan-cta-secondary:hover {
            transform: translateY(-1px);
            border-color: rgba(0, 179, 255, 0.16);
            background: rgba(255,255,255,0.03);
        }

        .section {
            padding: var(--section-pad) 0;
        }

        .pricing-hero {
            padding-top: max(188px, calc(96px + 68px));
            padding-bottom: 48px;
            text-align: center;
        }

        .pricing-hero .eyebrow {
            margin-bottom: 18px;
            display: inline-block;
        }

        .pricing-hero h2 {
            font-size: 38px;
            max-width: 980px;
            margin: 0 auto 16px;
            line-height: 1.02;
        }

        .pricing-hero h2 .em {
            color: transparent;
            background: var(--gradient-blue);
            -webkit-background-clip: text;
            background-clip: text;
        }

        .pricing-sub {
            max-width: 760px;
            margin: 0 auto;
            font-size: var(--fs-body-strong);
            color: var(--text-secondary);
            line-height: 1.68;
        }

        .pricing-bridge {
            margin-top: 28px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 14px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.06);
            background: rgba(255,255,255,0.02);
            color: rgba(244, 247, 255, 0.72);
            font-family: var(--font-mono);
            font-size: 11px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .pricing-bridge-dot {
            width: 6px;
            height: 6px;
            border-radius: 999px;
            background: rgba(0, 179, 255, 0.9);
            box-shadow: 0 0 10px rgba(0, 179, 255, 0.14);
        }

        .plans-section {
            padding-top: 22px;
        }

        .plans-head,
        .comparison-head,
        .billing-head,
        .advanced-head,
        .faq-head {
            display: grid;
            gap: 10px;
            max-width: 760px;
        }

        .plans-head {
            text-align: center;
            margin: 0 auto var(--stack-follow);
        }

        .plans-head h2,
        .comparison-head h2,
        .billing-head h2,
        .advanced-head h2,
        .faq-head h2 {
            font-size: var(--fs-section-title);
            line-height: var(--lh-heading);
        }

        .plans-head p,
        .comparison-head p,
        .billing-head p,
        .advanced-head p,
        .faq-head p {
            color: var(--text-secondary);
            font-size: var(--fs-body-strong);
            line-height: 1.68;
        }

        .plans-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .plan-card {
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 22px;
            min-height: 100%;
            padding: 28px 24px 24px;
            border-radius: 22px;
            border: 1px solid rgba(255,255,255,0.06);
            background:
                linear-gradient(180deg, rgba(255,255,255,0.025), rgba(255,255,255,0.01)),
                var(--surface-panel);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.04),
                var(--surface-shadow);
            overflow: hidden;
        }

        .plan-card::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1px;
            background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0) 42%);
            -webkit-mask:
                linear-gradient(#000 0 0) content-box,
                linear-gradient(#000 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }

        .plan-card--recommended {
            border-color: rgba(0, 179, 255, 0.16);
            background:
                radial-gradient(circle at 82% 0%, rgba(0, 179, 255, 0.1), transparent 26%),
                linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.012)),
                var(--surface-panel);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.05),
                inset 0 0 34px rgba(0, 179, 255, 0.03),
                0 14px 30px rgba(0, 0, 0, 0.24);
        }

        .plan-card--recommended .plan-badge {
            background: rgba(0, 179, 255, 0.12);
            border-color: rgba(0, 179, 255, 0.18);
            color: var(--blue-soft);
        }

        .plan-card--run {
            background:
                radial-gradient(circle at 88% 0%, rgba(32, 134, 240, 0.08), transparent 24%),
                linear-gradient(180deg, rgba(255,255,255,0.025), rgba(255,255,255,0.01)),
                var(--surface-panel);
        }

        .plan-badge {
            display: inline-flex;
            align-items: center;
            align-self: flex-start;
            min-height: 30px;
            padding: 0 12px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.07);
            background: rgba(255,255,255,0.025);
            color: rgba(244, 247, 255, 0.7);
            font-family: var(--font-mono);
            font-size: 10.5px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .plan-head {
            display: grid;
            gap: 10px;
        }

        .plan-name {
            font-size: 28px;
            line-height: 1.04;
        }

        .plan-price {
            display: flex;
            align-items: baseline;
            gap: 8px;
            color: var(--text);
        }

        .plan-price strong {
            font-family: var(--font-display);
            font-size: clamp(34px, 4vw, 42px);
            line-height: 1;
            letter-spacing: -0.04em;
        }

        .plan-price span {
            color: var(--text-tertiary);
            font-size: 14px;
        }

        .plan-positioning {
            color: var(--text-secondary);
            max-width: 30ch;
        }

        .plan-list {
            display: grid;
            gap: 12px;
            list-style: none;
        }

        .plan-list li {
            position: relative;
            padding-left: 18px;
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.58;
        }

        .plan-list li::before {
            content: "";
            position: absolute;
            left: 0;
            top: 8px;
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: rgba(0, 179, 255, 0.88);
            box-shadow: 0 0 10px rgba(0, 179, 255, 0.14);
        }

        .plan-actions {
            margin-top: auto;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .starter-card,
        .comparison-card,
        .billing-card,
        .billing-sidecar,
        .advanced-card,
        .faq-list {
            position: relative;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.06);
            background:
                linear-gradient(180deg, rgba(255,255,255,0.025), rgba(255,255,255,0.01)),
                var(--surface-panel);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.04),
                var(--surface-shadow);
            overflow: hidden;
        }

        .starter-card {
            margin-top: var(--stack-follow);
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 18px;
            padding: 24px;
        }

        .starter-copy {
            display: grid;
            gap: 10px;
            align-content: start;
        }

        .starter-copy h3 {
            font-size: 24px;
            line-height: 1.08;
        }

        .starter-copy p {
            color: var(--text-secondary);
        }

        .starter-points {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-content: start;
        }

        .starter-pill {
            display: inline-flex;
            align-items: center;
            min-height: 36px;
            padding: 0 12px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.06);
            background: rgba(255,255,255,0.02);
            color: rgba(244,247,255,0.78);
            font-size: 13px;
        }

        .comparison-section,
        .billing-section,
        .advanced-section,
        .faq-section {
            padding-top: 0;
        }

        .comparison-card,
        .billing-grid,
        .advanced-grid,
        .faq-list {
            margin-top: var(--stack-follow);
        }

        .comparison-card {
            padding: 24px;
        }

        .comparison-row {
            display: grid;
            grid-template-columns: 190px repeat(2, minmax(0, 1fr));
            gap: 14px;
            align-items: start;
            padding: 14px 0;
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        .comparison-row:first-child {
            border-top: none;
            padding-top: 0;
        }

        .comparison-label {
            color: var(--text);
            font-weight: 500;
        }

        .comparison-cell {
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.55;
        }

        .comparison-plan {
            display: block;
            margin-bottom: 6px;
            color: var(--text);
            font-weight: 600;
        }

        .matrix-section {
            padding-top: 0;
        }

        .matrix-wrap {
            margin-top: var(--stack-follow);
            border-radius: 22px;
            border: 1px solid rgba(255,255,255,0.06);
            background:
                linear-gradient(180deg, rgba(255,255,255,0.025), rgba(255,255,255,0.01)),
                var(--surface-panel);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.04),
                var(--surface-shadow);
            overflow: clip;
        }

        .matrix-header {
            position: sticky;
            top: 104px;
            z-index: 6;
            display: grid;
            grid-template-columns: 1.15fr repeat(3, minmax(0, 1fr));
            gap: 14px;
            padding: 20px 24px 18px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            background:
                linear-gradient(180deg, rgba(9, 13, 20, 0.96), rgba(9, 13, 20, 0.88)),
                var(--surface-panel);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .matrix-header-intro {
            display: grid;
            align-content: end;
            gap: 8px;
            padding-right: 16px;
        }

        .matrix-header-intro h3 {
            font-size: 21px;
            line-height: 1.08;
        }

        .matrix-header-intro p {
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.55;
        }

        .matrix-plan {
            display: grid;
            gap: 10px;
            align-content: start;
            padding: 18px 18px 16px;
            border-radius: 18px;
            border: 1px solid rgba(255,255,255,0.06);
            background: rgba(255,255,255,0.025);
        }

        .matrix-plan--launch {
            border-color: rgba(0, 179, 255, 0.16);
            background:
                radial-gradient(circle at 82% 0%, rgba(0, 179, 255, 0.09), transparent 30%),
                rgba(255,255,255,0.025);
        }

        .matrix-plan--run {
            border-color: rgba(32, 134, 240, 0.14);
            background:
                radial-gradient(circle at 88% 0%, rgba(32, 134, 240, 0.07), transparent 28%),
                rgba(255,255,255,0.02);
        }

        .matrix-plan-head {
            display: grid;
            gap: 4px;
        }

        .matrix-plan-name {
            color: var(--text);
            font-size: 22px;
            line-height: 1;
            letter-spacing: -0.03em;
            font-weight: 600;
        }

        .matrix-plan-price {
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.4;
        }

        .matrix-plan-note {
            color: var(--text-tertiary);
            font-size: 12.5px;
            line-height: 1.45;
            min-height: 36px;
        }

        .matrix-cta {
            min-height: 38px;
            padding: 0 14px;
            font-size: 12.5px;
        }

        .matrix-body {
            display: grid;
        }

        .matrix-group-label {
            padding: 18px 24px 10px;
            color: var(--blue-soft);
            font-family: var(--font-mono);
            font-size: 10.5px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .matrix-row {
            display: grid;
            grid-template-columns: 1.15fr repeat(3, minmax(0, 1fr));
            gap: 14px;
            align-items: stretch;
            padding: 0 24px;
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        .matrix-row:first-of-type {
            border-top: none;
        }

        .matrix-feature {
            display: grid;
            align-content: center;
            gap: 6px;
            min-height: 84px;
            padding: 16px 0;
        }

        .matrix-feature h4 {
            color: var(--text);
            font-size: 15px;
            line-height: 1.3;
            font-weight: 500;
        }

        .matrix-feature p {
            color: var(--text-tertiary);
            font-size: 13px;
            line-height: 1.5;
        }

        .matrix-cell {
            display: grid;
            align-content: center;
            gap: 8px;
            min-height: 84px;
            padding: 16px 0;
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.55;
        }

        .matrix-cell--highlight {
            color: var(--text);
        }

        .matrix-check,
        .matrix-minus {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
        }

        .matrix-check {
            background: rgba(0, 179, 255, 0.14);
            border: 1px solid rgba(0, 179, 255, 0.18);
            color: var(--blue-soft);
        }

        .matrix-minus {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.07);
            color: rgba(244,247,255,0.46);
        }

        .billing-grid {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 16px;
        }

        .billing-card,
        .billing-sidecar {
            padding: 26px 24px;
        }

        .billing-points {
            display: grid;
            gap: 14px;
            margin-top: 18px;
        }

        .billing-point {
            padding: 14px 16px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.05);
            background: rgba(255,255,255,0.02);
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.58;
        }

        .billing-point strong {
            color: var(--text);
            font-weight: 600;
        }

        .billing-sidecar {
            background:
                radial-gradient(circle at 88% 0%, rgba(0, 179, 255, 0.08), transparent 24%),
                linear-gradient(180deg, rgba(255,255,255,0.025), rgba(255,255,255,0.01)),
                var(--surface-panel);
        }

        .billing-sidecar h3 {
            font-size: 24px;
            line-height: 1.08;
            margin-bottom: 12px;
        }

        .billing-sidecar p {
            color: var(--text-secondary);
            margin-bottom: 18px;
        }

        .billing-side-points {
            display: grid;
            gap: 12px;
            margin-bottom: 22px;
        }

        .billing-side-point {
            padding: 12px 14px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.05);
            background: rgba(255,255,255,0.02);
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.55;
        }

        .advanced-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
        }

        .advanced-card {
            padding: 22px 20px;
            display: grid;
            gap: 10px;
        }

        .advanced-card h3 {
            font-size: 18px;
            line-height: 1.08;
        }

        .advanced-card p {
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.58;
        }

        .faq-list {
            padding: 0 22px;
        }

        .faq-item {
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        .faq-item:first-child {
            border-top: none;
        }

        .faq-item summary {
            list-style: none;
            cursor: pointer;
            padding: 22px 0;
            color: var(--text);
            font-size: 15.5px;
            font-weight: 600;
        }

        .faq-item summary::-webkit-details-marker {
            display: none;
        }

        .faq-item p {
            padding: 0 0 22px;
            color: var(--text-secondary);
        }

        .page-footnote {
            text-align: center;
            max-width: 720px;
            margin: var(--stack-follow) auto 0;
            color: var(--text-secondary);
            font-size: 15px;
        }

        @keyframes statusPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(69, 217, 194, 0.16); opacity: 0.86; }
            50% { box-shadow: 0 0 0 6px rgba(69, 217, 194, 0); opacity: 1; }
        }

        @media (max-width: 980px) {
            .plans-grid,
            .billing-grid,
            .advanced-grid,
            .starter-card {
                grid-template-columns: 1fr;
            }

            .comparison-row {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .matrix-header,
            .matrix-row {
                grid-template-columns: 1fr;
                gap: 8px;
            }

            .matrix-header {
                position: static;
            }

            .matrix-plan-note {
                min-height: auto;
            }

            .matrix-cell,
            .matrix-feature {
                min-height: auto;
                padding: 8px 0;
            }

            .matrix-cell {
                padding-bottom: 16px;
            }
        }

        @media (max-width: 860px) {
            :root { --section-pad: clamp(64px, 10vw, 88px); }
            .nav-shell {
                min-height: 64px;
                padding: 0 20px;
                gap: 18px;
            }

            .nav-main {
                justify-content: flex-start;
            }

            .nav-main-links {
                gap: 18px;
            }

            .nav-actions {
                gap: 12px;
            }

            .nav-link {
                font-size: 12.5px;
            }

            .nav-status {
                font-size: 10px;
            }

            .pricing-hero {
                padding-top: max(188px, calc(96px + 68px));
            }
        }

        @media (max-width: 600px) {
            :root { --section-pad: clamp(56px, 12vw, 72px); }
            .nav-shell {
                min-height: 58px;
                gap: 12px;
                padding: 10px 12px;
            }

            .nav-logo-wrap {
                min-height: 36px;
                flex: 0 0 auto;
            }

            .nav-logo-mark {
                height: 24px;
            }

            .nav-wordmark {
                display: none;
            }

            .nav-main,
            .nav-actions {
                min-height: auto;
                width: auto;
            }

            .nav-main {
                flex: 1 1 auto;
                justify-content: flex-start;
            }

            .nav-actions {
                gap: 8px;
            }

            .nav-main-links {
                gap: 10px;
                flex-wrap: nowrap;
            }

            .nav-main-links .nav-link-github {
                display: none;
            }

            .nav-link {
                min-height: 36px;
                font-size: 12.5px;
            }

            .nav-status {
                min-height: 36px;
                font-size: 10px;
                letter-spacing: 0.08em;
            }

            .nav-cta {
                min-height: 36px;
                padding: 0 12px;
                font-size: 13px;
            }

            .pricing-hero {
                padding-top: max(124px, calc(58px + 62px));
            }

            .plan-card,
            .comparison-card,
            .billing-card,
            .billing-sidecar,
            .advanced-card,
            .starter-card,
            .faq-list,
            .matrix-wrap {
                padding-left: 20px;
                padding-right: 20px;
            }

            .matrix-header,
            .matrix-row,
            .matrix-group-label {
                padding-left: 0;
                padding-right: 0;
            }

            .comparison-row {
                gap: 10px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .status-dot,
            .nav-cta,
            .btn-primary,
            .plan-cta {
                animation: none !important;
                transition: none !important;
            }

            .nav-cta:hover,
            .btn-primary:hover,
            .plan-cta:hover,
            .btn-secondary:hover,
            .plan-cta-secondary:hover {
                transform: none;
            }
        }

        .pricing-v2 {
            width: min(calc(100% - 32px), 1240px);
            margin: 0 auto;
            padding: 142px 0 96px;
        }

        .pricing-v2-hero {
            max-width: 680px;
            margin: 0 auto;
            text-align: center;
        }

        .pricing-v2-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 22px;
            color: var(--accent-secondary-soft);
            font-family: var(--font-mono);
            font-size: 11px;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .pricing-v2-kicker::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 999px;
            background: var(--green);
            box-shadow: 0 0 12px rgba(77, 225, 196, 0.24);
        }

        .pricing-v2-hero h1 {
            font-size: clamp(38px, 4.4vw, 56px);
            line-height: 1;
            letter-spacing: -0.04em;
            text-wrap: balance;
        }

        .pricing-v2-hero p {
            max-width: 560px;
            margin: 18px auto 0;
            color: rgba(244, 247, 255, 0.72);
            font-size: clamp(16px, 1.55vw, 18px);
            line-height: 1.55;
            text-wrap: balance;
        }

        .pricing-v2-plans {
            margin-top: 30px;
        }

        .pricing-v2-toggle-input {
            position: absolute;
            width: 1px;
            height: 1px;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
        }

        .pricing-v2-toggle {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            width: fit-content;
            min-width: 260px;
            margin: 0 auto 34px;
            padding: 4px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.065);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
        }

        .pricing-v2-toggle label {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 0 24px;
            border-radius: 999px;
            color: rgba(167, 180, 200, 0.86);
            font-size: 15px;
            font-weight: 650;
            cursor: pointer;
            transition: color 160ms ease, background 160ms ease, box-shadow 160ms ease;
        }

        #pricing-launch:checked ~ .pricing-v2-toggle label[for="pricing-launch"],
        #pricing-scale:checked ~ .pricing-v2-toggle label[for="pricing-scale"] {
            color: #06131f;
            background: linear-gradient(135deg, #D9F5FF 0%, #6AB9F4 100%);
            box-shadow: 0 10px 24px rgba(48, 154, 244, 0.16), inset 0 0 0 1px rgba(255, 255, 255, 0.44);
        }

        .pricing-v2-panel {
            display: none;
        }

        #pricing-launch:checked ~ .pricing-v2-panels .pricing-v2-panel-launch,
        #pricing-scale:checked ~ .pricing-v2-panels .pricing-v2-panel-scale {
            display: grid;
            gap: 24px;
        }

        .pricing-v2-panel-launch {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            max-width: 820px;
            margin: 0 auto;
        }

        .pricing-v2-panel-scale {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .pricing-v2-billing-note {
            grid-column: 1 / -1;
            max-width: 760px;
