}

<span class="tok-keyword">record</span> <span class="tok-type">GrantReservationReward</span>(
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">RewardGrantId</span> <span class="tok-field">rewardGrantId</span>,
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">String</span> <span class="tok-field">customerId</span>,
    <span class="tok-annotation">@Positive</span> <span class="tok-keyword">int</span> <span class="tok-field">points</span>) {

    <span class="tok-annotation">@InterceptApply</span>
    <span class="tok-type">Object</span> <span class="tok-method">ignoreIfAlreadyGranted</span>(<span class="tok-type">Graph</span>&lt;<span class="tok-type">RewardGrant</span>&gt; current) {
        <span class="tok-keyword">return</span> current.<span class="tok-call">isPresent</span>() ? <span class="tok-literal">null</span> : <span class="tok-keyword">this</span>;
    }

    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">RewardGrant</span> <span class="tok-method">grant</span>() {
        <span class="tok-keyword">return new</span> <span class="tok-type">RewardGrant</span>(<span class="tok-field">rewardGrantId</span>, <span class="tok-field">customerId</span>, <span class="tok-field">points</span>);
    }
}

<span class="tok-annotation">@Model</span>
<span class="tok-keyword">record</span> <span class="tok-type">RewardGrant</span>(
    <span class="tok-annotation">@EntityId</span> <span class="tok-type">RewardGrantId</span> <span class="tok-field">rewardGrantId</span>,
    <span class="tok-type">String</span> <span class="tok-field">customerId</span>,
    <span class="tok-keyword">int</span> <span class="tok-field">points</span>) {}`;

const paymentProcessCode = `<span class="tok-annotation">@Stateful</span>
<span class="tok-annotation">@Consumer</span>(<span class="tok-field">name</span> = <span class="tok-string">"reservation-payments"</span>)
<span class="tok-keyword">record</span> <span class="tok-type">PaymentProcess</span>(
    <span class="tok-annotation">@EntityId</span> <span class="tok-type">ReservationId</span> <span class="tok-field">reservationId</span>,
    <span class="tok-annotation">@Association</span> <span class="tok-type">String</span> <span class="tok-field">pspReference</span>) {

    <span class="tok-annotation">@HandleEvent</span>
    <span class="tok-keyword">static</span> <span class="tok-type">PaymentProcess</span> <span class="tok-method">start</span>(<span class="tok-type">PaymentStarted</span> event) {
        <span class="tok-keyword">return</span> <span class="tok-keyword">new</span> <span class="tok-type">PaymentProcess</span>(
            event.<span class="tok-call">reservationId</span>(), event.<span class="tok-call">pspReference</span>());
    }

    <span class="tok-annotation">@HandleEvent</span>
    <span class="tok-type">PaymentProcess</span> <span class="tok-method">complete</span>(<span class="tok-type">PaymentSucceeded</span> event) {
        <span class="tok-type">Fluxzero</span>.<span class="tok-call">sendCommandAndWait</span>(
            <span class="tok-keyword">new</span> <span class="tok-type">ConfirmReservation</span>(<span class="tok-field">reservationId</span>));
        <span class="tok-keyword">return</span> <span class="tok-literal">null</span>;
    }
}

<span class="tok-keyword">record</span> <span class="tok-type">PaymentStarted</span>(
    <span class="tok-type">ReservationId</span> <span class="tok-field">reservationId</span>, <span class="tok-type">String</span> <span class="tok-field">pspReference</span>) {}

<span class="tok-keyword">record</span> <span class="tok-type">PaymentSucceeded</span>(<span class="tok-type">String</span> <span class="tok-field">pspReference</span>) {}`;

const confirmationCode = `<span class="tok-keyword">record</span> <span class="tok-type">ConfirmReservation</span>(
    <span class="tok-annotation">@NotNull</span> <span class="tok-type">ReservationId</span> <span class="tok-field">reservationId</span>) {

    <span class="tok-annotation">@InterceptApply</span>
    <span class="tok-type">Object</span> <span class="tok-method">ignoreIfConfirmed</span>(<span class="tok-type">Reservation</span> reservation) {
        <span class="tok-keyword">return</span> reservation.<span class="tok-call">status</span>() == <span class="tok-field">CONFIRMED</span> ? <span class="tok-literal">null</span> : <span class="tok-keyword">this</span>;
    }

    <span class="tok-annotation">@AssertLegal</span>
    <span class="tok-keyword">void</span> <span class="tok-method">assertAwaitingPayment</span>(<span class="tok-type">Reservation</span> reservation) {
        <span class="tok-keyword">if</span> (reservation.<span class="tok-call">status</span>() != <span class="tok-field">AWAITING_PAYMENT</span>) {
            <span class="tok-keyword">throw</span> <span class="tok-type">ReservationErrors</span>.<span class="tok-field">notAwaitingPayment</span>;
        }
    }

    <span class="tok-annotation">@Apply</span>
    <span class="tok-type">Reservation</span> <span class="tok-method">confirm</span>(<span class="tok-type">Reservation</span> reservation) {
        <span class="tok-keyword">return</span> reservation.<span class="tok-call">withStatus</span>(<span class="tok-field">CONFIRMED</span>);
    }
}`;

const queryCallerCode = `<span class="tok-annotation">@Component</span>
<span class="tok-annotation">@Path</span>(<span class="tok-string">"/api/tickets"</span>)
<span class="tok-keyword">final</span> <span class="tok-keyword">class</span> <span class="tok-type">TicketApi</span> {
    <span class="tok-annotation">@HandleGet</span>
