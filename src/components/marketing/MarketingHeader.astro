---
import { fluxzeroBrand } from '../../config/brand.mjs';

interface Props {
    active?: 'pricing' | 'about' | 'how-it-works';
}

const { active } = Astro.props;
const pricingClass = `nav-link nav-link-pricing${active === 'pricing' ? ' is-active' : ''}`;
const aboutClass = `nav-link nav-link-about${active === 'about' ? ' is-active' : ''}`;
const howItWorksClass = `nav-link nav-link-agents${active === 'how-it-works' ? ' is-active' : ''}`;
---

<nav class="nav-shell">
    <a href="/" class="nav-logo-wrap" aria-label="Fluxzero home">
        <img class="nav-logo-lockup" src={fluxzeroBrand.logo} width="181" height="40" alt="Fluxzero">
        <span class="logo-mark nav-logo-mark" aria-hidden="true"></span>
    </a>

    <div class="nav-main">
        <div class="nav-main-links">
            <a href="/pricing" class={pricingClass} aria-current={active === 'pricing' ? 'page' : undefined}>Pricing</a>
            <a href="/about" class={aboutClass} aria-current={active === 'about' ? 'page' : undefined}>Our story</a>
            <a href="/how-it-works" class={howItWorksClass} aria-current={active === 'how-it-works' ? 'page' : undefined}>How it works</a>
            <a href="/docs" class="nav-link nav-link-docs">Docs</a>
        </div>
    </div>

    <div class="nav-actions">
        <a href="/start-building" class="nav-cta">Get started</a>
    </div>
</nav>
