<script>
    function togglePricingFaq(btn) {
        const item = btn.parentElement;
        item.classList.toggle('open');
    }

    function toggleScaleCalculator() {
        const scaleCard = document.querySelector('[data-scale-card]');
        if (!scaleCard) return;

        const isFlipped = scaleCard.classList.toggle('is-flipped');
        scaleCard.querySelector('.pricing-v2-flip-face--front').setAttribute('aria-hidden', String(isFlipped));
        scaleCard.querySelector('.pricing-v2-flip-face--back').setAttribute('aria-hidden', String(!isFlipped));
    }

    (function () {
        const scaleCard = document.querySelector('[data-scale-card]');
        const calculator = document.querySelector('[data-scale-calculator]');
        if (!scaleCard || !calculator) return;

        const sizes = [
            { name: 'Starter', cluster: 200, app: 40 },
            { name: 'Small', cluster: 400, app: 80 },
            { name: 'Medium', cluster: 800, app: 160 },
            { name: 'Large', cluster: 1600, app: 320 },
            { name: 'XL', cluster: 3200, app: 640 },
            { name: '2XL', cluster: 6400, app: 1280 },
            { name: '3XL', cluster: 9600, app: 1920 },
            { name: '4XL', cluster: 12800, app: 2560 },
            { name: '5XL', cluster: 16000, app: 3200 },
            { name: '6XL', cluster: 19200, app: 3840 },
            { name: '7XL', cluster: 22400, app: 4480 },
            { name: '8XL', cluster: 25600, app: 5120 }
        ];

        const planPrice = 890;
        const includedSizeIndex = 2;
        const addedSizeIndex = 1;
        const includedStorageGb = 400;
        const storagePricePerGbPerDay = 0.0048;
        const state = [
            { type: 'cluster', sizeIndex: includedSizeIndex, included: true },
            { type: 'app', sizeIndex: includedSizeIndex, included: true },
            { type: 'app', sizeIndex: includedSizeIndex, included: true }
        ];

        const formatEuro = value => '€' + Math.round(value).toLocaleString('en-US');

        function fullRowPrice(type, sizeIndex) {
            return sizes[sizeIndex][type];
        }

        function extraRowPrice(row) {
            const fullPrice = fullRowPrice(row.type, row.sizeIndex);
            if (!row.included) return fullPrice;
            return Math.max(0, fullPrice - fullRowPrice(row.type, includedSizeIndex));
        }

        function renderRows() {
            const rows = calculator.querySelector('[data-scale-rows]');
            rows.innerHTML = '';

            state.forEach((item, rowIndex) => {
                const size = sizes[item.sizeIndex];
                const row = document.createElement('div');
                row.className = 'scale-row';

                const main = document.createElement('div');
                main.className = 'scale-row-main';

                const typeBadge = document.createElement('span');
                typeBadge.className = 'scale-row-type scale-row-type--' + item.type;
                typeBadge.textContent = item.type;

                const sizeBadge = document.createElement('span');
                sizeBadge.className = 'scale-row-size';
                sizeBadge.textContent = size.name;

                main.append(typeBadge, sizeBadge);

                const actions = document.createElement('div');
                actions.className = 'scale-row-actions';

                const price = document.createElement('strong');
                price.className = 'scale-row-price';
                price.textContent = formatEuro(extraRowPrice(item));

                if (!item.included) {
                    const remove = document.createElement('button');
                    remove.className = 'scale-row-remove';
                    remove.type = 'button';
                    remove.setAttribute('aria-label', 'Remove ' + item.type);
                    remove.textContent = 'x';
                    remove.addEventListener('click', () => {
                        state.splice(rowIndex, 1);
                        render();
                    });
                    main.appendChild(remove);
                }

                actions.appendChild(price);

                const range = document.createElement('input');
                range.className = 'scale-row-range';
                range.type = 'range';
                range.min = item.included ? String(includedSizeIndex) : '0';
                range.max = String(sizes.length - 1);
                range.step = '1';
                range.value = String(item.sizeIndex);
                range.setAttribute('aria-label', item.type + ' size');
                range.addEventListener('input', () => {
                    const nextSizeIndex = Number(range.value);
                    item.sizeIndex = nextSizeIndex;
                    sizeBadge.textContent = sizes[nextSizeIndex].name;
                    price.textContent = formatEuro(extraRowPrice(item));
                    updateTotals();
                });

                row.append(main, actions, range);
                rows.appendChild(row);
            });
        }

        function updateTotals() {
            const extraTotal = state.reduce((total, row) => total + extraRowPrice(row), 0);
            const storageInput = calculator.querySelector('[data-scale-storage-gb]');
            const storageGb = Math.max(includedStorageGb, Number(storageInput.value || includedStorageGb));
            const storageExtra = Math.max(0, storageGb - includedStorageGb) * 30 * storagePricePerGbPerDay;

            calculator.querySelector('[data-scale-storage-extra]').textContent = formatEuro(storageExtra);
            calculator.querySelector('[data-scale-total]').textContent = formatEuro(planPrice + extraTotal + storageExtra);
        }

        function render() {
            renderRows();
            updateTotals();
        }

        calculator.querySelectorAll('[data-add-scale-row]').forEach(button => {
            button.addEventListener('click', () => {
                const type = button.dataset.addScaleRow;
                state.push({ type, sizeIndex: addedSizeIndex, included: false });
                render();
            });
        });

        const storageInput = calculator.querySelector('[data-scale-storage-gb]');
        storageInput.addEventListener('input', updateTotals);
        storageInput.addEventListener('blur', () => {
            if (Number(storageInput.value || 0) < includedStorageGb) {
                storageInput.value = String(includedStorageGb);
            }
            updateTotals();
        });

        scaleCard.querySelector('.pricing-v2-flip-face--back').setAttribute('aria-hidden', 'true');
        render();
    }());

    (function () {
        const homeLink = document.querySelector('[data-home-link]');
        if (!homeLink) return;

        homeLink.addEventListener('click', function (event) {
            try {
                if (document.referrer) {
                    const referrer = new URL(document.referrer);
                    if (referrer.origin === window.location.origin) {
                        event.preventDefault();
                        window.history.back();
                    }
                }
            } catch (error) {
                /* fall back to href */
            }
        });
    }());
</script>
