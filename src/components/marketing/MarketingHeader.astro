---
import { fluxzeroBrand } from '../../config/brand.mjs';

interface Props {
    active?: 'pricing' | 'about' | 'how-it-works';
}

const { active } = Astro.props;
const isDevelopmentPreview = import.meta.env.DEV;
const pricingClass = `nav-link nav-link-pricing${active === 'pricing' ? ' is-active' : ''}`;
const aboutClass = `nav-link nav-link-about${active === 'about' ? ' is-active' : ''}`;
const howItWorksClass = `nav-link nav-link-agents${active === 'how-it-works' ? ' is-active' : ''}`;
---

<nav class="nav-shell">
    <a href="/" class="nav-logo-wrap" aria-label="Fluxzero home">
        <img class="nav-logo-lockup" src={fluxzeroBrand.logo} width="181" height="40" alt="Fluxzero">
        <span class="logo-mark nav-logo-mark" aria-hidden="true"></span>
    </a>

    <div class="nav-main">
        <div class="nav-main-links">
            <a href="/pricing" class={pricingClass} aria-current={active === 'pricing' ? 'page' : undefined}>Pricing</a>
            <a href="/about" class={aboutClass} aria-current={active === 'about' ? 'page' : undefined}>Our story</a>
            <a href="/how-it-works" class={howItWorksClass} aria-current={active === 'how-it-works' ? 'page' : undefined}>How it works</a>
            <a href="/docs" class="nav-link nav-link-docs">Docs</a>
        </div>
    </div>

    <div class="nav-actions" data-account-nav data-preview-enabled={isDevelopmentPreview ? 'true' : 'false'}>
        <a href="/get-started" class="nav-cta" data-nav-sign-in>Sign in</a>

        <div class="nav-authenticated" data-nav-authenticated hidden>
            <a href="https://dashboard.fluxzero.io/" class="nav-cta">Dashboard</a>

            <div class="nav-profile">
                <button
                    class="nav-profile-trigger"
                    type="button"
                    aria-label="Open account menu"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    data-nav-profile-trigger
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="8" r="3.25"></circle>
                        <path d="M5.75 19c.5-3.2 2.58-5 6.25-5s5.75 1.8 6.25 5"></path>
                    </svg>
                </button>

                <div class="nav-profile-menu" role="menu" aria-label="Account" data-nav-profile-menu hidden>
                    <a href="https://dashboard.fluxzero.io/profile" role="menuitem">Profile</a>
                    <button type="button" role="menuitem" data-nav-sign-out>Sign out</button>
                </div>
            </div>
        </div>
    </div>
</nav>

<script is:inline src="/js/marketing-header.js?v=20260903-1" defer></script>
