import qualification.kotlin.KotlinProductCodeTest.TicketStatus.*

class KotlinProductCodeTest {
    val fixture = fixture(ReservationApi(), ReservationTimers(), PaymentProcess::class.java, TestPaymentProvider())

    // @snippet actionCode
